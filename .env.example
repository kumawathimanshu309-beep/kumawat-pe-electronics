# ==========================================
# KUMAWAT P&E - PRODUCTION ENVIRONMENT VARS
# ==========================================

# 1. Server Configuration
PORT=3000
NODE_ENV=production

# 2. Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kumawat_pe?retryWrites=true&w=majority

# 3. Security
SESSION_SECRET=generate_a_very_long_secure_random_string_here

# 4. Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxx

# 5. Media & Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
