<%- include('partials/header', { title: 'My Orders | Kumawat P&E', activePage: 'dashboard' }) %>

<div class="container" style="padding: 60px 24px;">
  <div class="row">
    <div class="col-12 text-center mb-5">
      <h2 style="font-family: var(--font-display); font-weight: 700; color: var(--ink);">My Orders</h2>
      <p style="color: var(--ink-light);">Track and manage all your placed orders and bookings.</p>
    </div>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-9">
      <% if (orders && orders.length > 0) { %>
        <% orders.forEach(order => { %>
          <div class="card mb-4" style="border: 1px solid var(--rule); border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
            <div class="card-header bg-light d-flex justify-content-between align-items-center" style="padding: 16px 20px; border-bottom: 1px solid var(--rule);">
              <div>
                <strong style="color: var(--ink); font-size: 1.1rem;">Order #<%= order.orderId %></strong>
                <span style="font-size: 0.85rem; color: var(--ink-light); margin-left: 10px;">Placed on: <%= new Date(order.createdAt).toLocaleDateString() %></span>
              </div>
              <a href="/order/<%= order.orderId %>" class="btn btn-outline btn-sm">View Details</a>
            </div>
            <div class="card-body" style="padding: 20px;">
              <div class="row">
                <div class="col-md-8">
                  <div style="font-weight: 600; margin-bottom: 8px;">Items (<%= order.items.length %>)</div>
                  <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.9rem;">
                    <% order.items.slice(0, 2).forEach(item => { %>
                      <li style="margin-bottom: 4px; color: var(--ink-light);"><%= item.quantity %>x <%= item.name %></li>
                    <% }) %>
                    <% if (order.items.length > 2) { %>
                      <li style="color: var(--accent); font-size: 0.8rem; margin-top: 4px;">+ <%= order.items.length - 2 %> more items...</li>
                    <% } %>
                  </ul>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                  <div style="font-size: 0.85rem; color: var(--ink-light); margin-bottom: 4px;">Total Amount</div>
                  <div style="font-size: 1.25rem; font-weight: 700; color: var(--accent); margin-bottom: 10px;">₹<%= order.totalAmount %></div>
                  
                  <div class="d-flex justify-content-end align-items-center gap-2 mb-2">
                    <div style="padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; background: #e2e3e5; color: #383d41;">
                      <i class="bi bi-wallet2"></i> <%= order.paymentRecordId ? order.paymentRecordId.method : 'Unknown' %>
                    </div>
                    <div style="padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; 
                      <%= (order.paymentRecordId && order.paymentRecordId.status === 'Paid') ? 'background: #d4edda; color: #155724;' : 
                          (order.paymentRecordId && (order.paymentRecordId.status === 'Failed' || order.paymentRecordId.status === 'Cancelled')) ? 'background: #f8d7da; color: #721c24;' : 
                          'background: #fff3cd; color: #856404;' %>">
                      <%= order.paymentRecordId ? order.paymentRecordId.status : 'Pending' %>
                    </div>
                  </div>

                  <div style="display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; 
                    <%= order.deliveryStatus === 'Delivered' ? 'background: #d4edda; color: #155724;' : 
                        order.deliveryStatus === 'Cancelled' ? 'background: #f8d7da; color: #721c24;' : 
                        'background: #cce5ff; color: #004085;' %>">
                    <i class="bi bi-truck"></i> <%= order.deliveryStatus %>
                  </div>
                </div>
              </div>
            </div>
            <% if(order.paymentRecordId && order.paymentRecordId.status === 'Failed') { %>
            <div class="card-footer bg-white text-end border-top-0 pt-0">
               <button class="btn btn-sm btn-outline-danger" onclick="retryPayment('<%= order.paymentRecordId.paymentId %>')">Retry Payment</button>
            </div>
            <% } %>
          </div>
        <% }) %>
      <% } else { %>
        <div class="text-center py-5" style="background: var(--bg); border: 2px dashed var(--rule); border-radius: 16px;">
          <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
          <h4 class="mt-3" style="color: var(--ink);">No Orders Found</h4>
          <p style="color: var(--ink-light);">You haven't placed any orders yet.</p>
          <a href="/services" class="btn btn-accent mt-3">Book a Service</a>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  socket.on('order_status_update', (data) => {
    // Refresh page if status updates
    window.location.reload();
  });

  function retryPayment(paymentId) {
    // Ideally we redirect to a payment retry page, or redirect to checkout with a query parameter.
    // Let's store the paymentId in localStorage and redirect to checkout
    window.currentPaymentId = paymentId;
    alert("This will direct you back to checkout to retry your payment.");
    window.location.href = '/checkout?retry=' + paymentId;
  }
</script>

<%- include('partials/footer') %>
