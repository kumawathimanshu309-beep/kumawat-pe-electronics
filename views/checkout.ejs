<%- include('partials/header', { title: 'Checkout Order | Kumawat P&E', activePage: 'checkout' }) %>

<main id="main-content" class="checkout-page">

<style>
.checkout-wrapper {
  max-width: 1400px;
  width: min(100% - 24px, 1400px);
  margin: 0 auto;
  padding: 30px 0 60px 0;
  overflow-x: hidden;
  box-sizing: border-box;
}

@media (max-width: 480px) {
  .checkout-wrapper {
    width: min(100% - 16px, 1400px);
    padding: 16px 0 100px 0;
  }
}

.checkout-header {
  margin-bottom: 20px;
}

.checkout-header h2 {
  font-family: var(--font-display);
  font-weight: 800;
  color: #1C2B2B;
  font-size: clamp(1.4rem, 4vw, 2rem);
  margin: 0;
}

/* Progress Tracker */
.progress-tracker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
  position: relative;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.progress-tracker::before {
  content: '';
  position: absolute;
  top: 16px;
  left: 30px;
  right: 30px;
  height: 2px;
  background: var(--rule, #E9ECEF);
  z-index: 1;
}

.progress-step {
  position: relative;
  z-index: 2;
  background: var(--bg, #FAF8F5);
  padding: 0 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--ink-light, #5C7070);
  font-weight: 600;
  font-size: 0.85rem;
}

.progress-step.active {
  color: #C9602A;
}

.progress-step .step-circle {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--rule, #E9ECEF);
  color: var(--ink-light, #5C7070);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6px;
  font-weight: 700;
  font-size: 0.9rem;
}

.progress-step.active .step-circle {
  background: #C9602A;
  color: white;
  box-shadow: 0 0 10px rgba(201, 96, 42, 0.3);
}

/* Compact Mobile Step Badge for <= 767px */
.mobile-step-badge {
  display: none;
  align-items: center;
  gap: 8px;
  background: #fffaf5;
  border: 1px solid rgba(201, 96, 42, 0.2);
  color: #C9602A;
  padding: 6px 12px;
  border-radius: 20px;
  font-size: 0.82rem;
  font-weight: 700;
  margin-bottom: 16px;
  width: fit-content;
}

@media (max-width: 767px) {
  .progress-tracker {
    display: none !important;
  }
  .mobile-step-badge {
    display: inline-flex !important;
  }
}

/* 2-Column Layout on Desktop, 1-Column on Mobile */
.checkout-container {
  display: flex;
  gap: 30px;
  align-items: flex-start;
  width: 100%;
}

.checkout-left {
  flex: 1 1 68%;
  width: 68%;
  min-width: 0;
}

.checkout-right {
  flex: 0 0 32%;
  width: 32%;
  min-width: 0;
  position: sticky;
  top: 24px;
}

@media (max-width: 991px) {
  .checkout-container {
    flex-direction: column;
    gap: 20px;
  }
  .checkout-left,
  .checkout-right {
    flex: 1 1 100%;
    width: 100%;
  }
  .checkout-right {
    position: static;
  }
}

/* Checkout Section Cards */
.checkout-section {
  background: #fff;
  border: 1px solid var(--rule, #E9ECEF);
  border-radius: 12px;
  padding: clamp(16px, 3vw, 24px);
  margin-bottom: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.checkout-section h3 {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2.5vw, 1.25rem);
  font-weight: 700;
  margin-bottom: 18px;
  color: #1C2B2B;
  display: flex;
  align-items: center;
  gap: 10px;
}

.checkout-section h3 .step-num {
  background: #C9602A;
  color: white;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  flex-shrink: 0;
}

/* Address Grid & Cards */
.address-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 14px;
  margin-bottom: 16px;
  width: 100%;
}

@media (max-width: 576px) {
  .address-grid {
    grid-template-columns: 1fr;
  }
}

.address-card {
  border: 1.5px solid var(--rule, #E9ECEF);
  border-radius: 10px;
  padding: 14px;
  cursor: pointer;
  transition: all 0.2s ease;
  background: #fff;
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.address-card:hover {
  border-color: #C9602A;
  box-shadow: 0 4px 12px rgba(201, 96, 42, 0.08);
}

.address-card.selected {
  border-color: #C9602A;
  background: #fffaf5;
}

.address-card.selected::before {
  content: '\F26A';
  font-family: 'bootstrap-icons';
  position: absolute;
  top: 14px;
  right: 14px;
  color: #C9602A;
  font-size: 1.2rem;
}

.address-actions {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px dashed var(--rule, #E9ECEF);
  display: flex;
  gap: 8px;
}

.address-actions button {
  padding: 6px 12px;
  font-size: 0.8rem;
  min-height: 36px;
}

/* Payment Methods */
.payment-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
  width: 100%;
}

@media (max-width: 576px) {
  .payment-grid {
    grid-template-columns: 1fr;
  }
}

.payment-card {
  border: 1.5px solid var(--rule, #E9ECEF);
  border-radius: 10px;
  padding: 14px 16px;
  cursor: pointer;
  transition: all 0.2s ease;
  background: #fff;
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 48px;
  width: 100%;
  box-sizing: border-box;
}

.payment-card:hover {
  border-color: #C9602A;
}

.payment-card.selected {
  border-color: #C9602A;
  background: #fffaf5;
  box-shadow: 0 0 0 1px #C9602A;
}

.payment-card input[type="radio"] {
  accent-color: #C9602A;
  width: 20px;
  height: 20px;
  margin: 0;
  flex-shrink: 0;
}

.payment-card label {
  cursor: pointer;
  margin: 0;
  width: 100%;
}

.payment-card label strong {
  display: block;
  font-size: 0.92rem;
  color: #1C2B2B;
}

.payment-card label small {
  display: block;
  font-size: 0.76rem;
  color: var(--ink-light, #5C7070);
  margin-top: 2px;
}

/* Form Input Heights & Readable Fonts */
.form-floating-custom {
  position: relative;
  margin-bottom: 16px;
  width: 100%;
}

.form-floating-custom label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #1C2B2B;
  margin-bottom: 6px;
  display: block;
}

.form-floating-custom input,
.form-floating-custom select,
.form-floating-custom textarea {
  width: 100%;
  min-height: 46px;
  padding: 10px 14px;
  border: 1px solid var(--rule, #E9ECEF);
  border-radius: 8px;
  background: #fff;
  font-size: 0.95rem;
  transition: border-color 0.2s;
  box-sizing: border-box;
}

.form-floating-custom input:focus,
.form-floating-custom select:focus,
.form-floating-custom textarea:focus {
  border-color: #C9602A;
  outline: none;
  box-shadow: 0 0 0 3px rgba(201, 96, 42, 0.15);
}

.form-floating-custom input[readonly] {
  background: #F8F6F1;
  color: var(--ink-light, #5C7070);
}

/* Summary Card & Non-Splitting Monetary Values */
.summary-card {
  background: #fff;
  border: 1px solid var(--rule, #E9ECEF);
  border-radius: 12px;
  padding: clamp(16px, 3vw, 24px);
  box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  width: 100%;
  box-sizing: border-box;
}

.summary-price-val {
  white-space: nowrap !important;
  font-weight: 700;
}

.summary-item {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--rule, #E9ECEF);
}

.summary-item-img {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  border: 1px solid var(--rule, #E9ECEF);
  object-fit: contain;
  background: #fff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.summary-item-details {
  flex-grow: 1;
  min-width: 0;
}

.summary-item-title {
  font-weight: 600;
  font-size: 0.9rem;
  color: #1C2B2B;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 4px;
}

.qty-controls {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: #F8F6F1;
  padding: 4px 8px;
  border-radius: 6px;
  border: 1px solid var(--rule, #E9ECEF);
}

.qty-btn {
  background: none;
  border: none;
  color: #C9602A;
  font-size: 1.1rem;
  cursor: pointer;
  padding: 0 4px;
  line-height: 1;
  font-weight: 700;
}

.qty-val {
  font-weight: 700;
  font-size: 0.9rem;
  min-width: 16px;
  text-align: center;
}

/* DEDICATED MOBILE STICKY CHECKOUT ACTION BAR (<= 991px) */
.mobile-sticky-checkout-bar {
  display: none;
}

@media (max-width: 991px) {
  .checkout-page .mobile-bottom-nav,
  body.checkout-active .mobile-bottom-nav {
    display: none !important;
  }

  .mobile-sticky-checkout-bar {
    display: flex !important;
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    background: #ffffff !important;
    border-top: 1px solid var(--rule, #E9ECEF) !important;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)) 16px !important;
    box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.12) !important;
    z-index: 1050 !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 12px !important;
  }

  .mobile-sticky-info {
    display: flex;
    flex-direction: column;
  }

  .mobile-sticky-label {
    font-size: 0.75rem;
    color: var(--ink-light, #5C7070);
    text-transform: uppercase;
    font-weight: 600;
  }

  .mobile-sticky-price {
    font-size: 1.2rem;
    font-weight: 800;
    color: #C9602A;
    white-space: nowrap;
  }

  .mobile-sticky-checkout-bar .btn-submit-order {
    flex: 1;
    max-width: 220px;
    min-height: 46px;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 50px;
    background: #C9602A;
    color: #ffffff;
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    box-shadow: 0 4px 15px rgba(201, 96, 42, 0.35);
    cursor: pointer;
  }

  .desktop-submit-container {
    display: none !important;
  }

  .checkout-wrapper {
    padding-bottom: calc(100px + env(safe-area-inset-bottom, 0px)) !important;
  }
}

@media (min-width: 992px) {
  .mobile-sticky-checkout-bar {
    display: none !important;
  }
  .desktop-submit-container {
    display: block !important;
  }
}
</style>

<div class="checkout-wrapper">
  
  <div class="checkout-header">
    <h2 style="font-family: var(--font-display); font-weight: 800; color: #1C2B2B;">Secure Checkout</h2>
  </div>

  <div class="progress-tracker">
    <div class="progress-step active">
      <div class="step-circle">1</div>
      <span>Address</span>
    </div>
    <div class="progress-step active">
      <div class="step-circle">2</div>
      <span>Review</span>
    </div>
    <div class="progress-step active">
      <div class="step-circle">3</div>
      <span>Payment</span>
    </div>
    <div class="progress-step">
      <div class="step-circle">4</div>
      <span>Confirmation</span>
    </div>
  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <form action="/checkout" method="POST" id="checkoutForm">
    <!-- Hidden inputs for cart data -->
    <input type="hidden" name="cartData" id="cartDataInput" value="" />
    <input type="hidden" name="totalAmount" id="totalAmountInput" value="0" />
    <input type="hidden" name="discountAmount" id="discountAmountInput" value="0" />
    <input type="hidden" name="deliveryFee" id="deliveryFeeInput" value="0" />
    <input type="hidden" name="deliveryAddressJSON" id="deliveryAddressJSON" value="" />
    <input type="hidden" name="couponCode" id="couponCodeHiddenInput" value="" />

    <div class="checkout-container">
      
      <!-- Left Column: Form & Address -->
      <div class="checkout-left">
        
        <!-- Section 1: Customer Details -->
        <div class="checkout-section">
          <h3><span class="step-num">1</span> Customer Details</h3>
          <div class="row">
            <div class="col-md-12">
              <div class="form-floating-custom">
                <label for="customerName">Full Name</label>
                <input type="text" id="customerName" name="customerName" value="<%= user.name %>" readonly />
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating-custom">
                <label for="customerPhone">Mobile Number</label>
                <input type="tel" id="customerPhone" name="customerPhone" value="<%= user.mobile %>" readonly />
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating-custom">
                <label for="customerEmail">Email Address</label>
                <input type="email" id="customerEmail" name="customerEmail" value="<%= user.email %>" readonly />
              </div>
            </div>
          </div>
        </div>

        <!-- Section 2: Delivery Address -->
        <div class="checkout-section">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 style="margin: 0;"><span class="step-num">2</span> Delivery Address</h3>
            <button type="button" class="btn btn-sm" style="background: #fffaf5; color: #C9602A; border: 1px solid #C9602A;" onclick="showAddressModal()">
              + Add New
            </button>
          </div>
          
          <div id="saved-addresses-list" class="address-grid">
            <% if (user.addresses && user.addresses.length > 0) { %>
              <% user.addresses.forEach((addr, idx) => { %>
                <div class="address-card" id="addr-card-<%= idx %>" onclick="selectAddress('<%= encodeURIComponent(JSON.stringify(addr)) %>', this)">
                  <div style="padding-right: 24px;">
                    <div style="font-weight: 700; color: #1C2B2B; margin-bottom: 4px;"><%= addr.fullName %> <span class="badge bg-light text-dark ms-2"><%= addr.mobile %></span></div>
                    <div style="font-size: 0.85rem; color: var(--ink-light); line-height: 1.4;">
                      <%= addr.house %>, <%= addr.street %>, <%= addr.landmark ? addr.landmark + ', ' : '' %><br>
                      <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
                    </div>
                  </div>
                  <div class="address-actions">
                    <button type="button" class="btn btn-outline-primary" onclick="event.stopPropagation(); editAddress(<%= idx %>)">Edit</button>
                    <button type="button" class="btn btn-outline-danger" onclick="event.stopPropagation(); deleteAddress(<%= idx %>)">Delete</button>
                  </div>
                  <input type="radio" name="selectedAddressRadio" value="<%= idx %>" <%= addr.isDefault ? 'checked' : '' %> style="display: none;">
                </div>
              <% }) %>
            <% } else { %>
              <div class="text-muted" style="font-size: 0.95rem; grid-column: 1 / -1;">No saved addresses found. Please add a new address to continue.</div>
            <% } %>
          </div>
        </div>

        <!-- Section 3: Delivery Preferences -->
        <div class="checkout-section">
          <h3><span class="step-num">3</span> Delivery Preferences</h3>
          <div class="row">
            <div class="col-md-6">
              <div class="form-floating-custom">
                <label for="preferredDate">Preferred Date *</label>
                <input type="date" id="preferredDate" name="preferredDate" required />
              </div>
            </div>
            <div class="col-md-6">
              <div class="form-floating-custom">
                <label for="timeSlot">Preferred Time Slot *</label>
                <select id="timeSlot" name="timeSlot" required>
                  <option value="">Select slot...</option>
                  <option value="Morning (8am – 12pm)">Morning (8am – 12pm)</option>
                  <option value="Afternoon (12pm – 4pm)">Afternoon (12pm – 4pm)</option>
                  <option value="Evening (4pm – 9pm)">Evening (4pm – 9pm)</option>
                  <option value="Urgent / ASAP">Urgent / ASAP</option>
                </select>
              </div>
            </div>
            <div class="col-md-12">
              <div class="form-floating-custom">
                <label for="notes">Special Notes / Description of problem</label>
                <textarea id="notes" name="notes" rows="2" placeholder="e.g. Bring a new 15-amp switch board, faucet is leaking from the neck, etc."></textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 4: Payment Method -->
        <div class="checkout-section">
          <h3><span class="step-num">4</span> Payment Method</h3>
          <div class="payment-grid">
            <div class="payment-card selected" onclick="selectPayment('Cash')">
              <input type="radio" name="paymentMethod" value="Cash" checked id="pay-cash" />
              <label for="pay-cash">
                <strong>Cash on Delivery</strong>
                <small>Pay in cash after repair/delivery</small>
              </label>
            </div>

            <div class="payment-card" onclick="selectPayment('UPI')">
              <input type="radio" name="paymentMethod" value="UPI" id="pay-upi" />
              <label for="pay-upi">
                <strong>Instant UPI (QR Scan)</strong>
                <small>GPay, PhonePe, Paytm QR scanner</small>
              </label>
            </div>

            <div class="payment-card" onclick="selectPayment('Google Pay')">
              <input type="radio" name="paymentMethod" value="Google Pay" id="pay-gpay" />
              <label for="pay-gpay">
                <strong>Google Pay</strong>
                <small>Direct pay via Google Pay app</small>
              </label>
            </div>

            <div class="payment-card" onclick="selectPayment('PhonePe')">
              <input type="radio" name="paymentMethod" value="PhonePe" id="pay-phonepe" />
              <label for="pay-phonepe">
                <strong>PhonePe</strong>
                <small>Pay using PhonePe application</small>
              </label>
            </div>

            <div class="payment-card" onclick="selectPayment('Paytm')">
              <input type="radio" name="paymentMethod" value="Paytm" id="pay-paytm" />
              <label for="pay-paytm">
                <strong>Paytm Wallet / UPI</strong>
                <small>Direct pay via Paytm app</small>
              </label>
            </div>

            <div class="payment-card" onclick="selectPayment('Debit Card')">
              <input type="radio" name="paymentMethod" value="Debit Card" id="pay-debit" />
              <label for="pay-debit">
                <strong>Debit Card</strong>
                <small>Visa, MasterCard, RuPay</small>
              </label>
            </div>

            <div class="payment-card" onclick="selectPayment('Net Banking')">
              <input type="radio" name="paymentMethod" value="Net Banking" id="pay-netbanking" />
              <label for="pay-netbanking">
                <strong>Net Banking</strong>
                <small>All Indian Banks Supported</small>
              </label>
            </div>
          </div>
          
          <div style="margin-top: 20px;">
            <%- include('partials/payment_icons') %>
          </div>
        </div>

      </div>

      <!-- Right Column: Booking Summary -->
      <div class="checkout-right">
        <div class="summary-card">
          <h3 style="font-family: var(--font-display); font-size: 1.15rem; font-weight: 700; margin-bottom: 20px; color: #1C2B2B;">Booking Summary</h3>
          
          <div id="checkout-items-list">
            <!-- Items injected by JS -->
          </div>
          
          <!-- Price Breakdown -->
          <div style="margin-top: 16px;">
            <div style="font-size: 0.95rem; color: var(--ink); margin-bottom: 12px; display: flex; justify-content: space-between;">
              <span>Items Total:</span>
              <strong id="summary-items-total">₹0</strong>
            </div>
            <div style="font-size: 0.95rem; color: #25D366; margin-bottom: 12px; display: flex; justify-content: space-between;">
              <span>Discount:</span>
              <strong id="summary-discount">- ₹0</strong>
            </div>

            <div style="font-size: 0.95rem; color: var(--ink); margin-bottom: 12px; display: flex; justify-content: space-between;">
              <span>Delivery Charge:</span>
              <strong id="summary-delivery">Select Address</strong>
            </div>
            <div style="font-size: 0.95rem; color: var(--ink); margin-bottom: 16px; display: flex; justify-content: space-between;">
              <span>Handling Charge:</span>
              <strong>₹11</strong>
            </div>
            
            <hr style="border-top: 1px dashed var(--rule); margin: 16px 0;" />

            <!-- Coupon Section -->
            <div id="coupon-section" style="margin-bottom: 16px;">
              <div class="input-group">
                <input type="text" id="couponCodeInput" class="form-control text-uppercase" placeholder="Enter Promo Code" style="font-size: 0.9rem;">
                <button class="btn btn-outline" type="button" id="applyCouponBtn" onclick="applyCoupon()" style="font-size: 0.9rem;">Apply</button>
              </div>
              <small id="couponMessage" class="form-text mt-1 d-block"></small>
            </div>
            
            <div id="coupon-discount-row" style="font-size: 0.95rem; color: #25D366; margin-bottom: 12px; display: none; justify-content: space-between;">
              <span>Promo Discount:</span>
              <strong id="summary-promo-discount">- ₹0</strong>
            </div>

            <hr style="border-top: 1px dashed var(--rule); margin: 16px 0;" />
            
            <div style="font-size: 1.3rem; font-weight: 800; color: #C9602A; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
              <span>Grand Total:</span>
              <span id="checkout-total-price">₹0</span>
            </div>
          </div>

          <div class="desktop-submit-container">
            <button type="submit" id="desktop-submit-btn" class="btn btn-accent btn-full" style="font-size: 1.1rem; font-weight: 700; padding: 14px 20px; box-shadow: 0 4px 15px rgba(201,96,42,0.3); width: 100%;">
              Place Order <i class="bi bi-arrow-right-short" style="font-size: 1.3rem; vertical-align: middle;"></i>
            </button>
          </div>
          
          <!-- Contact Support -->
          <div style="background-color: #F8F6F1; border-radius: 8px; padding: 16px; margin-top: 20px;">
            <h4 style="font-family: var(--font-display); font-size: 0.95rem; font-weight: 700; margin-bottom: 6px;">Need Help?</h4>
            <p style="font-size: 0.8rem; color: var(--ink-light); line-height: 1.5; margin-bottom: 12px;">Contact Himanshu Kumawat directly on WhatsApp for any assistance.</p>
            <a href="https://wa.me/919462759965" target="_blank" class="btn btn-whatsapp btn-sm d-block text-center" style="padding: 8px 16px; width: 100%;"><i class="bi bi-whatsapp"></i> Chat on WhatsApp</a>
          </div>

        </div>
      </div>

    </div>

    <!-- DEDICATED MOBILE STICKY CHECKOUT ACTION BAR -->
    <div class="mobile-sticky-checkout-bar" id="mobile-sticky-bar">
      <div class="mobile-sticky-info">
        <span class="mobile-sticky-label">Grand Total</span>
        <span class="mobile-sticky-price" id="mobile-sticky-total">₹0</span>
      </div>
      <button type="submit" id="mobile-sticky-submit-btn" class="btn-submit-order" aria-label="Place Order">
        Place Order <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
      </button>
    </div>

  </form>
</div>

<%- include('partials/address-modal') %>

<script>
  const userAddresses = <%- JSON.stringify(user.addresses || []) %>;
  let checkoutCart = [];
  let currentDeliveryFee = null;
  let currentDistance = null;
  let currentAddressJSON = '';

  async function loadCheckoutCart() {
    try {
      const res = await fetch('/api/cart');
      const data = await res.json();
      if (data.success && data.cart && data.cart.length > 0) {
        checkoutCart = data.cart;
      } else {
        showToast("Your cart is empty. Redirecting to catalog...");
        setTimeout(() => {
          window.location.href = '/services';
        }, 1500);
        return;
      }
    } catch (e) {
      console.error("Error loading cart:", e);
      return;
    }
    
    renderCheckoutCart();
  }

  function setSubmittingState(isSubmitting) {
    const desktopBtn = document.getElementById('desktop-submit-btn');
    const mobileBtn = document.getElementById('mobile-sticky-submit-btn');

    [desktopBtn, mobileBtn].forEach(btn => {
      if (!btn) return;
      btn.disabled = isSubmitting;
      if (isSubmitting) {
        btn.innerHTML = 'Processing... <i class="bi bi-hourglass-split"></i>';
      } else {
        btn.innerHTML = 'Place Order <i class="bi bi-arrow-right-short"></i>';
      }
    });
  }

  // Razorpay Checkout Integration
  document.getElementById('checkoutForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const cartInput = document.getElementById('cartDataInput');
    const totalInput = document.getElementById('totalAmountInput');
    
    cartInput.value = JSON.stringify(checkoutCart);
    const cleanTotalStr = document.getElementById('checkout-total-price').textContent.replace(/[^0-9.]/g, '').trim();
    const totalAmount = parseFloat(cleanTotalStr);
    totalInput.value = totalAmount;

    if (!cartInput.value || checkoutCart.length === 0) {
      showToast("Cart is empty!");
      return false;
    }

    if (!document.getElementById('deliveryAddressJSON').value) {
      showToast("Please select a delivery address.");
      const addrSection = document.getElementById('saved-addresses-list');
      if (addrSection) addrSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      return false;
    }
    
    if (currentDeliveryFee === null) {
      showToast("Delivery is not available at the selected address.");
      return false;
    }

    const urlParams = new URLSearchParams(window.location.search);
    const retryId = urlParams.get('retry');
    if (retryId) {
      window.currentPaymentId = retryId;
    }

    const formData = new FormData(this);
    const paymentMethod = formData.get('paymentMethod');

    setSubmittingState(true);

    if (paymentMethod === 'Cash On Delivery' || paymentMethod === 'Cash') {
      // Direct Submit for COD
      this.submit();
      return;
    }

    // Online Payments via Razorpay
    try {
      // 1. Create Order on Backend
      const cartData = JSON.stringify(checkoutCart);
      const requestBody = { amount: totalAmount, paymentMethod, cartData };
      if (window.currentPaymentId) {
        requestBody.existingPaymentId = window.currentPaymentId;
      }

      const response = await fetch('/api/payment/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(requestBody)
      });
      const orderData = await response.json();
      
      if (orderData.paymentId) {
        window.currentPaymentId = orderData.paymentId;
      }

      // 2. Developer Mode Check
      if (orderData.developerMode) {
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            icon: 'warning',
            title: 'Developer Mode',
            text: orderData.message || 'Online Payment is running in Developer Mode. Please configure Razorpay Test Keys to test online payments. You can still use Cash On Delivery.',
            confirmButtonColor: '#C9602A'
          });
        } else {
          alert(orderData.message || "Online Payment is running in Developer Mode. Configure Razorpay Test Keys.");
        }
        
        setSubmittingState(false);
        return;
      }

      if (!orderData.success) {
        throw new Error(orderData.message || "Failed to initiate payment");
      }

      // 3. Open Razorpay Checkout Modal
      const options = {
        key: orderData.key,
        amount: orderData.amount,
        currency: orderData.currency,
        name: "Kumawat P&E",
        description: "Service & Product Order",
        order_id: orderData.order_id,
        handler: function (response) {
          // 4. Inject Payment Details & Submit Form
          const form = document.getElementById('checkoutForm');
          
          const rzpPaymentId = document.createElement('input');
          rzpPaymentId.type = 'hidden';
          rzpPaymentId.name = 'razorpay_payment_id';
          rzpPaymentId.value = response.razorpay_payment_id;
          form.appendChild(rzpPaymentId);

          const rzpOrderId = document.createElement('input');
          rzpOrderId.type = 'hidden';
          rzpOrderId.name = 'razorpay_order_id';
          rzpOrderId.value = response.razorpay_order_id;
          form.appendChild(rzpOrderId);

          const rzpSignature = document.createElement('input');
          rzpSignature.type = 'hidden';
          rzpSignature.name = 'razorpay_signature';
          rzpSignature.value = response.razorpay_signature;
          form.appendChild(rzpSignature);

          const payIdField = document.createElement('input');
          payIdField.type = 'hidden';
          payIdField.name = 'paymentId';
          payIdField.value = orderData.paymentId;
          form.appendChild(payIdField);

          form.submit();
        },
        modal: {
          ondismiss: function() {
            setSubmittingState(false);
          }
        },
        prefill: {
          name: formData.get('customerName'),
          email: formData.get('customerEmail'),
          contact: formData.get('customerPhone')
        },
        theme: { color: "#C9602A" }
      };
      
      const rzp = new Razorpay(options);
      rzp.on('payment.failed', async function (response) {
        showToast('Payment Failed. You can retry or change your payment method.');
        setSubmittingState(false);
      });
      rzp.open();

    } catch (err) {
      console.error(err);
      showToast(err.message || 'Error processing payment');
      setSubmittingState(false);
    }
  });

  function renderCheckoutCart() {
    const list = document.getElementById('checkout-items-list');
    const itemsTotalEl = document.getElementById('summary-items-total');
    const discountEl = document.getElementById('summary-discount');
    const deliveryEl = document.getElementById('summary-delivery');
    const grandTotalEl = document.getElementById('checkout-total-price');
    const mobileTotalEl = document.getElementById('mobile-sticky-total');
    
    if (checkoutCart.length === 0) {
      list.innerHTML = `
        <div class="text-center py-4 text-muted">
          <i class="bi bi-cart3" style="font-size: 2.5rem; display: block; margin-bottom: 10px; color: var(--rule);"></i>
          <p style="font-weight: 600;">🛒 Your cart is empty</p>
          <a href="/services" class="btn btn-outline btn-sm mt-3">Continue Shopping</a>
        </div>
      `;
      itemsTotalEl.textContent = `₹0`;
      discountEl.textContent = `- ₹0`;
      deliveryEl.textContent = `₹0`;
      grandTotalEl.textContent = `₹0`;
      if (mobileTotalEl) mobileTotalEl.textContent = `₹0`;
      setSubmittingState(true);
      return;
    }
    
    setSubmittingState(false);

    let itemsTotal = 0;
    let totalDiscount = 0;
    
    list.innerHTML = checkoutCart.map(item => {
      const origPrice = item.originalPrice ? parseFloat(item.originalPrice) : parseFloat(item.price);
      const sellPrice = parseFloat(item.price);
      const qty = parseInt(item.quantity);
      
      const itemOrigTotal = origPrice * qty;
      const itemSellTotal = sellPrice * qty;
      const itemDiscount = itemOrigTotal - itemSellTotal;
      
      itemsTotal += itemOrigTotal;
      totalDiscount += itemDiscount;

      return `
        <div class="summary-item">
          <div class="summary-item-img">
            ${item.image ? `<img alt="Image" loading="lazy" decoding="async" src="${item.image}" style="max-width: 100%; max-height: 100%; object-fit: contain;">` : `<i class="bi bi-image text-muted" style="font-size: 1.5rem;"></i>`}
          </div>
          <div class="summary-item-details">
            <div class="summary-item-title" title="${item.name}">${item.name}</div>
            <div style="font-size: 0.95rem; font-weight: 700; color: #1C2B2B; margin-bottom: 8px;">₹${sellPrice}</div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div class="qty-controls">
                <button type="button" class="qty-btn" onclick="updateQty('${escape(item.name)}', -1)">-</button>
                <span class="qty-val">${qty}</span>
                <button type="button" class="qty-btn" onclick="updateQty('${escape(item.name)}', 1)">+</button>
              </div>
              <div style="font-size: 0.95rem; font-weight: 700; color: #C9602A;" class="summary-price-val">₹${itemSellTotal}</div>
            </div>
          </div>
        </div>
      `;
    }).join('');
    
    let taxableAmount = Number(itemsTotal) - Number(totalDiscount);
    let handlingCharge = Number(11);
    let currentDeliveryFeeNum = currentDeliveryFee ? Number(currentDeliveryFee) : 0;
    let grandTotal = taxableAmount + currentDeliveryFeeNum + handlingCharge;
    let finalDiscountAmount = 0;
    
    // Apply Promo Code
    if (appliedCoupon) {
      // Re-calculate based on latest cartTotal
      let minOrderVal = Number(appliedCoupon.minOrderValue || 0);
      if (taxableAmount < minOrderVal) {
        removeCoupon('Cart total dropped below minimum required for coupon.');
      } else {
        let promoDiscount = 0;
        let couponDiscountVal = Number(appliedCoupon.discount || 0);
        let maxDiscountVal = appliedCoupon.maxDiscount ? Number(appliedCoupon.maxDiscount) : null;

        if (appliedCoupon.type === 'fixed') {
          promoDiscount = couponDiscountVal;
        } else if (appliedCoupon.type === 'percentage') {
          promoDiscount = (taxableAmount * couponDiscountVal) / 100;
          if (maxDiscountVal && promoDiscount > maxDiscountVal) {
            promoDiscount = maxDiscountVal;
          }
        }
        
        // Coupon discount must NEVER exceed the taxable subtotal
        if (promoDiscount > taxableAmount) promoDiscount = taxableAmount;
        
        finalDiscountAmount = Number(promoDiscount);
        appliedCoupon.discountAmount = finalDiscountAmount;
        grandTotal -= finalDiscountAmount;
        
        document.getElementById('coupon-discount-row').style.display = 'flex';
        document.getElementById('summary-promo-discount').textContent = `- ₹${finalDiscountAmount.toFixed(2)}`;
      }
    } else {
      document.getElementById('coupon-discount-row').style.display = 'none';
    }

    itemsTotalEl.textContent = `₹${itemsTotal}`;
    discountEl.textContent = `- ₹${totalDiscount}`;
    
    if (currentDeliveryFee !== null) {
      if (currentDeliveryFee === 0) {
        deliveryEl.innerHTML = '<span style="color: #25D366; font-weight: 800;">FREE DELIVERY</span>';
      } else {
        deliveryEl.textContent = `₹${currentDeliveryFee}`;
      }
    } else {
      deliveryEl.textContent = 'Select Address';
    }
    
    const formattedTotal = `₹${grandTotal.toLocaleString('en-IN')}`;
    grandTotalEl.textContent = formattedTotal;
    if (mobileTotalEl) mobileTotalEl.textContent = formattedTotal;

    document.getElementById('totalAmountInput').value = grandTotal;
    document.getElementById('discountAmountInput').value = totalDiscount + (appliedCoupon ? appliedCoupon.discountAmount : 0);
    document.getElementById('deliveryFeeInput').value = currentDeliveryFee || 0;
  }
  
  // Coupon Logic
  let appliedCoupon = null;

  async function applyCoupon() {
    const code = document.getElementById('couponCodeInput').value.trim();
    if (!code) return;

    const btn = document.getElementById('applyCouponBtn');
    const msg = document.getElementById('couponMessage');
    btn.disabled = true;
    msg.textContent = 'Validating...';
    msg.className = 'form-text mt-1 d-block text-muted';

    // Calculate cart total (taxable amount)
    let taxableAmount = 0;
    checkoutCart.forEach(i => {
      taxableAmount += (i.price * i.quantity);
    });

    try {
      const res = await fetch('/api/coupon/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, cartTotal: taxableAmount })
      });
      const data = await res.json();
      
      if (data.success) {
        appliedCoupon = data.coupon;
        // No longer corrupting appliedCoupon.discount with absolute value
        
        msg.textContent = data.coupon.message;
        msg.className = 'form-text mt-1 d-block text-success fw-bold';
        
        document.getElementById('couponCodeInput').disabled = true;
        document.getElementById('couponCodeHiddenInput').value = code;
        btn.textContent = 'Remove';
        btn.onclick = () => removeCoupon();
        
        renderCheckoutCart();
      } else {
        msg.textContent = '❌ ' + data.message;
        msg.className = 'form-text mt-1 d-block text-danger';
      }
    } catch (e) {
      msg.textContent = '❌ Error validating coupon';
      msg.className = 'form-text mt-1 d-block text-danger';
    } finally {
      btn.disabled = false;
    }
  }

  function removeCoupon(reason = '') {
    appliedCoupon = null;
    const btn = document.getElementById('applyCouponBtn');
    const msg = document.getElementById('couponMessage');
    const input = document.getElementById('couponCodeInput');
    
    input.value = '';
    input.disabled = false;
    document.getElementById('couponCodeHiddenInput').value = '';
    btn.textContent = 'Apply';
    btn.onclick = () => applyCoupon();
    msg.textContent = reason;
    msg.className = 'form-text mt-1 d-block text-muted';
    
    renderCheckoutCart();
  }

  function selectAddress(encodedAddrStr, cardElement) {
    document.querySelectorAll('.address-card').forEach(c => {
      c.classList.remove('selected');
    });
    if(cardElement) {
      cardElement.classList.add('selected');
    }
    
    const addr = JSON.parse(decodeURIComponent(encodedAddrStr));
    currentAddressJSON = JSON.stringify(addr);
    document.getElementById('deliveryAddressJSON').value = currentAddressJSON;
    
    // Delivery is unconditionally FREE for all orders
    currentDeliveryFee = 0;
    currentDistance = null;
    renderCheckoutCart();
    document.querySelector('button[type="submit"]').disabled = false;
  }

  async function updateQty(escapedName, change) {
    const name = unescape(escapedName);
    const item = checkoutCart.find(i => i.name === name);
    if (item) {
      item.quantity += change;
      if (item.quantity <= 0) {
        checkoutCart = checkoutCart.filter(i => i.name !== name);
      }
      try {
        await fetch('/api/cart/overwrite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cart: checkoutCart })
        });
        if (checkoutCart.length === 0) {
          window.location.href = '/services';
        } else {
          renderCheckoutCart();
        }
      } catch (e) { console.error(e); }
    }
  }

  function selectPayment(method) {
    document.querySelectorAll('.payment-card').forEach(card => {
      card.classList.remove('selected');
      const radio = card.querySelector('input[type="radio"]');
      if (radio.value === method) {
        card.classList.add('selected');
        radio.checked = true;
      }
    });
  }

  async function deleteAddress(idx) {
    if (!confirm('Are you sure you want to delete this address?')) return;
    try {
      const res = await fetch(`/api/user/address/${idx}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert('Failed to delete address.');
      }
    } catch (e) {
      console.error(e);
      alert('Network error.');
    }
  }

  function editAddress(idx) {
    const addr = userAddresses[idx];
    if (!addr) return;
    
    document.getElementById('modalAddrName').value = addr.fullName || '';
    document.getElementById('modalAddrMobile').value = addr.mobile || '';
    document.getElementById('modalAddrHouse').value = addr.house || '';
    document.getElementById('modalAddrStreet').value = addr.street || '';
    document.getElementById('modalAddrLandmark').value = addr.landmark || '';
    document.getElementById('modalAddrPincode').value = addr.pincode || '';
    document.getElementById('modalAddrCity').value = addr.city || '';
    document.getElementById('modalAddrState').value = addr.state || '';
    document.getElementById('modalAddrLat').value = addr.lat || '';
    document.getElementById('modalAddrLng').value = addr.lng || '';
    document.getElementById('addressModalLabel').innerText = 'Edit Address';
    
    window.editAddressIndex = idx;
    
    const modal = new bootstrap.Modal(document.getElementById('addressModal'));
    modal.show();
  }

  // Bind clicks on cards to payment select
  document.addEventListener('DOMContentLoaded', () => {
    loadCheckoutCart();
    
    // Set minimum date for preferred Date to today
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('preferredDate').min = today;
    
    // Auto-select default address if exists
    const defaultRadio = document.querySelector('input[name="selectedAddressRadio"]:checked');
    if(defaultRadio) {
      defaultRadio.closest('.address-card').click();
    }
  });

</script>

</main>
<%- include('partials/footer') %>
