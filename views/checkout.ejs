<%- include('partials/header', { title: 'Checkout Order | Kumawat P&E', activePage: 'services' }) %>

<div class="container" style="padding: 60px 24px;">
  <div class="services-header" style="margin-bottom: 40px;">
    <p class="section-label">Order Booking</p>
    <h2>Complete Your Checkout</h2>
    <span class="badge-delivery mt-2" style="position: static;"><i class="bi bi-truck"></i> Home Delivery Available</span>
  </div>

  <div class="row checkout-grid">
    <!-- Checkout Form -->
    <div class="col-lg-7 col-md-12">
      <div class="dashboard-block">
        <h3 style="margin-bottom: 20px;">Customer &amp; Scheduling Details</h3>
        
        <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
        <form action="/checkout" method="POST" id="checkoutForm">
          <!-- Hidden inputs for cart data -->
          <input type="hidden" name="cartData" id="cartDataInput" value="" />
          <input type="hidden" name="totalAmount" id="totalAmountInput" value="0" />
          <input type="hidden" name="deliveryAddressJSON" id="deliveryAddressJSON" value="">
          <input type="hidden" name="deliveryFee" id="deliveryFeeInput" value="0">
          <input type="hidden" name="discountAmount" id="discountAmountInput" value="0">

          <div class="field">
            <label for="customerName">Full Name</label>
            <input type="text" id="customerName" name="customerName" value="<%= user.name %>" readonly style="background-color: var(--rule); opacity: 0.8;" />
          </div>

          <div class="row">
            <div class="col-md-6 col-12">
              <div class="field">
                <label for="customerPhone">Mobile Number</label>
                <input type="tel" id="customerPhone" name="customerPhone" value="<%= user.mobile %>" readonly style="background-color: var(--rule); opacity: 0.8;" />
              </div>
            </div>
            <div class="col-md-6 col-12">
              <div class="field">
                <label for="customerEmail">Email Address</label>
                <input type="email" id="customerEmail" name="customerEmail" value="<%= user.email %>" readonly style="background-color: var(--rule); opacity: 0.8;" />
              </div>
            </div>
          </div>

          <div class="field" id="address-selection-container">
            <label>Delivery / Service Address *</label>
            <div id="saved-addresses-list" class="mb-3">
              <% if (user.addresses && user.addresses.length > 0) { %>
                <% user.addresses.forEach((addr, idx) => { %>
                  <div class="card p-3 mb-2 address-card" onclick="selectAddress('<%= encodeURIComponent(JSON.stringify(addr)) %>', this)" style="cursor: pointer; border: 1px solid var(--rule);">
                    <div class="d-flex justify-content-between align-items-start">
                      <div>
                        <strong><%= addr.fullName %></strong> <span class="badge bg-light text-dark"><%= addr.mobile %></span>
                        <div class="text-muted mt-1" style="font-size:0.85rem;">
                          <%= addr.house %>, <%= addr.street %>, <%= addr.landmark ? addr.landmark + ', ' : '' %><%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
                        </div>
                      </div>
                      <input type="radio" name="selectedAddressRadio" value="<%= idx %>" <%= addr.isDefault ? 'checked' : '' %>>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="text-muted" style="font-size: 0.9rem;">No saved addresses found. Please add a new address.</div>
              <% } %>
            </div>
            <button type="button" class="btn btn-outline btn-sm w-100" onclick="showNewAddressForm()">+ Add New Address</button>
          </div>

          <!-- New Address Form (Hidden by default) -->
          <div id="new-address-form" style="display: none; background: #fafafa; padding: 20px; border-radius: 8px; border: 1px solid var(--rule); margin-bottom: 20px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="mb-0">Add New Address</h5>
              <button type="button" class="btn btn-sm btn-outline-primary" onclick="getCurrentLocation()">
                <i class="bi bi-geo-alt-fill"></i> Use Current Location
              </button>
            </div>
            
            <input type="hidden" id="newAddrLat" value="">
            <input type="hidden" id="newAddrLng" value="">

            <div class="row">
              <div class="col-md-6 mb-2"><input type="text" id="newAddrName" class="form-control" placeholder="Full Name"></div>
              <div class="col-md-6 mb-2"><input type="tel" id="newAddrMobile" class="form-control" placeholder="Mobile Number"></div>
              <div class="col-12 mb-2"><input type="text" id="newAddrHouse" class="form-control" placeholder="House / Flat No."></div>
              <div class="col-12 mb-2"><input type="text" id="newAddrStreet" class="form-control" placeholder="Street / Area"></div>
              <div class="col-md-6 mb-2"><input type="text" id="newAddrLandmark" class="form-control" placeholder="Landmark (Optional)"></div>
              <div class="col-md-6 mb-2"><input type="text" id="newAddrPincode" class="form-control" placeholder="Pincode"></div>
              <div class="col-md-6 mb-2"><input type="text" id="newAddrCity" class="form-control" placeholder="City"></div>
              <div class="col-md-6 mb-2"><input type="text" id="newAddrState" class="form-control" placeholder="State"></div>
            </div>
            <div class="d-flex gap-2 mt-3">
              <button type="button" class="btn btn-accent btn-sm w-50" onclick="saveNewAddress()">Save Address</button>
              <button type="button" class="btn btn-outline btn-sm w-50" onclick="hideNewAddressForm()">Cancel</button>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6 col-12">
              <div class="field">
                <label for="preferredDate">Preferred Date *</label>
                <input type="date" id="preferredDate" name="preferredDate" required />
              </div>
            </div>
            <div class="col-md-6 col-12">
              <div class="field">
                <label for="timeSlot">Preferred Time Slot *</label>
                <select id="timeSlot" name="timeSlot" required>
                  <option value="">Select slot...</option>
                  <option value="Morning (8am – 12pm)">Morning (8am – 12pm)</option>
                  <option value="Afternoon (12pm – 4pm)">Afternoon (12pm – 4pm)</option>
                  <option value="Evening (4pm – 9pm)">Evening (4pm – 9pm)</option>
                  <option value="Urgent / ASAP">Urgent / ASAP</option>
                </select>
              </div>
            </div>
          </div>

          <div class="field">
            <label for="notes">Special Notes / Description of problem</label>
            <textarea id="notes" name="notes" rows="2" placeholder="e.g. Bring a new 15-amp switch board, faucet is leaking from the neck, etc."></textarea>
          </div>

          <!-- Payment Methods -->
          <div style="margin-top: 28px;">
            <label class="section-label" style="display: block; margin-bottom: 10px;">Select Payment Method</label>
            
            <div class="payment-methods">
              <div class="payment-method-card selected" onclick="selectPayment('Cash')">
                <input type="radio" name="paymentMethod" value="Cash" checked id="pay-cash" />
                <label for="pay-cash">
                  <strong>Cash on Delivery</strong>
                  <div style="font-size: 0.75rem; color: var(--ink-light);">Pay in cash after repair/delivery</div>
                </label>
              </div>

              <div class="payment-method-card" onclick="selectPayment('UPI')">
                <input type="radio" name="paymentMethod" value="UPI" id="pay-upi" />
                <label for="pay-upi">
                  <strong>Instant UPI (QR Scan)</strong>
                  <div style="font-size: 0.75rem; color: var(--ink-light);">GPay, PhonePe, Paytm QR scanner</div>
                </label>
              </div>

              <div class="payment-method-card" onclick="selectPayment('Google Pay')">
                <input type="radio" name="paymentMethod" value="Google Pay" id="pay-gpay" />
                <label for="pay-gpay">
                  <strong>Google Pay</strong>
                  <div style="font-size: 0.75rem; color: var(--ink-light);">Direct pay via Google Pay app</div>
                </label>
              </div>

              <div class="payment-method-card" onclick="selectPayment('PhonePe')">
                <input type="radio" name="paymentMethod" value="PhonePe" id="pay-phonepe" />
                <label for="pay-phonepe">
                  <strong>PhonePe</strong>
                  <div style="font-size: 0.75rem; color: var(--ink-light);">Pay using PhonePe application</div>
                </label>
              </div>

              <div class="payment-method-card" onclick="selectPayment('Paytm')">
                <input type="radio" name="paymentMethod" value="Paytm" id="pay-paytm" />
                <label for="pay-paytm">
                  <strong>Paytm Wallet / UPI</strong>
                  <div style="font-size: 0.75rem; color: var(--ink-light);">Direct pay via Paytm app</div>
                </label>
              </div>

              <div class="payment-method-card" onclick="selectPayment('Debit Card')">
                <input type="radio" name="paymentMethod" value="Debit Card" id="pay-debit" />
                <label for="pay-debit">
                  <strong>Debit Card</strong>
                  <div style="font-size: 0.75rem; color: var(--ink-light);">Visa, MasterCard, RuPay</div>
                </label>
              </div>

              <div class="payment-method-card" onclick="selectPayment('Net Banking')">
                <input type="radio" name="paymentMethod" value="Net Banking" id="pay-netbanking" />
                <label for="pay-netbanking">
                  <strong>Net Banking</strong>
                  <div style="font-size: 0.75rem; color: var(--ink-light);">All Indian Banks Supported</div>
                </label>
              </div>
            </div>
            
            <div style="margin-top: 15px;">
              <%- include('partials/payment_icons') %>
            </div>
          </div>

          <div style="margin-top: 32px;">
            <button type="submit" class="btn btn-accent btn-full" style="font-size: 1.05rem; padding: 14px 20px;">Confirm &amp; Place Order <i class="bi bi-check-lg"></i></button>
          </div>
        </form>
      </div>

      <!-- Contact Support moved outside of Booking Summary -->
      <div style="background-color: var(--bg); border: 1.5px solid var(--rule); border-radius: 8px; padding: 18px; margin-top: 24px;">
        <h4 style="font-family: var(--font-display); font-size: 0.95rem; font-weight: 700; margin-bottom: 6px;">Need Help?</h4>
        <p style="font-size: 0.8rem; color: var(--ink-light); line-height: 1.5; margin-bottom: 12px;">Need to change delivery location or ask about parts availability? Contact Himanshu Kumawat directly on WhatsApp.</p>
        <a href="https://wa.me/919462759965" target="_blank" class="btn btn-whatsapp btn-sm" style="display: inline-block; width: auto; padding: 8px 16px;"><i class="bi bi-whatsapp"></i> Chat with Himanshu</a>
      </div>
    </div>

    <!-- Cart Summary Sidebar -->
    <div class="col-lg-5 col-md-12 mt-4 mt-lg-0">
      <div class="cart-summary-card">
        <h3>Booking Summary</h3>
        <hr style="border-top: 1px solid var(--rule); margin: 12px 0;" />
        
        <div id="checkout-items-list"></div>
        
        <hr style="border-top: 1px solid var(--rule); margin: 16px 0;" />

        <!-- Price Breakdown -->
        <div style="font-size: 0.95rem; color: var(--ink); margin-bottom: 8px; display: flex; justify-content: space-between;">
          <span>Items Total:</span>
          <strong id="summary-items-total">₹0</strong>
        </div>
        <div style="font-size: 0.95rem; color: #25D366; margin-bottom: 8px; display: flex; justify-content: space-between;">
          <span>Discount:</span>
          <strong id="summary-discount">- ₹0</strong>
        </div>
        <div style="font-size: 0.95rem; color: var(--ink); margin-bottom: 8px; display: flex; justify-content: space-between;">
          <span>Distance:</span>
          <strong id="summary-distance">-- KM</strong>
        </div>
        <div style="font-size: 0.95rem; color: var(--ink); margin-bottom: 16px; display: flex; justify-content: space-between;">
          <span>Delivery Charge:</span>
          <strong id="summary-delivery">Select Address</strong>
        </div>

        <hr style="border-top: 1px dashed var(--rule); margin: 16px 0;" />

        <div class="cart-total-row" style="font-size: 1.3rem; font-weight: 700; color: var(--accent); display: flex; justify-content: space-between; align-items: center;">
          <span>Grand Total:</span>
          <span id="checkout-total-price">₹0</span>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  let checkoutCart = [];
  let currentDeliveryFee = null;
  let currentDistance = null;
  let currentAddressJSON = '';

  function loadCheckoutCart() {
    const saved = localStorage.getItem('kumawat_cart');
    if (saved) {
      try {
        checkoutCart = JSON.parse(saved);
      } catch (e) {
        checkoutCart = [];
      }
    }
    
    if (checkoutCart.length === 0) {
      showToast("Your cart is empty. Redirecting to catalog...");
      setTimeout(() => {
        window.location.href = '/services';
      }, 1500);
      return;
    }
    
    renderCheckoutCart();
  }

  // Razorpay Checkout Integration
  document.getElementById('checkoutForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const cartInput = document.getElementById('cartDataInput');
    const totalInput = document.getElementById('totalAmountInput');
    
    cartInput.value = JSON.stringify(checkoutCart);
    const grandTotalStr = document.getElementById('checkout-total-price').textContent.replace('₹', '').trim();
    totalInput.value = grandTotalStr;

    if (!cartInput.value || checkoutCart.length === 0) {
      showToast("Cart is empty!");
      return false;
    }

    if (!document.getElementById('deliveryAddressJSON').value) {
      showToast("Please select a delivery address.");
      return false;
    }
    
    if (currentDeliveryFee === null) {
      showToast("Delivery is not available at the selected address.");
      return false;
    }

    const formData = new FormData(this);
    const paymentMethod = formData.get('paymentMethod');
    const totalAmount = parseFloat(grandTotalStr);

    if (paymentMethod === 'Cash On Delivery' || paymentMethod === 'Cash') {
      // Direct Submit for COD
      this.submit();
      return;
    }

    // Online Payments via Razorpay
    const submitBtn = this.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.innerHTML = 'Processing... <i class="bi bi-hourglass-split"></i>';

    try {
      // 1. Create Order on Backend
      const response = await fetch('/api/create-razorpay-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ amount: totalAmount })
      });
      const orderData = await response.json();

      if (!orderData.success) {
        throw new Error(orderData.message || "Failed to initiate payment");
      }

      // 2. Open Razorpay Checkout Modal
      const options = {
        key: orderData.key,
        amount: orderData.amount,
        currency: orderData.currency,
        name: "Kumawat P&E",
        description: "Service & Product Order",
        order_id: orderData.order_id,
        handler: function (response) {
          // 3. Inject Payment Details & Submit Form
          const form = document.getElementById('checkoutForm');
          
          const rzpPaymentId = document.createElement('input');
          rzpPaymentId.type = 'hidden';
          rzpPaymentId.name = 'razorpay_payment_id';
          rzpPaymentId.value = response.razorpay_payment_id;
          form.appendChild(rzpPaymentId);

          const rzpOrderId = document.createElement('input');
          rzpOrderId.type = 'hidden';
          rzpOrderId.name = 'razorpay_order_id';
          rzpOrderId.value = response.razorpay_order_id;
          form.appendChild(rzpOrderId);

          const rzpSignature = document.createElement('input');
          rzpSignature.type = 'hidden';
          rzpSignature.name = 'razorpay_signature';
          rzpSignature.value = response.razorpay_signature;
          form.appendChild(rzpSignature);

          form.submit();
        },
        prefill: {
          name: formData.get('customerName'),
          email: formData.get('customerEmail'),
          contact: formData.get('customerPhone')
        },
        theme: { color: "#2d7a7a" }
      };
      
      const rzp = new Razorpay(options);
      rzp.on('payment.failed', function (response) {
        showToast('Payment Failed. Please try again.');
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Confirm &amp; Place Order <i class="bi bi-check-lg"></i>';
      });
      rzp.open();

    } catch (err) {
      console.error(err);
      showToast(err.message || 'Error processing payment');
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Confirm &amp; Place Order <i class="bi bi-check-lg"></i>';
    }
  });

  function renderCheckoutCart() {
    const list = document.getElementById('checkout-items-list');
    const itemsTotalEl = document.getElementById('summary-items-total');
    const discountEl = document.getElementById('summary-discount');
    const deliveryEl = document.getElementById('summary-delivery');
    const grandTotalEl = document.getElementById('checkout-total-price');
    
    if (checkoutCart.length === 0) {
      list.innerHTML = `
        <div class="text-center py-4 text-muted">
          <i class="bi bi-cart3" style="font-size: 2.5rem; display: block; margin-bottom: 10px; color: var(--rule);"></i>
          <p style="font-weight: 600;">🛒 Your cart is empty</p>
          <a href="/services" class="btn btn-outline btn-sm mt-3">Continue Shopping</a>
        </div>
      `;
      itemsTotalEl.textContent = `₹0`;
      discountEl.textContent = `- ₹0`;
      deliveryEl.textContent = `₹0`;
      grandTotalEl.textContent = `₹0`;
      document.querySelector('button[type="submit"]').disabled = true;
      return;
    }
    
    document.querySelector('button[type="submit"]').disabled = false;

    let itemsTotal = 0;
    let totalDiscount = 0;
    let hasProduct = false;
    
    list.innerHTML = checkoutCart.map(item => {
      const isProduct = item.type === 'product';
      if (isProduct) hasProduct = true;
      
      const origPrice = item.originalPrice ? parseFloat(item.originalPrice) : parseFloat(item.price);
      const sellPrice = parseFloat(item.price);
      const qty = parseInt(item.quantity);
      
      const itemOrigTotal = origPrice * qty;
      const itemSellTotal = sellPrice * qty;
      const itemDiscount = itemOrigTotal - itemSellTotal;
      
      itemsTotal += itemOrigTotal;
      totalDiscount += itemDiscount;

      if (isProduct) {
        return `
          <div style="display: flex; gap: 15px; margin-bottom: 16px; border-bottom: 1px solid var(--rule); padding-bottom: 16px;">
            <div style="width: 70px; height: 70px; border-radius: 8px; border: 1px solid var(--rule); overflow: hidden; background: #fff; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
              ${item.image ? `<img src="${item.image}" style="max-width: 100%; max-height: 100%; object-fit: contain;">` : `<i class="bi bi-image text-muted" style="font-size: 2rem;"></i>`}
            </div>
            <div style="flex-grow: 1;">
              <div style="font-weight: 700; font-family: var(--font-display); font-size: 0.95rem; color: var(--ink); line-height: 1.2;">${item.name}</div>
              <div style="font-size: 0.75rem; color: var(--ink-light); margin-top: 4px;">
                ${item.sku && item.sku !== 'N/A' ? `SKU: ${item.sku} &bull; ` : ''}${item.category || 'Product'}
              </div>
              <div style="margin-top: 6px; display: flex; align-items: center; justify-content: space-between;">
                <div>
                  ${itemDiscount > 0 ? `<span style="text-decoration: line-through; color: #999; font-size: 0.8rem; margin-right: 6px;">₹${origPrice}</span>` : ''}
                  <strong style="color: var(--accent); font-size: 1.05rem;">₹${sellPrice}</strong>
                </div>
                <div style="font-size: 0.95rem; font-weight: 700; color: var(--ink);">₹${itemSellTotal}</div>
              </div>
              <div style="margin-top: 12px; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 8px; background: var(--bg); padding: 4px 8px; border-radius: 6px; border: 1px solid var(--rule);">
                  <button type="button" onclick="updateQty('${escape(item.name)}', -1)" style="border: none; background: none; font-size: 1.2rem; line-height: 1; cursor: pointer; color: var(--accent); padding: 0 4px;">-</button>
                  <span style="font-weight: 700; min-width: 20px; text-align: center; font-size: 0.9rem;">${qty}</span>
                  <button type="button" onclick="updateQty('${escape(item.name)}', 1)" style="border: none; background: none; font-size: 1.2rem; line-height: 1; cursor: pointer; color: var(--accent); padding: 0 4px;">+</button>
                </div>
                <button type="button" onclick="removeItem('${escape(item.name)}')" style="border: none; background: none; color: #dc3545; font-size: 0.85rem; font-weight: 600; cursor: pointer;"><i class="bi bi-trash3"></i> Remove</button>
              </div>
            </div>
          </div>
        `;
      } else {
        return `
          <div style="margin-bottom: 16px; border-bottom: 1px solid var(--rule); padding-bottom: 16px;">
            <div style="display: flex; justify-content: space-between;">
              <div style="font-weight: 700; font-family: var(--font-display); font-size: 0.95rem; color: var(--ink); line-height: 1.2;">${item.name}</div>
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--ink);">₹${itemSellTotal}</div>
            </div>
            <div style="font-size: 0.75rem; color: var(--ink-light); margin-top: 4px;">Service</div>
            
            <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: center;">
              <div>
                <strong style="color: var(--accent); font-size: 0.95rem;">₹${sellPrice}</strong> <span style="font-size: 0.8rem; color: var(--ink-light);">each</span>
              </div>
              <div style="display: flex; gap: 16px; align-items: center;">
                <div style="display: flex; align-items: center; gap: 8px; background: var(--bg); padding: 4px 8px; border-radius: 6px; border: 1px solid var(--rule);">
                  <button type="button" onclick="updateQty('${escape(item.name)}', -1)" style="border: none; background: none; font-size: 1.2rem; line-height: 1; cursor: pointer; color: var(--accent); padding: 0 4px;">-</button>
                  <span style="font-weight: 700; min-width: 20px; text-align: center; font-size: 0.9rem;">${qty}</span>
                  <button type="button" onclick="updateQty('${escape(item.name)}', 1)" style="border: none; background: none; font-size: 1.2rem; line-height: 1; cursor: pointer; color: var(--accent); padding: 0 4px;">+</button>
                </div>
                <button type="button" onclick="removeItem('${escape(item.name)}')" style="border: none; background: none; color: #dc3545; font-size: 0.85rem; font-weight: 600; cursor: pointer;"><i class="bi bi-trash3"></i> Remove</button>
              </div>
            </div>
          </div>
        `;
      }
    }).join('');
    
    // Removed GST. Using dynamic delivery fee.
    let taxableAmount = itemsTotal - totalDiscount;
    let grandTotal = taxableAmount + (currentDeliveryFee || 0);
    
    itemsTotalEl.textContent = `₹${itemsTotal}`;
    discountEl.textContent = `- ₹${totalDiscount}`;
    document.getElementById('summary-distance').textContent = currentDistance !== null ? `${currentDistance} KM` : '-- KM';
    document.getElementById('summary-delivery').textContent = currentDeliveryFee !== null ? `₹${currentDeliveryFee}` : 'Select Address';
    grandTotalEl.textContent = `₹${grandTotal}`;

    document.getElementById('totalAmountInput').value = grandTotal;
    document.getElementById('discountAmountInput').value = totalDiscount;
    document.getElementById('deliveryFeeInput').value = currentDeliveryFee || 0;
  }

  function selectAddress(encodedAddrStr, cardElement) {
    document.querySelectorAll('.address-card').forEach(c => c.style.borderColor = 'var(--rule)');
    if(cardElement) cardElement.style.borderColor = 'var(--accent)';
    
    const addr = JSON.parse(decodeURIComponent(encodedAddrStr));
    currentAddressJSON = JSON.stringify(addr);
    document.getElementById('deliveryAddressJSON').value = currentAddressJSON;
    
    // Fetch delivery fee
    fetch('/api/calculate-delivery', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ lat: addr.lat, lng: addr.lng })
    })
    .then(res => res.json())
    .then(data => {
      if (data.serviceable) {
        currentDeliveryFee = data.deliveryFee;
        currentDistance = data.distanceKm;
        renderCheckoutCart(); // Recalculate
        document.querySelector('button[type="submit"]').disabled = false;
      } else {
        showToast(data.message || "Sorry, delivery is not available at this location.");
        currentDeliveryFee = null;
        currentDistance = null;
        renderCheckoutCart();
        document.querySelector('button[type="submit"]').disabled = true;
      }
    });
  }

  function showNewAddressForm() {
    document.getElementById('new-address-form').style.display = 'block';
    document.getElementById('saved-addresses-list').style.display = 'none';
  }

  function hideNewAddressForm() {
    document.getElementById('new-address-form').style.display = 'none';
    document.getElementById('saved-addresses-list').style.display = 'block';
  }

  function getCurrentLocation() {
    if (!navigator.geolocation) {
      return showToast("Geolocation is not supported by your browser.");
    }
    showToast("Fetching location...");
    navigator.geolocation.getCurrentPosition(async (position) => {
      const lat = position.coords.latitude;
      const lng = position.coords.longitude;
      document.getElementById('newAddrLat').value = lat;
      document.getElementById('newAddrLng').value = lng;
      
      try {
        const res = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);
        const data = await res.json();
        if (data && data.address) {
          document.getElementById('newAddrCity').value = data.address.city || data.address.town || data.address.village || '';
          document.getElementById('newAddrState').value = data.address.state || '';
          document.getElementById('newAddrPincode').value = data.address.postcode || '';
          document.getElementById('newAddrStreet').value = data.address.road || data.address.suburb || '';
          showToast("Location autofilled successfully!");
        }
      } catch (e) {
        showToast("Failed to reverse geocode location.");
      }
    }, (err) => {
      showToast("Location access denied or failed.");
    });
  }

  async function saveNewAddress() {
    const payload = {
      fullName: document.getElementById('newAddrName').value,
      mobile: document.getElementById('newAddrMobile').value,
      house: document.getElementById('newAddrHouse').value,
      street: document.getElementById('newAddrStreet').value,
      landmark: document.getElementById('newAddrLandmark').value,
      pincode: document.getElementById('newAddrPincode').value,
      city: document.getElementById('newAddrCity').value,
      state: document.getElementById('newAddrState').value,
      lat: document.getElementById('newAddrLat').value,
      lng: document.getElementById('newAddrLng').value
    };
    
    if(!payload.fullName || !payload.mobile || !payload.house || !payload.street || !payload.pincode || !payload.city || !payload.state) {
      return showToast("Please fill all required address fields.");
    }
    
    try {
      const res = await fetch('/api/user/address', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok && data.success) {
        showToast("Address saved successfully!");
        setTimeout(() => window.location.reload(), 1000);
      } else {
        showToast("Failed: " + (data.message || "Unknown error"));
      }
    } catch(err) {
      showToast("Network error while saving address.");
    }
  }

  function updateQty(escapedName, change) {
    const name = unescape(escapedName);
    const item = checkoutCart.find(i => i.name === name);
    if (item) {
      item.quantity += change;
      if (item.quantity <= 0) {
        removeItem(escapedName);
      } else {
        localStorage.setItem('kumawat_cart', JSON.stringify(checkoutCart));
        renderCheckoutCart();
      }
    }
  }

  function removeItem(escapedName) {
    const name = unescape(escapedName);
    checkoutCart = checkoutCart.filter(i => i.name !== name);
    localStorage.setItem('kumawat_cart', JSON.stringify(checkoutCart));
    renderCheckoutCart();
  }

  function selectPayment(method) {
    document.querySelectorAll('.payment-method-card').forEach(card => {
      card.classList.remove('selected');
      const radio = card.querySelector('input[type="radio"]');
      if (radio.value === method) {
        card.classList.add('selected');
        radio.checked = true;
      }
    });
  }

  // Bind clicks on cards to payment select
  document.addEventListener('DOMContentLoaded', () => {
    loadCheckoutCart();
    
    document.querySelectorAll('.payment-method-card').forEach(card => {
      card.addEventListener('click', () => {
        const radio = card.querySelector('input[type="radio"]');
        selectPayment(radio.value);
      });
    });

    // Set minimum date for preferred Date to today
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('preferredDate').min = today;
    
    // Auto-select default address if exists
    const defaultRadio = document.querySelector('input[name="selectedAddressRadio"]:checked');
    if(defaultRadio) {
      defaultRadio.closest('.address-card').click();
    }
  });

</script>

