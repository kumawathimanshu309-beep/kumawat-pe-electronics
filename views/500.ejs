<%- include('partials/header', { title: 'Server Error | Kumawat P&E', activePage: '' }) %>

<div class="container error-page">
  <div class="error-code"><i class="bi bi-exclamation-octagon text-danger"></i></div>
  <h2 class="error-message">Internal Server Error</h2>
  <p class="error-description">Something went wrong on our server. We are looking into the issue. Please try again later or contact support if the problem persists.</p>
  
  <% if (typeof error !== 'undefined' && error && process.env.NODE_ENV !== 'production') { %>
    <div class="text-start p-3 bg-white border border-danger rounded mb-4" style="max-width: 600px; font-family: monospace; font-size: 0.82rem; overflow-x: auto; white-space: pre;">
      <strong>Error:</strong> <%= error.message %>
      <hr style="margin: 8px 0;" />
      <%= error.stack %>
    </div>
  <% } %>

  <div>
    <a href="/" class="btn btn-accent"><i class="bi bi-house"></i> Back to Safety</a>
    <a href="https://wa.me/919462759965" target="_blank" class="btn btn-whatsapp ms-2"><i class="bi bi-whatsapp"></i> Chat Support</a>
  </div>
</div>

<%- include('partials/footer') %>
