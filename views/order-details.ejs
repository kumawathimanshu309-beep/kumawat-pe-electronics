<%- include('partials/header', { title: 'Order Details | Kumawat P&E', activePage: 'dashboard' }) %>

<div class="container" style="padding: 60px 24px;">
  <div class="mb-4">
    <a href="/my-orders" class="btn btn-outline btn-sm"><i class="bi bi-arrow-left"></i> Back to Orders</a>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card mb-4" style="border: 1px solid var(--rule); border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-light d-flex justify-content-between align-items-center" style="padding: 16px 20px; border-bottom: 1px solid var(--rule);">
          <h4 style="margin: 0; font-family: var(--font-display); font-weight: 700; color: var(--ink);">Order #<%= order.orderId %></h4>
          <span style="font-size: 0.9rem; color: var(--ink-light);"><%= new Date(order.createdAt).toLocaleString() %></span>
        </div>
        <div class="card-body" style="padding: 24px;">
          
          <div class="row mb-4">
            <div class="col-md-6 mb-3 mb-md-0">
              <h6 style="color: var(--ink-light); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Delivery Address</h6>
              <% if (typeof order.deliveryAddress === 'object' && order.deliveryAddress !== null) { %>
                <p style="margin: 0; font-size: 0.95rem; color: var(--ink);">
                  <strong><%= order.deliveryAddress.fullName %></strong> (<%= order.deliveryAddress.mobile %>)<br>
                  <%= order.deliveryAddress.house %>, <%= order.deliveryAddress.street %><br>
                  <%= order.deliveryAddress.landmark ? order.deliveryAddress.landmark + ', ' : '' %><%= order.deliveryAddress.city %>, <%= order.deliveryAddress.state %> - <%= order.deliveryAddress.pincode %>
                </p>
              <% } else { %>
                <p style="margin: 0; font-size: 0.95rem; color: var(--ink); white-space: pre-wrap;"><%= order.deliveryAddress %></p>
              <% } %>
            </div>
            <div class="col-md-6">
              <h6 style="color: var(--ink-light); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Payment Information</h6>
              <p style="margin: 0; font-size: 0.95rem; color: var(--ink);">
                <strong>Method:</strong> <%= order.paymentMethod %><br>
                <strong>Status:</strong> 
                <span style="<%= order.paymentStatus === 'Completed' ? 'color: #28a745;' : 'color: #ffc107;' %> font-weight: 600;">
                  <%= order.paymentStatus %>
                </span><br>
                <% if (order.transactionId) { %>
                  <span style="font-size: 0.8rem; color: var(--ink-light);">Txn ID: <%= order.transactionId %></span>
                <% } %>
              </p>
            </div>
          </div>

          <h5 style="font-family: var(--font-display); font-weight: 700; margin-bottom: 15px; border-bottom: 1px solid var(--rule); padding-bottom: 10px;">Items Ordered</h5>
          
          <% order.items.forEach(item => { %>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="d-flex align-items-center">
                <div style="width: 50px; height: 50px; background: var(--bg); border: 1px solid var(--rule); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                  <% if (item.image) { %>
                    <img src="<%= item.image %>" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                  <% } else { %>
                    <i class="bi bi-box" style="color: var(--ink-light); font-size: 1.5rem;"></i>
                  <% } %>
                </div>
                <div>
                  <div style="font-weight: 600; color: var(--ink);"><%= item.name %></div>
                  <div style="font-size: 0.8rem; color: var(--ink-light);">Qty: <%= item.quantity %> &times; ₹<%= item.price %></div>
                </div>
              </div>
              <div style="font-weight: 700; color: var(--ink);">
                ₹<%= parseFloat(item.price) * parseInt(item.quantity) %>
              </div>
            </div>
          <% }) %>
          
          <hr style="border-color: var(--rule); margin: 20px 0;">
          
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="font-weight: 600; color: var(--ink-light);">Items Subtotal</span>
            <span style="font-size: 1rem; color: var(--ink);">₹<%= order.totalAmount - (order.deliveryFee || 0) + (order.discountAmount || 0) %></span>
          </div>
          <% if (order.discountAmount > 0) { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="font-weight: 600; color: var(--ink-light);">Discount</span>
            <span style="font-size: 1rem; color: var(--accent);">- ₹<%= order.discountAmount %></span>
          </div>
          <% } %>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span style="font-weight: 600; color: var(--ink-light);">Delivery Fee</span>
            <span style="font-size: 1rem; color: var(--ink);">₹<%= order.deliveryFee || 0 %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center" style="border-top: 1px dashed var(--rule); padding-top: 15px;">
            <span style="font-weight: 700; color: var(--ink);">Grand Total</span>
            <span style="font-size: 1.3rem; font-weight: 700; color: var(--accent);">₹<%= order.totalAmount %></span>
          </div>

        </div>
      </div>
    </div>

    <!-- Timeline Tracking -->
    <div class="col-lg-4">
      <div class="card" style="border: 1px solid var(--rule); border-radius: 12px; overflow: hidden; position: sticky; top: 100px;">
        <div class="card-header bg-light" style="padding: 16px 20px; border-bottom: 1px solid var(--rule);">
          <h4 style="margin: 0; font-family: var(--font-display); font-weight: 700; color: var(--ink);">Order Status</h4>
        </div>
        <div class="card-body" style="padding: 24px;">
          
          <div style="font-size: 1.1rem; font-weight: 700; text-align: center; margin-bottom: 25px; padding: 10px; border-radius: 8px;
            <%= order.deliveryStatus === 'Delivered' ? 'background: #d4edda; color: #155724;' : 
                order.deliveryStatus === 'Cancelled' ? 'background: #f8d7da; color: #721c24;' : 
                'background: #e2f3f5; color: var(--accent);' %>">
            <%= order.deliveryStatus %>
          </div>

          <div class="timeline" style="border-left: 2px solid var(--rule); margin-left: 10px; padding-left: 20px;">
            <% if (delivery && delivery.statusLogs) { %>
              <% delivery.statusLogs.slice().reverse().forEach((log, index) => { %>
                <div style="margin-bottom: 20px; position: relative;">
                  <div style="position: absolute; left: -26px; top: 0; width: 10px; height: 10px; border-radius: 50%; background: <%= index === 0 ? 'var(--accent)' : 'var(--rule)' %>;"></div>
                  <div style="font-weight: 600; font-size: 0.95rem; color: <%= index === 0 ? 'var(--ink)' : 'var(--ink-light)' %>;"><%= log.status %></div>
                  <div style="font-size: 0.8rem; color: var(--ink-light); margin-top: 4px;"><%= log.remarks %></div>
                  <div style="font-size: 0.75rem; color: #aaa; margin-top: 2px;"><%= new Date(log.updatedAt || Date.now()).toLocaleString() %></div>
                </div>
              <% }) %>
            <% } else { %>
              <div style="margin-bottom: 20px; position: relative;">
                <div style="position: absolute; left: -26px; top: 0; width: 10px; height: 10px; border-radius: 50%; background: var(--accent);"></div>
                <div style="font-weight: 600; font-size: 0.95rem; color: var(--ink);">Pending</div>
                <div style="font-size: 0.8rem; color: var(--ink-light); margin-top: 4px;">Order placed, awaiting confirmation.</div>
              </div>
            <% } %>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  socket.on('order_status_update', (data) => {
    if (data.orderId === '<%= order.orderId %>') {
      window.location.reload();
    }
  });
</script>

<%- include('partials/footer') %>
