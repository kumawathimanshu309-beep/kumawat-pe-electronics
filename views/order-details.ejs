<%- include('partials/header', { title: 'Order Details | Kumawat P&E', activePage: 'dashboard' }) %>

<div class="container" style="padding: 60px 24px;">
  <div class="mb-4 d-flex justify-content-between align-items-center">
    <a href="/my-orders" class="btn btn-outline btn-sm"><i class="bi bi-arrow-left"></i> Back to Orders</a>
    <a href="/invoice/<%= order.orderId %>?print=true" target="_blank" class="btn btn-outline btn-sm"><i class="bi bi-printer"></i> Print Invoice</a>
  </div>

<style>
  .track-stepper {
    display: flex;
    justify-content: space-between;
    position: relative;
    padding: 0;
    margin: 30px 0;
    list-style: none;
  }
  .track-step {
    flex: 1;
    text-align: center;
    position: relative;
  }
  .track-step::before {
    content: '';
    position: absolute;
    top: 15px;
    left: -50%;
    width: 100%;
    height: 4px;
    background: var(--rule);
    z-index: 0;
  }
  .track-step:first-child::before {
    display: none;
  }
  .track-step.active::before,
  .track-step.completed::before {
    background: #25D366; /* Green for success */
  }
  .track-icon {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--rule);
    color: #6c757d;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 10px;
    position: relative;
    z-index: 1;
    border: 3px solid #fff;
  }
  .track-step.completed .track-icon,
  .track-step.active .track-icon {
    background: #25D366;
    color: #fff;
  }
  .track-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: #6c757d;
  }
  .track-step.active .track-text,
  .track-step.completed .track-text {
    color: var(--ink);
  }
</style>

  <div class="row">
    <div class="col-12 mb-4">
      <div class="card" style="border: 1px solid var(--rule); border-radius: 12px;">
        <div class="card-body" style="padding: 30px;">
          <h5 style="font-family: var(--font-display); font-weight: 700;">Delivery Tracking</h5>
          
          <% 
            const statuses = ['Pending', 'Confirmed', 'Packed', 'Shipped', 'Out For Delivery', 'Delivered'];
            let currentIdx = statuses.indexOf(order.deliveryStatus);
            if (currentIdx === -1) currentIdx = 0; // fallback
          %>
          
          <% if (order.deliveryStatus === 'Cancelled') { %>
            <div class="alert alert-danger text-center mt-3" style="font-weight: 600;">
              <i class="bi bi-x-circle-fill me-2"></i> This order was Cancelled.
            </div>
          <% } else { %>
            <ul class="track-stepper">
              <% statuses.forEach((st, idx) => { 
                let stepClass = '';
                if (idx < currentIdx) stepClass = 'completed';
                else if (idx === currentIdx) stepClass = 'active';
              %>
                <li class="track-step <%= stepClass %>">
                  <div class="track-icon">
                    <% if (idx < currentIdx || (idx === currentIdx && st === 'Delivered')) { %>
                      <i class="bi bi-check-lg"></i>
                    <% } else { %>
                      <%= idx + 1 %>
                    <% } %>
                  </div>
                  <div class="track-text"><%= st %></div>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>
    <div class="col-lg-12">
      <div class="card mb-4" style="border: 1px solid var(--rule); border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-light d-flex justify-content-between align-items-center" style="padding: 16px 20px; border-bottom: 1px solid var(--rule);">
          <h4 style="margin: 0; font-family: var(--font-display); font-weight: 700; color: var(--ink);">Order #<%= order.orderId %></h4>
          <span style="font-size: 0.9rem; color: var(--ink-light);"><%= new Date(order.createdAt).toLocaleString() %></span>
        </div>
        <div class="card-body" style="padding: 24px;">
          
          <div class="row mb-4">
            <div class="col-md-6 mb-3 mb-md-0">
              <h6 style="color: var(--ink-light); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Delivery Address</h6>
              <%
                let addressStr = "Address Not Available";
                if (typeof order.deliveryAddress === 'object' && order.deliveryAddress !== null) {
                  addressStr = `${order.deliveryAddress.house || ''}, ${order.deliveryAddress.street || ''}\n${order.deliveryAddress.city || ''}, ${order.deliveryAddress.state || ''} - ${order.deliveryAddress.pincode || ''}`;
                } else if (typeof order.deliveryAddress === 'string' && order.deliveryAddress.trim() !== '') {
                  try {
                    const parsed = JSON.parse(order.deliveryAddress);
                    addressStr = `${parsed.house || ''}, ${parsed.street || ''}\n${parsed.city || ''}, ${parsed.state || ''} - ${parsed.pincode || ''}`;
                  } catch (e) {
                    addressStr = order.deliveryAddress;
                  }
                }
              %>
              <p style="margin: 0; font-size: 0.95rem; color: var(--ink); white-space: pre-wrap;">
                <%= addressStr %>
              </p>
            </div>
            <div class="col-md-6">
              <h6 style="color: var(--ink-light); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px;">Payment Information</h6>
              <p style="margin: 0; font-size: 0.95rem; color: var(--ink);">
                <strong>Method:</strong> <%= order.paymentMethod %><br>
                <strong>Status:</strong> 
                <span style="<%= order.paymentStatus === 'Completed' ? 'color: #28a745;' : 'color: #ffc107;' %> font-weight: 600;">
                  <%= order.paymentStatus %>
                </span><br>
                <% if (order.transactionId) { %>
                  <span style="font-size: 0.8rem; color: var(--ink-light);">Txn ID: <%= order.transactionId %></span>
                <% } %>
              </p>
            </div>
          </div>

          <h5 style="font-family: var(--font-display); font-weight: 700; margin-bottom: 15px; border-bottom: 1px solid var(--rule); padding-bottom: 10px;">Items Ordered</h5>
          
          <% order.items.forEach(item => { %>
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div class="d-flex align-items-center">
                <div style="width: 50px; height: 50px; background: var(--bg); border: 1px solid var(--rule); border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;">
                  <% if (item.image) { %>
                    <img alt="Image" loading="lazy" decoding="async" src="<%= item.image %>" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                  <% } else { %>
                    <i class="bi bi-box" style="color: var(--ink-light); font-size: 1.5rem;"></i>
                  <% } %>
                </div>
                <div>
                  <div style="font-weight: 600; color: var(--ink);"><%= item.name %></div>
                  <div style="font-size: 0.8rem; color: var(--ink-light);">Qty: <%= item.quantity %> &times; ₹<%= item.price %></div>
                </div>
              </div>
              <div style="font-weight: 700; color: var(--ink);">
                ₹<%= parseFloat(item.price) * parseInt(item.quantity) %>
              </div>
            </div>
          <% }) %>
          
          <hr style="border-color: var(--rule); margin: 20px 0;">
          
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="font-weight: 600; color: var(--ink-light);">Items Subtotal</span>
            <span style="font-size: 1rem; color: var(--ink);">₹<%= order.totalAmount - (order.deliveryFee || 0) + (order.discountAmount || 0) %></span>
          </div>
          <% if (order.discountAmount > 0) { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span style="font-weight: 600; color: var(--ink-light);">Discount</span>
            <span style="font-size: 1rem; color: var(--accent);">- ₹<%= order.discountAmount %></span>
          </div>
          <% } %>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <span style="font-weight: 600; color: var(--ink-light);">Delivery Fee</span>
            <span style="font-size: 1rem; color: var(--ink);">₹<%= order.deliveryFee || 0 %></span>
          </div>
          <div class="d-flex justify-content-between align-items-center" style="border-top: 1px dashed var(--rule); padding-top: 15px;">
            <span style="font-weight: 700; color: var(--ink);">Grand Total</span>
            <span style="font-size: 1.3rem; font-weight: 700; color: var(--accent);">₹<%= order.totalAmount %></span>
          </div>

        </div>
      </div>
    </div>

    </div>
  </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  socket.on('order_status_updated', (data) => {
    if (data.orderId === '<%= order.orderId %>') {
      window.location.reload();
    }
  });
</script>

<%- include('partials/footer') %>
