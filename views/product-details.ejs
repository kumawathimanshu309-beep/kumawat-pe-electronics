<%- include('partials/header') %>

<section class="py-5 mt-5" style="background: var(--bg); min-height: 80vh;">
  <div class="container" style="padding-top: 40px;">
    
    <div class="mb-4">
      <a href="/store" class="btn btn-outline btn-sm"><i class="bi bi-arrow-left"></i> Back to Store</a>
    </div>

    <div class="row g-5">
      <div class="col-lg-6">
        <div class="card p-4 h-100" style="display:flex; align-items:center; justify-content:center; border: 1px solid var(--rule);">
          <% if (product.images && product.images.length > 0) { %>
            <img src="<%= product.images[0] %>" alt="<%= product.name %>" style="max-width: 100%; max-height: 500px; object-fit: contain; border-radius: var(--radius);" />
          <% } else { %>
            <div style="width:100%; height:300px; display:flex; align-items:center; justify-content:center; background:#eee;">
              <i class="bi bi-image text-muted" style="font-size: 4rem;"></i>
            </div>
          <% } %>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <span class="badge bg-light text-dark" style="font-size: 0.85rem;"><%= product.category %></span>
          <% if (product.stock <= 0 || product.status === 'Out Of Stock') { %>
            <span class="badge bg-danger" style="font-size: 0.85rem;">Out of Stock</span>
          <% } else if (product.stock <= 5) { %>
            <span class="badge bg-warning text-dark" style="font-size: 0.85rem;">Only <%= product.stock %> left</span>
          <% } else { %>
            <span class="badge bg-success" style="font-size: 0.85rem;">In Stock</span>
          <% } %>
        </div>

        <h1 style="font-family: var(--font-display); font-size: 2.5rem; font-weight: 700; margin-bottom: 15px;"><%= product.name %></h1>
        
        <div class="price-block mb-4">
          <% if (product.discountPrice) { %>
            <span style="text-decoration:line-through; color:#999; font-size:1.2rem; margin-right: 10px;">₹<%= product.price %></span>
            <strong style="color:var(--accent); font-size:2rem;">₹<%= product.discountPrice %></strong>
          <% } else { %>
            <strong style="font-size:2rem;">₹<%= product.price %></strong>
          <% } %>
        </div>

        <div class="mb-4" style="color: var(--ink-light); line-height: 1.6; font-size: 1.1rem;">
          <%= product.description || 'No description available for this product.' %>
        </div>

        <hr style="border-color: var(--rule); margin: 30px 0;">

        <div class="d-flex gap-3">
          <% if (product.stock > 0 && product.status !== 'Out Of Stock') { %>
            <button class="btn btn-accent btn-full" style="padding: 14px; font-size: 1.2rem;" onclick="buyNowDirect({
              name: '<%= escape(product.name) %>',
              price: <%= product.discountPrice || product.price %>,
              originalPrice: <%= product.price %>,
              image: '<%= product.images && product.images.length ? product.images[0] : '' %>',
              sku: '<%= product.sku || 'N/A' %>',
              category: '<%= product.category || 'General' %>',
              type: 'product'
            })">
              <i class="bi bi-cart-check"></i> Buy Now
            </button>
          <% } else { %>
            <button class="btn btn-secondary btn-full disabled" style="padding: 14px; font-size: 1.2rem;" disabled>Out of Stock</button>
          <% } %>
        </div>

        <div class="mt-4 p-3 bg-light" style="border-radius: var(--radius); font-size: 0.9rem;">
          <div class="d-flex align-items-center mb-2">
            <i class="bi bi-truck me-2 text-primary"></i> 
            <strong>Delivery:</strong> &nbsp; <%= product.deliveryAvailable ? 'Home Delivery Available' : 'Store Pickup Only' %>
          </div>
          <div class="d-flex align-items-center">
            <i class="bi bi-shield-check me-2 text-success"></i>
            <strong>Guaranteed Quality</strong> &nbsp; managed directly by Himanshu Kumawat.
          </div>
        </div>


      </div>
    </div>
  </div>
</section>



<%- include('partials/footer') %>
