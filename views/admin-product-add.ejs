<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Add Product | Store Management</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body style="overflow: hidden; background: var(--bg);">

<div class="admin-layout" style="height: 100vh;">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="name">Kumawat P&amp;E</div>
      <div class="sub">Store Management</div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-item" onclick="window.location.href='/admin?tab=store'">
        <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
      </div>
    </nav>
  </aside>

  <div class="main-area" style="overflow-y: auto;">
    <div class="top-nav px-4 py-3 d-flex align-items-center bg-white border-bottom">
      <h2 style="margin: 0; font-family: var(--font-display); font-size: 1.5rem;">Add New Product</h2>
    </div>
    
    <div style="padding: 40px;">
      <div class="card" style="max-width: 800px; margin: 0 auto;">
      </div>
      <div class="card-body">
        <form action="/admin/products/add" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          
          <div class="field mb-3">
            <label>Product Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" required />
          </div>
          
          <div class="field mb-3">
            <label>Product Image <span class="text-danger">*</span></label>
            <input type="file" name="images" class="form-control" multiple accept="image/*" required />
            <small class="text-muted">You must upload at least one image.</small>
          </div>

          <div class="row mb-3">
            <div class="col-md-6 field">
              <label>Regular Price (₹) <span class="text-danger">*</span></label>
              <input type="number" name="price" class="form-control" required min="0" />
            </div>
            <div class="col-md-6 field">
              <label>Discount Price (₹) [Optional]</label>
              <input type="number" name="discountPrice" class="form-control" min="0" />
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6 field">
              <label>Category [Optional]</label>
              <select name="category" class="form-control">
                <option value="Plumbing">Plumbing</option>
                <option value="Electrical">Electrical</option>
                <option value="AC & Appliances">AC & Appliances</option>
                <option value="Motors & Pumps">Motors & Pumps</option>
                <option value="Tools">Tools</option>
                <option value="Spare Parts">Spare Parts</option>
                <option value="Custom">Custom</option>
              </select>
            </div>
            <div class="col-md-6 field">
              <label>Stock Quantity [Optional]</label>
              <input type="number" name="stock" class="form-control" min="0" value="10" />
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6 field">
              <label>SKU Code [Optional]</label>
              <input type="text" name="sku" class="form-control" />
            </div>
            <div class="col-md-6 field">
              <label>Home Delivery Available?</label>
              <select name="deliveryAvailable" class="form-control">
                <option value="true">Yes</option>
                <option value="false">No</option>
              </select>
            </div>
          </div>

          <div class="field mb-4">
            <label>Description [Optional]</label>
            <textarea name="description" class="form-control" rows="4"></textarea>
          </div>

          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="/admin?tab=store" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-accent">Save Product</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
</body>
</html>
