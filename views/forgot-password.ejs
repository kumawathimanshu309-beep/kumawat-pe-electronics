<%- include('partials/header', { title: 'Reset Password | Kumawat P&E', activePage: 'login' }) %>

<div class="auth-page blueprint-bg">
  <div class="auth-card">
    <div class="auth-title">Reset Password</div>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger" role="alert" style="font-size: 0.85rem; padding: 10px 14px;">
        <i class="bi bi-exclamation-triangle-fill"></i> <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success" role="alert" style="font-size: 0.85rem; padding: 10px 14px;">
        <i class="bi bi-check-circle-fill"></i> <%= success %>
      </div>
    <% } %>

    <!-- MOCK OTP NOTIFICATION FOR TESTING -->
    <% if (typeof mockOtp !== 'undefined' && mockOtp) { %>
      <div class="dev-mock-box" role="alert">
        <strong><i class="bi bi-bug"></i> Developer Test Environment:</strong>
        <span>An OTP has been generated for testing:</span>
        <code><%= mockOtp %></code>
        <span style="font-size: 0.7rem; margin-top: 4px;">Expires in 5 minutes. (SMS gateway mocked)</span>
      </div>
    <% } %>

    <% const currentStep = typeof step !== 'undefined' ? step : 'request' %>

    <% if (currentStep === 'request') { %>
      <!-- STEP 1: Enter mobile number to request OTP -->
      <div class="auth-subtitle">Enter your registered mobile number to receive a 6-digit verification code.</div>
      
      <form action="/forgot-password/request" method="POST">
        <div class="field">
          <label for="mobile">Registered Mobile Number</label>
          <input type="tel" id="mobile" name="mobile" placeholder="+91XXXXXXXXXX" required />
          <span class="hint">Include country code (e.g. +919462759965)</span>
        </div>
        
        <button type="submit" class="btn btn-accent btn-full">Generate OTP <i class="bi bi-shield-lock"></i></button>
      </form>

    <% } else if (currentStep === 'verify') { %>
      <!-- STEP 2: Verify OTP -->
      <div class="auth-subtitle">We have sent a 6-digit OTP code to <strong><%= mobile %></strong>. Enter it below.</div>
      
      <form action="/forgot-password/verify" method="POST">
        <input type="hidden" name="mobile" value="<%= mobile %>" />
        
        <div class="field">
          <label for="otp">Enter 6-Digit OTP</label>
          <input type="text" id="otp" name="otp" placeholder="123456" maxlength="6" pattern="\d{6}" required style="text-align: center; letter-spacing: 0.5em; font-size: 1.25rem;" />
        </div>
        
        <button type="submit" class="btn btn-accent btn-full">Verify OTP <i class="bi bi-check2-circle"></i></button>
      </form>
      
      <div class="text-center mt-3">
        <form action="/forgot-password/request" method="POST">
          <input type="hidden" name="mobile" value="<%= mobile %>" />
          <button type="submit" class="btn btn-link p-0" style="font-size: 0.82rem; color: var(--accent); font-weight: 600;">Resend OTP</button>
        </form>
      </div>

    <% } else if (currentStep === 'reset') { %>
      <!-- STEP 3: Enter new password -->
      <div class="auth-subtitle">OTP verified successfully! Create a strong new password for your account.</div>
      
      <form action="/forgot-password/reset" method="POST" onsubmit="return validatePasswords()">
        <input type="hidden" name="mobile" value="<%= mobile %>" />
        <input type="hidden" name="otp" value="<%= otp %>" />
        
        <div class="field">
          <label for="password">New Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required />
          <span class="hint">Minimum 8 characters.</span>
        </div>
        
        <div class="field">
          <label for="confirmPassword">Confirm New Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" required />
        </div>

        <div id="pass-match-error" class="alert alert-danger" style="display: none; font-size: 0.8rem; padding: 6px 12px; margin-bottom: 15px;">
          Passwords do not match!
        </div>
        
        <button type="submit" class="btn btn-accent btn-full">Update Password <i class="bi bi-key"></i></button>
      </form>

      <script>
        function validatePasswords() {
          const p1 = document.getElementById('password').value;
          const p2 = document.getElementById('confirmPassword').value;
          const errorEl = document.getElementById('pass-match-error');
          
          if (p1.length < 8) {
            errorEl.textContent = 'Password must be at least 8 characters long.';
            errorEl.style.display = 'block';
            return false;
          }
          
          if (p1 !== p2) {
            errorEl.textContent = 'Passwords do not match.';
            errorEl.style.display = 'block';
            return false;
          }
          
          errorEl.style.display = 'none';
          return true;
        }
      </script>
    <% } %>

    <div class="text-center mt-4" style="border-top: 1px solid var(--rule); padding-top: 15px;">
      <a href="/login" style="font-size: 0.82rem; font-weight: 600; color: var(--ink-light);"><i class="bi bi-arrow-left"></i> Back to Login</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
