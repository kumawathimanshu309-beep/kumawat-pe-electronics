<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Invoice - <%= order.orderId %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap" rel="stylesheet" />
  <style>
    body { font-family: 'Manrope', sans-serif; background: #f8f9fa; color: #333; }
    .invoice-container { max-width: 800px; margin: 40px auto; background: #fff; padding: 40px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border-radius: 8px; }
    .invoice-header { display: flex; justify-content: space-between; border-bottom: 2px solid #eee; padding-bottom: 20px; margin-bottom: 30px; }
    .invoice-title { font-size: 2rem; font-weight: 700; color: #C9602A; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 0; }
    .invoice-details { display: flex; justify-content: space-between; margin-bottom: 40px; }
    .invoice-details-col h5 { font-weight: 700; color: #555; text-transform: uppercase; font-size: 0.9rem; margin-bottom: 10px; }
    .table th { background-color: #f8f9fa; border-top: none; color: #555; text-transform: uppercase; font-size: 0.85rem; }
    .table td, .table th { padding: 12px 15px; vertical-align: middle; }
    .totals-row { display: flex; justify-content: flex-end; margin-top: 30px; }
    .totals-table { width: 300px; }
    .totals-table th { text-align: left; padding: 8px 0; background: transparent; font-weight: 600; }
    .totals-table td { text-align: right; padding: 8px 0; }
    .grand-total { font-size: 1.3rem; font-weight: 700; color: #C9602A; border-top: 2px solid #eee; padding-top: 10px; }
    .footer-note { text-align: center; margin-top: 50px; font-size: 0.85rem; color: #888; border-top: 1px solid #eee; padding-top: 20px; }
    @media print {
      body { background: #fff; margin: 0; padding: 0; }
      .invoice-container { box-shadow: none; margin: 0; padding: 20px; max-width: 100%; border-radius: 0; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body>

  <div class="text-center mt-4 mb-3 no-print">
    <button class="btn btn-dark" onclick="window.print()">🖨️ Print Invoice</button>
  </div>

  <div class="invoice-container">
    <div class="invoice-header">
      <div>
        <h2 class="invoice-title">INVOICE</h2>
        <div style="font-size: 0.9rem; color: #666; margin-top: 5px;">
          Order ID: <strong><%= order.orderId %></strong><br>
          Date: <%= new Date(order.createdAt).toLocaleDateString('en-IN') %>
        </div>
      </div>
      <div class="text-end">
        <h4 style="font-weight: 700; margin-bottom: 5px; color: #1C2B2B;">Kumawat P&E</h4>
        <div style="font-size: 0.85rem; color: #666;">
          Govindgarh, Rajasthan 303712<br>
          Phone: +91 9462759965<br>
          Email: contact@kumawatpe.com
        </div>
      </div>
    </div>

    <div class="invoice-details">
      <div class="invoice-details-col">
        <h5>Billed To:</h5>
        <strong><%= order.customerName %></strong><br>
        <span style="font-size: 0.9rem; color: #555;">
          Phone: <%= order.customerPhone %><br>
          <% 
            let addr = order.deliveryAddress;
            if (typeof addr === 'string') {
              try { addr = JSON.parse(addr); } catch(e) {}
            }
          %>
          <div style="max-width: 250px; white-space: pre-wrap;"><%= typeof addr === 'object' ? `${addr.house}, ${addr.street}\n${addr.city} - ${addr.pincode}` : addr %></div>
        </span>
      </div>
      <div class="invoice-details-col text-end">
        <h5>Payment Details:</h5>
        <strong style="font-size: 0.9rem;"><%= order.paymentMethod %></strong><br>
        <span style="font-size: 0.85rem; padding: 2px 6px; border-radius: 4px; background: <%= order.paymentStatus === 'Completed' ? '#d4edda' : '#fff3cd' %>; color: <%= order.paymentStatus === 'Completed' ? '#155724' : '#856404' %>; font-weight: 600;"><%= order.paymentStatus %></span>
        <% if (order.transactionId) { %>
          <br><span style="font-size: 0.8rem; color: #666;">Txn ID: <%= order.transactionId %></span>
        <% } %>
      </div>
    </div>

    <table class="table mb-0">
      <thead>
        <tr>
          <th style="width: 50%;">Item</th>
          <th class="text-center">Qty</th>
          <th class="text-end">Unit Price</th>
          <th class="text-end">Total</th>
        </tr>
      </thead>
      <tbody>
        <% order.items.forEach(item => { %>
          <tr>
            <td style="font-weight: 600;"><%= item.name %></td>
            <td class="text-center"><%= item.quantity %></td>
            <td class="text-end">₹<%= item.price %></td>
            <td class="text-end" style="font-weight: 600;">₹<%= item.price * item.quantity %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="totals-row">
      <table class="totals-table">
        <tr>
          <th>Items Subtotal:</th>
          <td>₹<%= order.totalAmount - (order.deliveryFee || 0) - (order.handlingCharge || 0) + (order.discountAmount || 0) %></td>
        </tr>
        <% if (order.discountAmount > 0) { %>
          <tr>
            <th>Discount:</th>
            <td style="color: #28a745;">- ₹<%= order.discountAmount %></td>
          </tr>
        <% } %>
        <tr>
          <th>Handling Charge:</th>
          <td>₹<%= order.handlingCharge || 11 %></td>
        </tr>
        <tr>
          <th>Delivery Fee:</th>
          <td>₹<%= order.deliveryFee || 0 %></td>
        </tr>
        <tr>
          <th class="grand-total">Grand Total:</th>
          <td class="grand-total">₹<%= order.totalAmount %></td>
        </tr>
      </table>
    </div>

    <div class="footer-note">
      Thank you for choosing Kumawat Plumbing & Electricals!<br>
      This is a computer generated invoice and does not require a signature.
    </div>
  </div>

  <script>
    if (window.location.search.includes('print=true')) {
      window.onload = () => window.print();
    }
  </script>
</body>
</html>
