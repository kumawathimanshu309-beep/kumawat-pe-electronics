</div>

<script>
  // ── CATEGORIES & BRANDS & REVIEWS & CSV CLIENT CONTROLLERS ──
  let allCategories = [];
  let allBrands = [];
  let allReviews = [];
  let allAuditLogs = [];

  // Categories
  async function loadCategories() {
    try {
      const res = await fetch('/api/admin/categories');
      const data = await res.json();
      if (data.success) {
        allCategories = data.categories || [];
        updateCategoryStats();
        filterCategories();
      }
    } catch (e) { console.error('Error loading categories:', e); }
  }

  function updateCategoryStats() {
    const total = allCategories.length;
    const active = allCategories.filter(c => c.status === 'Active').length;
    const totalProducts = allCategories.reduce((acc, c) => acc + (c.productCount || 0), 0);

    if (document.getElementById('cat-stat-total')) document.getElementById('cat-stat-total').textContent = total;
    if (document.getElementById('cat-stat-active')) document.getElementById('cat-stat-active').textContent = active;
    if (document.getElementById('cat-stat-products')) document.getElementById('cat-stat-products').textContent = totalProducts;
  }

  function filterCategories() {
    const query = (document.getElementById('search-categories')?.value || '').trim().toLowerCase();
    const status = document.getElementById('filter-category-status')?.value || '';

    const filtered = allCategories.filter(cat => {
      const matchQuery = !query || cat.name.toLowerCase().includes(query) || cat.slug.toLowerCase().includes(query);
      const matchStatus = !status || cat.status === status;
