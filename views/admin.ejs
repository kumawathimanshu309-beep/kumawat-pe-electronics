<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kumawat P&E — Admin Portal</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  
  <!-- Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />
  
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body style="overflow: hidden;">

<div class="admin-layout">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="name">Kumawat P&amp;E</div>
      <div class="sub">Admin Portal</div>
    </div>
    <div class="sidebar-user">
      <div class="greeting">Logged in as</div>
      <div class="uname"><%= adminUser.name %></div>
      <div id="sidebar-role" style="margin-top:6px;">
        <span class="role-badge role-admin">Admin</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section-label">Dashboard</div>
      <div class="nav-item active" onclick="switchAdminTab('dashboard')">
        <i class="bi bi-grid-1x2 me-2"></i> Overview
      </div>
      <div class="nav-section-label">Manage</div>
      <div class="nav-item" onclick="switchAdminTab('coupons')">
        <i class="bi bi-ticket-perforated me-2"></i> Discount Coupons
      </div>
      <div class="nav-item" onclick="switchAdminTab('orders')">
        <i class="bi bi-cart-check me-2"></i> Bookings &amp; Orders
      </div>
      <div class="nav-item" onclick="switchAdminTab('payments')">
        <i class="bi bi-wallet2 me-2"></i> Payments &amp; Refunds
      </div>
      <div class="nav-item" onclick="switchAdminTab('users')">
        <i class="bi bi-people me-2"></i> User Directory
      </div>
      <div class="nav-item" onclick="switchAdminTab('reviews')">
        <i class="bi bi-star-half me-2"></i> Product Reviews
      </div>
      <div class="nav-section-label">Catalog &amp; Inventory</div>
      <div class="nav-item" onclick="switchAdminTab('store')">
        <i class="bi bi-shop me-2"></i> Products &amp; Inventory
      </div>
      <div class="nav-item" onclick="switchAdminTab('categories')">
        <i class="bi bi-diagram-3 me-2"></i> Categories
      </div>
      <div class="nav-item" onclick="switchAdminTab('brands')">
        <i class="bi bi-tags me-2"></i> Brands
      </div>
      <div class="nav-item" onclick="switchAdminTab('delivery')">
        <i class="bi bi-truck me-2"></i> Delivery &amp; Logistics
      </div>
      <div class="nav-section-label">Security &amp; Audit</div>
      <div class="nav-item" onclick="switchAdminTab('auditlogs')">
        <i class="bi bi-activity me-2"></i> Admin Activity Log
      </div>
      <div class="nav-item" onclick="switchAdminTab('otps')">
        <i class="bi bi-shield-lock me-2"></i> OTP Monitoring
      </div>
      <div class="nav-item" onclick="switchAdminTab('logins')">
        <i class="bi bi-journal-text me-2"></i> Login Logs
      </div>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout" class="btn btn-outline btn-full" style="color:rgba(255,255,255,.6); border-color:rgba(255,255,255,.2); font-size:.8rem;">
        <i class="bi bi-box-arrow-left"></i> Logout
      </a>
      <div class="built">built with ❤️ by 21.coders</div>
    </div>
  </aside>

  <!-- MAIN AREA -->
  <div class="main-area" style="height: 100vh;">
    <div class="topbar">
      <h1 id="page-title">Overview</h1>
      <div class="topbar-right">
        <span style="font-size:.85rem; color:var(--ink-light); margin-right: 15px;"><i class="bi bi-shield-fill-check text-success"></i> Connected</span>
        <div class="form-check form-switch" style="display: inline-block; margin-right: 15px;">
          <input class="form-check-input" type="checkbox" id="storeToggleSwitch" <%= storeEnabled ? 'checked' : '' %> onchange="toggleStore(this)">
          <label class="form-check-label" for="storeToggleSwitch" style="font-size: 0.85rem; color: var(--ink);">Store Enabled</label>
        </div>
        <a href="/" class="btn btn-outline" style="font-size:.78rem; padding:7px 14px;"><i class="bi bi-box-arrow-up-right"></i> View Site</a>
      </div>
    </div>

    <!-- PAGE CONTAINER (Scrollable) -->
    <div style="flex: 1; overflow-y: auto; padding-bottom: 50px;">
      
      <!-- PAGE: DASHBOARD -->
      <div id="page-dashboard" class="page active">
        <div class="stats-row">
          <div class="stat-card accent">
            <div class="label">Total Orders / Bookings</div>
            <div class="value"><%= stats.totalOrders %></div>
            <div class="sub">All time bookings</div>
          </div>
          <div class="stat-card green">
            <div class="label">Total Revenue</div>
            <div class="value">₹<%= stats.totalRevenue %></div>
            <div class="sub">Calculated labour fees</div>
          </div>
          <div class="stat-card yellow">
            <div class="label">Pending Deliveries</div>
            <div class="value"><%= stats.pendingDeliveries %></div>
            <div class="sub">Need confirmation</div>
          </div>
          <div class="stat-card">
            <div class="label">Registered Customers</div>
            <div class="value"><%= stats.totalUsers %></div>
            <div class="sub">Active profiles</div>
          </div>
        </div>

        <!-- ANALYTICS CHARTS -->
        <div class="row mt-4">
          <div class="col-lg-8 mb-4">
            <div class="card h-100">
              <div class="card-header">
                <h3>Revenue & Sales Analytics</h3>
              </div>
              <div class="card-body p-4">
                <canvas id="revenueChart" style="max-height: 300px;"></canvas>
              </div>
            </div>
          </div>
          <div class="col-lg-4 mb-4">
            <div class="card h-100">
              <div class="card-header">
                <h3>Inventory Distribution</h3>
              </div>
              <div class="card-body p-4">
                <canvas id="inventoryChart" style="max-height: 300px;"></canvas>
              </div>
            </div>
          </div>
        </div>

        <div class="row mt-2">
          <div class="col-12">
            <div class="card">
              <div class="card-header">
                <h3>Recent Bookings</h3>
                <button class="btn btn-outline btn-xs" onclick="switchAdminTab('orders')">View All</button>
              </div>
              <div class="card-body" style="padding:0;">
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>ID</th>
                        <th>Customer</th>
                        <th>Preferred Date</th>
                        <th>Amount</th>
                        <th>Delivery Status</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (orders.length === 0) { %>
                        <tr><td colspan="6" class="text-center py-4">No recent bookings.</td></tr>
                      <% } else { %>
                        <% orders.slice(-5).reverse().forEach(o => { %>
                          <tr>
                            <td><code><%= o.orderId %></code></td>
                            <td><strong><%= o.customerName %></strong><div style="font-size:0.75rem;"><%= o.customerPhone %></div></td>
                            <td><%= new Date(o.preferredDate).toLocaleDateString('en-IN') %><div style="font-size:0.75rem;"><%= o.timeSlot %></div></td>
                            <td><strong>₹<%= o.totalAmount %></strong></td>
                            <td>
                              <span class="badge" id="badge-status-<%= o.orderId %>" style="font-weight:600;"><%= o.deliveryStatus %></span>
                            </td>
                            <td>
                              <select class="btn btn-outline btn-xs" onchange="updateOrderStatus('<%= o.orderId %>', this)" id="select-status-<%= o.orderId %>" data-prev="<%= o.deliveryStatus %>" style="padding: 2px 6px; font-size: 0.75rem;">
                                <% ['Pending', 'Confirmed', 'Processing', 'Packed', 'Out For Delivery', 'Delivered', 'Cancelled'].forEach(st => { %>
                                  <option value="<%= st %>" <%= o.deliveryStatus === st ? 'selected' : '' %>><%= st %></option>
                                <% }) %>
                              </select>
                            </td>
                          </tr>
                        <% }) %>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: ORDERS -->
      <div id="page-orders" class="page d-none">
        <div class="card">
          <div class="card-header">
            <h3>Manage Bookings &amp; Deliveries</h3>
            <div class="filters-right">
              <select id="filter-order-status" class="filter-select" onchange="filterOrders()">
                <option value="">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="In Transit">In Transit</option>
                <option value="Delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>
              </select>
            </div>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <input type="text" id="search-orders" class="search-input" placeholder="Search by customer name, phone, order ID..." onkeyup="filterOrders()" />
            </div>
            
            <div class="table-wrap">
              <table id="orders-table">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (orders.length === 0) { %>
                    <tr><td colspan="8" class="text-center py-4">No orders found.</td></tr>
                  <% } else { %>
                    <% orders.reverse().forEach(o => { %>
                      <tr class="order-row" data-status="<%= o.deliveryStatus %>" data-search="<%= (o.orderId + ' ' + o.customerName + ' ' + o.customerPhone).toLowerCase() %>">
                        <td><code><%= o.orderId %></code></td>
                        <td>
                          <strong><%= o.customerName %></strong>
                          <div style="font-size:0.75rem; margin-top:2px;">
                            <a href="tel:<%= o.customerPhone %>" style="color:var(--accent);"><i class="bi bi-phone"></i> <%= o.customerPhone %></a>
                          </div>
                        </td>
                        <td>
                          <%= new Date(o.createdAt).toLocaleDateString('en-IN') %>
                        </td>
                        <td>
                          <div style="font-size:0.8rem; max-width: 150px;">
                            <%= o.items.reduce((acc, item) => acc + item.quantity, 0) %> items
                            <br>
                            <span class="text-muted" style="font-size: 0.7rem;"><%= o.items.map(item => item.name).join(', ') %></span>
                          </div>
                        </td>
                        <td>
                          <strong>₹<%= o.totalAmount %></strong>
                        </td>
                        <td>
                          <div style="font-size:0.75rem;"><%= o.paymentMethod %></div>
                          <span class="badge <%= o.paymentStatus === 'Completed' ? 'badge-confirmed' : 'badge-pending' %>" style="font-size:0.65rem; padding:1px 6px;"><%= o.paymentStatus %></span>
                        </td>
                        <td>
                          <span class="badge" id="badge-status-main-<%= o.orderId %>" style="font-weight:600;"><%= o.deliveryStatus %></span>
                        </td>
                        <td>
                          <div class="action-btns" style="display:flex; flex-direction:column; gap: 4px;">
                            <select class="form-select form-select-sm" onchange="updateOrderStatus('<%= o.orderId %>', this)" id="select-status-main-<%= o.orderId %>" data-prev="<%= o.deliveryStatus %>" style="font-size: 0.75rem;">
                              <% ['Pending', 'Confirmed', 'Processing', 'Packed', 'Shipped', 'Out For Delivery', 'Delivered', 'Cancelled'].forEach(st => { %>
                                <option value="<%= st %>" <%= o.deliveryStatus === st ? 'selected' : '' %>><%= st %></option>
                              <% }) %>
                            </select>
                            <div class="d-flex gap-1">
                              <a href="/order/<%= o.orderId %>" target="_blank" class="btn btn-outline btn-xs flex-fill" style="padding: 2px 5px;"><i class="bi bi-eye"></i></a>
                              <a href="/invoice/<%= o.orderId %>" target="_blank" class="btn btn-primary btn-xs flex-fill" style="padding: 2px 5px;"><i class="bi bi-printer"></i></a>
                              <a href="/admin/order/delete/<%= o.orderId %>" onclick="return confirm('Are you sure you want to delete this order?')" class="btn btn-danger btn-xs flex-fill" style="padding: 2px 5px;"><i class="bi bi-trash"></i></a>
                            </div>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: PAYMENTS & FINANCE ANALYTICS V2 -->
      <div id="page-payments" class="page d-none">
        
        <!-- RAZORPAY TEST MODE BANNER -->
        <div class="alert alert-warning d-flex align-items-center justify-content-between mb-4 shadow-sm" style="border-radius: var(--radius-lg, 12px); border-left: 5px solid #ffc107; background: #fffdf5;">
          <div class="d-flex align-items-center">
            <i class="bi bi-lightning-charge-fill fs-4 me-3 text-warning"></i>
            <div>
              <strong style="color: var(--ink);">⚡ RAZORPAY TEST MODE ACTIVE</strong>
              <div style="font-size: 0.82rem;" class="text-muted">All payment processing is operating under Razorpay Test Sandbox credentials. No real money is moved.</div>
            </div>
          </div>
          <span class="badge bg-warning text-dark px-3 py-2 fw-bold" style="letter-spacing: 0.05em;">TEST MODE</span>
        </div>

        <!-- FINANCE SUMMARY METRICS GRID -->
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-4 col-xl-3">
            <div class="card p-3 h-100 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px);">
              <div class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Today's Revenue</div>
              <h3 class="fw-bold my-1 text-ink" id="fin-today-rev">₹0.00</h3>
              <div class="text-success" style="font-size: 0.78rem;"><i class="bi bi-calendar-check me-1"></i> Today's Captured Sales</div>
            </div>
          </div>

          <div class="col-6 col-md-4 col-xl-3">
            <div class="card p-3 h-100 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px);">
              <div class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">7-Day Revenue</div>
              <h3 class="fw-bold my-1 text-accent" id="fin-7day-rev">₹0.00</h3>
              <div class="text-muted" style="font-size: 0.78rem;"><i class="bi bi-graph-up-arrow me-1"></i> Last 7 Days Total</div>
            </div>
          </div>

          <div class="col-6 col-md-4 col-xl-3">
            <div class="card p-3 h-100 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px);">
              <div class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">30-Day Revenue</div>
              <h3 class="fw-bold my-1 text-primary" id="fin-30day-rev">₹0.00</h3>
              <div class="text-muted" style="font-size: 0.78rem;"><i class="bi bi-calendar3 me-1"></i> Rolling 30 Days</div>
            </div>
          </div>

          <div class="col-6 col-md-4 col-xl-3">
            <div class="card p-3 h-100 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px);">
              <div class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Avg Order Value (AOV)</div>
              <h3 class="fw-bold my-1 text-dark" id="fin-aov">₹0.00</h3>
              <div class="text-muted" style="font-size: 0.78rem;"><i class="bi bi-calculator me-1"></i> Net Sales / Orders</div>
            </div>
          </div>

          <div class="col-6 col-md-4 col-xl-3">
            <div class="card p-3 h-100 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px);">
              <div class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Successful Payments</div>
              <h3 class="fw-bold my-1 text-success" id="fin-success-count">0</h3>
              <div class="text-muted" style="font-size: 0.78rem;"><i class="bi bi-check-circle-fill me-1"></i> Paid &amp; Completed</div>
            </div>
          </div>

          <div class="col-6 col-md-4 col-xl-3">
            <div class="card p-3 h-100 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px);">
              <div class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Pending Payments</div>
              <h3 class="fw-bold my-1 text-warning" id="fin-pending-amount">₹0.00</h3>
              <div class="text-muted" style="font-size: 0.78rem;" id="fin-pending-count">0 Pending Txns</div>
            </div>
          </div>

          <div class="col-6 col-md-4 col-xl-3">
            <div class="card p-3 h-100 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px);">
              <div class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Refunds Total</div>
              <h3 class="fw-bold my-1 text-danger" id="fin-refund-amount">₹0.00</h3>
              <div class="text-muted" style="font-size: 0.78rem;" id="fin-refund-count">0 Refunded Txns</div>
            </div>
          </div>

          <div class="col-6 col-md-4 col-xl-3">
            <div class="card p-3 h-100 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px); background: #fdfbf7;">
              <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Net Profit</span>
                <i class="bi bi-info-circle text-muted" data-bs-toggle="tooltip" title="Calculated strictly as Net Sales minus Product Costs. If cost data is missing, profit is labeled unavailable rather than guessed."></i>
              </div>
              <h3 class="fw-bold my-1 text-dark" id="fin-net-profit">—</h3>
              <div class="text-muted text-truncate" style="font-size: 0.75rem;" id="fin-profit-status">Profit unavailable — cost data not configured</div>
            </div>
          </div>
        </div>

        <!-- REVENUE CHART & CONTROLS -->
        <div class="card p-4 mb-4 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px);">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <h5 class="m-0 font-display fw-bold text-ink"><i class="bi bi-graph-up text-accent me-2"></i> Revenue &amp; Payment Trends</h5>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <select id="fin-filter-range" class="form-select form-select-sm" style="width: auto;" onchange="loadFinanceAnalytics()">
                <option value="30days" selected>Last 30 Days</option>
                <option value="today">Today</option>
                <option value="7days">Last 7 Days</option>
                <option value="month">This Month</option>
                <option value="all">All Time</option>
              </select>
              <button class="btn btn-outline btn-sm" onclick="exportFinanceCSV()"><i class="bi bi-download me-1"></i> Export CSV</button>
            </div>
          </div>
          <div style="height: 220px; position: relative;">
            <canvas id="revenueTrendChart"></canvas>
          </div>
        </div>

        <!-- TRANSACTIONS TABLE & FILTERS -->
        <div class="card p-4 shadow-sm" style="border: 1px solid var(--rule); border-radius: var(--radius-lg, 12px);">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
            <h5 class="m-0 font-display fw-bold text-ink"><i class="bi bi-receipt text-accent me-2"></i> Transaction History</h5>
            
            <div class="d-flex gap-2 flex-wrap w-100 w-md-auto">
              <input type="text" id="fin-search-input" class="form-control form-control-sm" placeholder="Search Order ID, Payment ID, Customer..." style="max-width: 250px;" onkeyup="debounceFinanceSearch()" />
              
              <select id="fin-filter-status" class="form-select form-select-sm" style="width: auto;" onchange="loadFinanceAnalytics()">
                <option value="all" selected>All Statuses</option>
                <option value="paid">Paid / Completed</option>
                <option value="pending">Pending</option>
                <option value="failed">Failed / Cancelled</option>
                <option value="refunded">Refunded</option>
              </select>

              <select id="fin-filter-method" class="form-select form-select-sm" style="width: auto;" onchange="loadFinanceAnalytics()">
                <option value="all" selected>All Methods</option>
                <option value="razorpay">Razorpay</option>
                <option value="upi">UPI / PhonePe / Paytm</option>
                <option value="cod">COD / Cash</option>
              </select>
            </div>
          </div>

          <div class="table-responsive">
            <table class="table align-middle">
              <thead class="table-light">
                <tr style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">
                  <th>Date &amp; Time</th>
                  <th>Order ID</th>
                  <th>Method</th>
                  <th>Payment / Txn ID</th>
                  <th>Amount</th>
                  <th>Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="fin-transactions-tbody">
                <tr><td colspan="7" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span> Loading transactions...</td></tr>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <div class="d-flex align-items-center justify-content-between pt-3 border-top" id="fin-pagination-wrap">
            <span class="text-muted font-xs" id="fin-pagination-info">Showing 0 of 0 transactions</span>
            <div class="btn-group btn-group-sm" id="fin-pagination-btns">
              <!-- Rendered dynamically -->
            </div>
          </div>

        </div>

      </div>

      <!-- PAGE: USERS -->
      <div id="page-users" class="page d-none">
        <div class="card">
          <div class="card-header">
            <h3>Registered Customers Directory</h3>
            <button class="btn btn-green btn-xs" onclick="exportUsersToCSV()"><i class="bi bi-file-earmark-spreadsheet"></i> Export User Data (CSV)</button>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <div class="filters-left">
                <input type="text" id="search-users" class="search-input" placeholder="Search by name, email, mobile, address..." onkeyup="filterUsers()" />
                <select id="filter-user-role" class="filter-select" onchange="filterUsers()">
                  <option value="">All Roles</option>
                  <option value="user">User</option>
                  <option value="admin">Admin</option>
                </select>
              </div>
            </div>

            <div class="table-wrap">
              <table id="users-table">
                <thead>
                  <tr>
                    <th>Customer Name</th>
                    <th>User ID</th>
                    <th>Email Address</th>
                    <th>Mobile</th>
                    <th>Address</th>
                    <th>Loyalty Card</th>
                    <th>Dates (Joined / Last Login)</th>
                    <th>Activity Log</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                    <tr class="user-row" data-role="<%= u.role %>" data-search="<%= (u.name + ' ' + u.email + ' ' + u.mobile + ' ' + u.address + ' ' + u.userId).toLowerCase() %>">
                      <td>
                        <strong><%= u.name %></strong>
                        <div><span class="badge <%= u.role === 'admin' ? 'badge-admin' : 'badge-user' %>" style="font-size:0.65rem; padding:1px 5px;"><%= u.role %></span></div>
                      </td>
                      <td><code><%= u.userId %></code></td>
                      <td><%= u.email %></td>
                      <td><a href="tel:<%= u.mobile %>" style="color:var(--accent);"><%= u.mobile %></a></td>
                      <td style="max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= u.address %>"><%= u.address || '—' %></td>
                      <td>
                        <span class="badge bg-secondary text-white font-monospace"><%= u.cardNumber || 'None' %></span>
                      </td>
                      <td style="font-size: 0.78rem;">
                        <div>Reg: <%= new Date(u.createdAt).toLocaleDateString('en-IN') %></div>
                        <div class="text-muted">Login: <%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString('en-IN') : 'Never' %></div>
                      </td>
                      <td>
                        <button class="btn btn-outline btn-xs" onclick="viewUserActivity('<%= u.name %>', '<%= escape(JSON.stringify(u.activities)) %>')">Logs (<%= u.activities.length %>)</button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: STORE MANAGEMENT -->
      <div id="page-store" class="page d-none">
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h3>Products &amp; Inventory</h3>
            <div>
              <form action="/admin/store/toggle" method="POST" style="display:inline-block; margin-right: 15px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <% if (storeEnabled) { %>
                  <button type="submit" class="btn btn-outline btn-xs border-success text-success"><i class="bi bi-toggle-on"></i> Store is ON (Disable)</button>
                <% } else { %>
                  <button type="submit" class="btn btn-outline btn-xs border-danger text-danger"><i class="bi bi-toggle-off"></i> Store is OFF (Enable)</button>
                <% } %>
              </form>
              <button class="btn btn-outline btn-xs me-2" onclick="openBulkImportModal()"><i class="bi bi-file-earmark-spreadsheet"></i> Bulk Import (CSV)</button>
              <button class="btn btn-outline btn-xs me-2" onclick="exportProductsCSV()"><i class="bi bi-download"></i> Export CSV</button>
              <a href="/admin/products/new" class="btn btn-accent btn-xs"><i class="bi bi-plus-lg"></i> Add New Product</a>
            </div>
          </div>

          <!-- Bulk Import Modal -->
          <div class="modal fade" id="bulkImportModal" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header border-0">
                  <h5 class="modal-title" style="font-family:var(--font-display); font-weight:700;">Bulk Import Products</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                  <p class="text-muted" style="font-size:0.9rem;">Upload a CSV file to create or update multiple products at once. For updating, ensure the <strong class="text-dark">productId</strong> matches exactly.</p>
                  <a href="/admin/products/csv-template" target="_blank" class="btn btn-outline btn-sm mb-4"><i class="bi bi-download"></i> Download Strict CSV Template</a>
                  
                  <div class="border p-4 bg-light rounded" style="border-style:dashed!important;">
                    <form id="bulkImportForm">
                      <input type="file" id="csvFile" name="csvFile" accept=".csv" class="form-control mb-3" required />
                      <button type="submit" class="btn btn-accent w-100" id="btn-import"><i class="bi bi-upload"></i> Start Import</button>
                    </form>
                  </div>
                  
                  <div id="import-results" class="mt-3 text-start d-none p-3 rounded" style="font-size:0.85rem; background: var(--bg);">
                    <div id="import-summary" class="fw-bold mb-2"></div>
                    <ul id="import-errors" class="text-danger ps-3 mb-0"></ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="px-4 py-3" style="background: rgba(0,0,0,0.02); border-bottom: 1px solid var(--rule);">
            <div class="row text-center">
              <% 
                const activeCount = products.filter(p => p.status === 'Active' || !p.status).length;
                const outOfStockCount = products.filter(p => p.stock <= 0 || p.status === 'Out Of Stock').length;
                const hiddenCount = products.filter(p => p.status === 'Hidden' || p.status === 'Disabled').length;
              %>
              <div class="col-3">
                <div style="font-size: 1.5rem; font-weight: 700;"><%= products.length %></div>
                <div style="font-size: 0.8rem; color: var(--ink-light);">Total Products</div>
              </div>
              <div class="col-3 border-start">
                <div style="font-size: 1.5rem; font-weight: 700; color: var(--success);"><%= activeCount %></div>
                <div style="font-size: 0.8rem; color: var(--ink-light);">Active</div>
              </div>
              <div class="col-3 border-start">
                <div style="font-size: 1.5rem; font-weight: 700; color: var(--danger);"><%= outOfStockCount %></div>
                <div style="font-size: 0.8rem; color: var(--ink-light);">Out of Stock</div>
              </div>
              <div class="col-3 border-start">
                <div style="font-size: 1.5rem; font-weight: 700; color: var(--ink-light);"><%= hiddenCount %></div>
                <div style="font-size: 0.8rem; color: var(--ink-light);">Disabled</div>
              </div>
            </div>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <input type="text" id="search-products" class="search-input" placeholder="Search products by name or SKU..." onkeyup="filterProducts()" />
            </div>
            <div class="table-wrap">
              <table id="products-table">
                <thead>
                  <tr>
                    <th>Image</th>
                    <th>Product Name &amp; SKU</th>
                    <th>Category</th>
                    <th>Pricing</th>
                    <th>Stock (Adjust)</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!products || products.length === 0) { %>
                    <tr>
                      <td colspan="7" class="text-center py-5">
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0.7;">
                          <i class="bi bi-box-seam" style="font-size: 3rem; margin-bottom: 10px;"></i>
                          <h4 style="font-family: var(--font-display); font-weight: 600;">📦 No products added yet</h4>
                          <p style="font-size: 0.95rem;">Click "Add New Product" to create your first product.</p>
                        </div>
                      </td>
                    </tr>
                  <% } else { %>
                    <% products.filter(p => p.status !== 'Deleted').reverse().forEach(p => { %>
                      <tr class="product-row" data-search="<%= (p.name + ' ' + p.sku).toLowerCase() %>">
                        <td>
                          <% if (p.images && p.images.length > 0) { %>
                            <img alt="Image" loading="lazy" decoding="async" src="<%= optimizeImage(p.images[0]) %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                          <% } else { %>
                            <div style="width: 50px; height: 50px; background: #eee; border-radius: 4px; display:flex; align-items:center; justify-content:center;"><i class="bi bi-image text-muted"></i></div>
                          <% } %>
                        </td>
                        <td>
                          <strong><%= p.name %></strong>
                          <div style="font-size:0.75rem; color:var(--ink-light);"><%= p.sku || 'N/A' %></div>
                        </td>
                        <td><span class="badge bg-light text-dark"><%= p.category %></span></td>
                        <td>
                          <% if (p.discountPrice) { %>
                            <span style="text-decoration:line-through; color:#999; font-size:0.8rem;">₹<%= p.price %></span>
                            <strong style="color:var(--accent);">₹<%= p.discountPrice %></strong>
                          <% } else { %>
                            <strong>₹<%= p.price %></strong>
                          <% } %>
                        </td>
                        <td>
                          <div class="d-flex align-items-center gap-1">
                            <button class="btn btn-outline btn-xs px-1 py-0" onclick="adjustStock('<%= p.productId %>', -1)">-</button>
                            <span id="stock-val-<%= p.productId %>" class="fw-bold fs-6"><%= p.stock %></span>
                            <button class="btn btn-outline btn-xs px-1 py-0" onclick="adjustStock('<%= p.productId %>', 1)">+</button>
                          </div>
                          <% if (p.stock <= (p.lowStockThreshold || 5)) { %>
                            <span class="badge bg-warning text-dark mt-1" style="font-size:0.7rem;">⚠️ LOW STOCK</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (p.status === 'Hidden' || p.status === 'Disabled') { %>
                            <span class="badge bg-secondary">Disabled</span>
                          <% } else if (p.stock <= 0 || p.status === 'Out Of Stock') { %>
                            <span class="badge bg-danger">Out of Stock</span>
                          <% } else { %>
                            <span class="badge bg-success"><%= p.status || 'Active' %></span>
                          <% } %>
                        </td>
                        <td>
                          <div class="action-btns">
                            <button onclick="duplicateProduct('<%= p.productId %>')" class="btn btn-outline btn-xs me-1" title="Duplicate"><i class="bi bi-copy"></i> Duplicate</button>
                            <a href="/admin/products/edit/<%= p.productId %>" class="btn btn-outline btn-xs"><i class="bi bi-pencil"></i> Edit</a>
                            <a href="/admin/products/delete/<%= p.productId %>" onclick="return confirm('Permanently delete this product?')" class="btn btn-danger btn-xs"><i class="bi bi-trash"></i></a>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: OTPS -->
      <div id="page-otps" class="page d-none">
        <div class="card">
          <div class="card-header">
            <h3>Forgot Password OTP Logs &amp; Monitoring</h3>
            <span class="badge bg-info text-white">Rate-Limit Active: Max 3/req</span>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <input type="text" id="search-otps" class="search-input" placeholder="Search by mobile number..." onkeyup="filterOtps()" />
            </div>

            <div class="table-wrap">
              <table id="otps-table">
                <thead>
                  <tr>
                    <th>Mobile</th>
                    <th>OTP Code</th>
                    <th>Requested At</th>
                    <th>Expires At</th>
                    <th>Status</th>
                    <th>Attempts</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (otpLogs.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-4">No OTP activities recorded.</td></tr>
                  <% } else { %>
                    <% otpLogs.reverse().forEach(o => { %>
                      <tr class="otp-row" data-search="<%= o.mobile %>">
                        <td><strong><%= o.mobile %></strong></td>
                        <td><code style="font-size:0.9rem; font-weight:bold; color:var(--accent);"><%= o.otp %></code></td>
                        <td><%= new Date(o.createdAt).toLocaleString('en-IN') %></td>
                        <td><%= new Date(o.expiresAt).toLocaleString('en-IN') %></td>
                        <td>
                          <%
                            let badge = 'badge-pending';
                            if (o.status === 'Verified') badge = 'badge-confirmed';
                            if (o.status === 'Expired' || new Date() > o.expiresAt) badge = 'badge-cancelled';
                          %>
                          <span class="badge <%= badge %>"><%= new Date() > o.expiresAt && o.status === 'Pending' ? 'Expired' : o.status %></span>
                        </td>
                        <td><span class="badge bg-dark text-white"><%= o.requestCount %> / 3</span></td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: LOGINS -->
      <div id="page-logins" class="page d-none">
        <div class="card">
          <div class="card-header">
            <h3>Login Security Audit Trial Logs</h3>
            <span class="badge bg-dark text-white">Total Records: <%= loginLogs.length %></span>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <input type="text" id="search-logins" class="search-input" placeholder="Search by Username/Email/Mobile..." onkeyup="filterLogins()" />
            </div>

            <div class="table-wrap">
              <table id="logins-table">
                <thead>
                  <tr>
                    <th>Username / Identity</th>
                    <th>Timestamp</th>
                    <th>IP Address</th>
                    <th>Status</th>
                    <th>Browser details</th>
                    <th>Reason (if Failed)</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (loginLogs.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-4">No login security records.</td></tr>
                  <% } else { %>
                    <% loginLogs.reverse().forEach(l => { %>
                      <tr class="login-row" data-search="<%= l.emailOrMobile.toLowerCase() %>">
                        <td><strong><%= l.emailOrMobile %></strong></td>
                        <td><%= new Date(l.createdAt).toLocaleString('en-IN') %></td>
                        <td><code><%= l.ipAddress || '127.0.0.1' %></code></td>
                        <td>
                          <span class="badge <%= l.status === 'Success' ? 'badge-confirmed' : 'badge-cancelled' %>"><%= l.status %></span>
                        </td>
                        <td style="font-size:0.75rem; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= l.userAgent %>">
                          <%= l.userAgent %>
                        </td>
                        <td class="text-danger font-weight-bold"><%= l.failureReason || '—' %></td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: COUPONS -->
      <div id="page-coupons" class="page d-none">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="mb-0">Discount Coupons</h2>
          <button class="btn btn-accent" onclick="showCouponModal()"><i class="bi bi-plus-lg"></i> Create Coupon</button>
        </div>
        <div class="card p-0" style="border-radius: var(--radius); border: 1px solid var(--rule);">
          <div class="table-responsive">
            <table class="table align-middle m-0" id="coupons-table">
              <thead class="table-light">
                <tr>
                  <th>Code</th>
                  <th>Type & Discount</th>
                  <th>Min Order</th>
                  <th>Usage Limit</th>
                  <th>Expiry</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="coupons-tbody">
                <tr><td colspan="7" class="text-center py-4">Loading coupons...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- PAGE: DELIVERY & LOGISTICS -->
      <div id="page-delivery" class="page d-none">
        <div class="dashboard-block mb-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="m-0">Delivery Settings & Routing</h3>
            <button class="btn btn-accent" onclick="saveDeliverySettings()">Save Settings</button>
          </div>
          <div class="row">
            <div class="col-md-4">
              <div class="field">
                <label>Default Delivery Fee (₹)</label>
                <input type="number" id="defaultDeliveryFee" class="form-control" value="100">
                <div class="form-text">Fallback fee if distance slab is not matched.</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="field">
                <label>Max Delivery Distance (KM)</label>
                <input type="number" id="maxDeliveryDistance" class="form-control" value="50">
              </div>
            </div>
            <div class="col-md-4">
              <div class="field">
                <label>Minimum Order Amount (₹)</label>
                <input type="number" id="minOrderAmount" class="form-control" value="0">
              </div>
            </div>
          </div>

          <hr class="my-4">
          
          <div class="mb-4">
            <h4 class="m-0 mb-3">Store Location Settings</h4>
            <div class="row">
              <div class="col-12 mb-2">
                <label>Store Address</label>
                <input type="text" id="storeAddress" class="form-control" value="Kumawat P&E, Adda Ball, Kui Ke Pass, Station Road, Govindgarh, Rajasthan">
              </div>
              <div class="col-md-6 mb-2">
                <label>Store Latitude</label>
                <input type="number" step="any" id="storeLat" class="form-control" value="27.4243">
              </div>
              <div class="col-md-6 mb-2">
                <label>Store Longitude</label>
                <input type="number" step="any" id="storeLng" class="form-control" value="74.3722">
              </div>
            </div>
          </div>

          <hr class="my-4">
          
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="m-0">Distance Rules (Slabs)</h4>
            <button class="btn btn-outline btn-sm" onclick="addDistanceRule()">+ Add Distance Slab</button>
          </div>
          
          <div id="distanceRulesContainer">
            <!-- Rules will be rendered here dynamically -->
          </div>
        </div>
      </div>

      <!-- PAGE: CATEGORIES -->
      <div id="page-categories" class="page d-none">
        <!-- Stats Cards Row -->
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="stat-card">
              <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-tags-fill"></i></div>
              <div class="stat-info">
                <span class="stat-label">Total Categories</span>
                <h3 class="stat-value m-0" id="cat-stat-total"><%= categories ? categories.length : 0 %></h3>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-card">
              <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-check-circle-fill"></i></div>
              <div class="stat-info">
                <span class="stat-label">Active Categories</span>
                <h3 class="stat-value m-0" id="cat-stat-active"><%= categories ? categories.filter(c=>c.status==='Active').length : 0 %></h3>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-card">
              <div class="stat-icon bg-info-subtle text-info"><i class="bi bi-box-seam"></i></div>
              <div class="stat-info">
                <span class="stat-label">Products Mapped</span>
                <h3 class="stat-value m-0" id="cat-stat-products"><%= categories ? categories.reduce((s,c)=>s+(c.productCount||0),0) : 0 %></h3>
              </div>
            </div>
          </div>
        </div>

        <div class="dashboard-block mb-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h3 class="m-0 fs-5 fw-bold"><i class="bi bi-folder-fill me-2 text-warning"></i>Category Management</h3>
            <div class="d-flex align-items-center gap-2">
              <div class="input-group input-group-sm" style="max-width: 220px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="search-categories" class="form-control" placeholder="Search category..." oninput="filterCategories()">
              </div>
              <select id="filter-category-status" class="form-select form-select-sm" style="width: auto;" onchange="filterCategories()">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Disabled">Disabled</option>
              </select>
              <button class="btn btn-accent btn-sm" onclick="showCategoryModal()"><i class="bi bi-plus-lg me-1"></i> Add Category</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table align-middle m-0">
              <thead class="table-light">
                <tr>
                  <th>Category Name</th>
                  <th>Slug</th>
                  <th>Parent Category</th>
                  <th>Products</th>
                  <th>Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="categories-tbody">
                <% if (categories && categories.length > 0) { %>
                  <% categories.forEach(cat => { %>
                    <tr>
                      <td class="fw-bold"><%= cat.name %></td>
                      <td><code><%= cat.slug %></code></td>
                      <td><%= cat.parentCategory || '-' %></td>
                      <td><span class="badge bg-info text-dark"><%= cat.productCount || 0 %> products</span></td>
                      <td>
                        <span class="badge <%= cat.status === 'Active' ? 'bg-success' : 'bg-secondary' %>"><%= cat.status || 'Active' %></span>
                      </td>
                      <td class="text-end">
                        <button class="btn btn-outline btn-xs me-1" onclick="editCategory('<%= cat.categoryId %>', '<%= escape(cat.name) %>', '<%= cat.slug %>', '<%= cat.status %>')"><i class="bi bi-pencil"></i> Edit</button>
                        <button class="btn btn-danger btn-xs" onclick="deleteCategory('<%= cat.categoryId %>')"><i class="bi bi-trash"></i></button>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="6" class="text-center py-4 text-muted">No categories configured yet. Click "Add Category" to create one.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- PAGE: BRANDS -->
      <div id="page-brands" class="page d-none">
        <!-- Stats Cards Row -->
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="stat-card">
              <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-award-fill"></i></div>
              <div class="stat-info">
                <span class="stat-label">Total Brands</span>
                <h3 class="stat-value m-0" id="brand-stat-total"><%= brands ? brands.length : 0 %></h3>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-card">
              <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-patch-check-fill"></i></div>
              <div class="stat-info">
                <span class="stat-label">Active Brands</span>
                <h3 class="stat-value m-0" id="brand-stat-active"><%= brands ? brands.filter(b=>b.status==='Active').length : 0 %></h3>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-card">
              <div class="stat-icon bg-info-subtle text-info"><i class="bi bi-boxes"></i></div>
              <div class="stat-info">
                <span class="stat-label">Products Mapped</span>
                <h3 class="stat-value m-0" id="brand-stat-products"><%= brands ? brands.reduce((s,b)=>s+(b.productCount||0),0) : 0 %></h3>
              </div>
            </div>
          </div>
        </div>

        <div class="dashboard-block mb-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h3 class="m-0 fs-5 fw-bold"><i class="bi bi-shield-check me-2 text-primary"></i>Brand Management</h3>
            <div class="d-flex align-items-center gap-2">
              <div class="input-group input-group-sm" style="max-width: 220px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="search-brands" class="form-control" placeholder="Search brand..." oninput="filterBrands()">
              </div>
              <select id="filter-brand-status" class="form-select form-select-sm" style="width: auto;" onchange="filterBrands()">
                <option value="">All Status</option>
                <option value="Active">Active</option>
                <option value="Disabled">Disabled</option>
              </select>
              <button class="btn btn-accent btn-sm" onclick="showBrandModal()"><i class="bi bi-plus-lg me-1"></i> Add Brand</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table align-middle m-0">
              <thead class="table-light">
                <tr>
                  <th>Brand Name</th>
                  <th>Slug</th>
                  <th>Products</th>
                  <th>Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="brands-tbody">
                <% if (brands && brands.length > 0) { %>
                  <% brands.forEach(b => { %>
                    <tr>
                      <td class="fw-bold"><%= b.name %></td>
                      <td><code><%= b.slug %></code></td>
                      <td><span class="badge bg-info text-dark"><%= b.productCount || 0 %> products</span></td>
                      <td>
                        <span class="badge <%= b.status === 'Active' ? 'bg-success' : 'bg-secondary' %>"><%= b.status || 'Active' %></span>
                      </td>
                      <td class="text-end">
                        <button class="btn btn-outline btn-xs me-1" onclick="editBrand('<%= b.brandId %>', '<%= escape(b.name) %>', '<%= b.slug %>', '<%= b.status %>')"><i class="bi bi-pencil"></i> Edit</button>
                        <button class="btn btn-danger btn-xs" onclick="deleteBrand('<%= b.brandId %>')"><i class="bi bi-trash"></i></button>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-center py-4 text-muted">No brands configured yet. Click "Add Brand" to create one.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- PAGE: PRODUCT REVIEWS MODERATION -->
      <div id="page-reviews" class="page d-none">
        <!-- Stats Cards Row -->
        <div class="row g-3 mb-4">
          <div class="col-md-3">
            <div class="stat-card">
              <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-chat-square-text-fill"></i></div>
              <div class="stat-info">
                <span class="stat-label">Total Reviews</span>
                <h3 class="stat-value m-0" id="review-stat-total"><%= reviews ? reviews.length : 0 %></h3>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <div class="stat-icon bg-warning-subtle text-warning"><i class="bi bi-hourglass-split"></i></div>
              <div class="stat-info">
                <span class="stat-label">Pending</span>
                <h3 class="stat-value m-0" id="review-stat-pending"><%= reviews ? reviews.filter(r=>r.status==='Pending').length : 0 %></h3>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></div>
              <div class="stat-info">
                <span class="stat-label">Approved</span>
                <h3 class="stat-value m-0" id="review-stat-approved"><%= reviews ? reviews.filter(r=>r.status==='Approved').length : 0 %></h3>
              </div>
            </div>
          </div>
          <div class="col-md-3">
            <div class="stat-card">
              <div class="stat-icon bg-info-subtle text-info"><i class="bi bi-star-fill text-warning"></i></div>
              <div class="stat-info">
                <span class="stat-label">Average Rating</span>
                <h3 class="stat-value m-0" id="review-stat-avg"><%= reviews && reviews.length>0 ? (reviews.reduce((s,r)=>s+(r.rating||0),0)/reviews.length).toFixed(1) + ' ★' : '0.0 ★' %></h3>
              </div>
            </div>
          </div>
        </div>

        <div class="dashboard-block mb-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h3 class="m-0 fs-5 fw-bold"><i class="bi bi-star-half me-2 text-warning"></i>Product Reviews Moderation</h3>
            <div class="d-flex align-items-center gap-2">
              <div class="input-group input-group-sm" style="max-width: 220px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="search-reviews" class="form-control" placeholder="Search product/user..." oninput="filterReviews()">
              </div>
              <select id="filter-review-status" class="form-select form-select-sm" style="width: auto;" onchange="filterReviews()">
                <option value="">All Status</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
              </select>
              <button class="btn btn-outline btn-sm" onclick="loadReviews()"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table align-middle m-0">
              <thead class="table-light">
                <tr>
                  <th>Product</th>
                  <th>Customer</th>
                  <th>Rating</th>
                  <th>Review Text</th>
                  <th>Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="reviews-tbody">
                <% if (reviews && reviews.length > 0) { %>
                  <% reviews.forEach(r => { %>
                    <tr>
                      <td class="fw-bold"><%= r.productId %></td>
                      <td><%= r.userName %><br><span class="badge bg-light text-dark" style="font-size:0.7rem;"><%= r.verifiedBuyer ? '✓ Verified Purchase' : 'Guest' %></span></td>
                      <td>
                        <span class="text-warning fw-bold"><%= r.rating %> ★</span>
                      </td>
                      <td style="max-width: 300px;">
                        <strong><%= r.title %></strong>
                        <p class="m-0 text-muted small"><%= r.text %></p>
                      </td>
                      <td>
                        <span class="badge <%= r.status === 'Approved' ? 'bg-success' : (r.status === 'Rejected' ? 'bg-danger' : 'bg-warning text-dark') %>"><%= r.status || 'Pending' %></span>
                      </td>
                      <td class="text-end">
                        <% if (r.status !== 'Approved') { %>
                          <button class="btn btn-success btn-xs me-1" onclick="updateReviewStatus('<%= r._id %>', 'Approved')">Approve</button>
                        <% } %>
                        <% if (r.status !== 'Rejected') { %>
                          <button class="btn btn-warning btn-xs me-1" onclick="updateReviewStatus('<%= r._id %>', 'Rejected')">Reject</button>
                        <% } %>
                        <button class="btn btn-danger btn-xs" onclick="deleteReview('<%= r._id %>')"><i class="bi bi-trash"></i></button>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="6" class="text-center py-4 text-muted">No product reviews submitted yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- PAGE: ADMIN ACTIVITY AUDIT LOG -->
      <div id="page-auditlogs" class="page d-none">
        <!-- Stats Cards Row -->
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <div class="stat-card">
              <div class="stat-icon bg-primary-subtle text-primary"><i class="bi bi-journal-text"></i></div>
              <div class="stat-info">
                <span class="stat-label">Total Audit Logs</span>
                <h3 class="stat-value m-0" id="audit-stat-total"><%= auditLogs ? auditLogs.length : 0 %></h3>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-card">
              <div class="stat-icon bg-success-subtle text-success"><i class="bi bi-clock-history"></i></div>
              <div class="stat-info">
                <span class="stat-label">Recent Activities</span>
                <h3 class="stat-value m-0" id="audit-stat-today"><%= auditLogs ? auditLogs.length : 0 %></h3>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="stat-card">
              <div class="stat-icon bg-info-subtle text-info"><i class="bi bi-person-badge-fill"></i></div>
              <div class="stat-info">
                <span class="stat-label">Active Admin Users</span>
                <h3 class="stat-value m-0" id="audit-stat-admins">1</h3>
              </div>
            </div>
          </div>
        </div>

        <div class="dashboard-block mb-4">
          <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h3 class="m-0 fs-5 fw-bold"><i class="bi bi-shield-lock-fill me-2 text-danger"></i>Admin Activity Audit Log</h3>
            <div class="d-flex align-items-center gap-2">
              <div class="input-group input-group-sm" style="max-width: 220px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" id="search-auditlogs" class="form-control" placeholder="Search activity..." oninput="filterAuditLogs()">
              </div>
              <button class="btn btn-outline btn-sm" onclick="loadAuditLogs()"><i class="bi bi-arrow-clockwise me-1"></i> Refresh Logs</button>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table align-middle m-0" style="font-size: 0.85rem;">
              <thead class="table-light">
                <tr>
                  <th>Timestamp</th>
                  <th>Admin</th>
                  <th>Action</th>
                  <th>Resource</th>
                  <th>Details</th>
                  <th>IP Address</th>
                </tr>
              </thead>
              <tbody id="auditlogs-tbody">
                <% if (auditLogs && auditLogs.length > 0) { %>
                  <% auditLogs.forEach(l => { %>
                    <tr>
                      <td class="text-muted"><%= new Date(l.createdAt || l.timestamp).toLocaleString('en-IN') %></td>
                      <td class="fw-bold"><%= l.adminName %></td>
                      <td><span class="badge bg-secondary"><%= l.action %></span></td>
                      <td><code><%= l.resource %>:<%= l.resourceId || '-' %></code></td>
                      <td><%= l.details %></td>
                      <td class="text-muted font-monospace"><%= l.ipAddress %></td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="6" class="text-center py-4 text-muted">No admin activity logs recorded yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    </div>
  </div><!-- /main-area -->
</div>

<!-- MODAL: USER ACTIVITY DETAILS -->
<div class="modal-overlay" id="activity-modal">
  <div class="modal" style="max-width: 600px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 id="modal-activity-title" class="m-0 fs-5 fw-bold">User Audit Activity Logs</h3>
      <button type="button" class="btn-close" onclick="closeActivityModal()"></button>
    </div>
    <div id="modal-activity-body" style="max-height: 400px; overflow-y: auto;" class="p-2 border rounded bg-light mb-3"></div>
    <div class="text-end">
      <button type="button" class="btn btn-outline btn-sm" onclick="closeActivityModal()">Close</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div id="toast" aria-live="polite" role="alert"></div>

<!-- Bootstrap 5 Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();

  function getStatusColor(status) {
    switch(status) {
      case 'Pending': return { bg: '#fff3cd', text: '#856404' }; // Yellow
      case 'Confirmed': return { bg: '#cce5ff', text: '#004085' }; // Blue
      case 'Processing': return { bg: '#ffe8cc', text: '#d97706' }; // Orange
      case 'Packed': return { bg: '#e2d9f3', text: '#5a32a3' }; // Purple
      case 'Shipped': return { bg: '#e2d9f3', text: '#5a32a3' }; // Purple
      case 'Out For Delivery': return { bg: '#cff4fc', text: '#055160' }; // Cyan
      case 'Delivered': return { bg: '#d1e7dd', text: '#0f5132' }; // Green
      case 'Cancelled': return { bg: '#f8d7da', text: '#842029' }; // Red
      default: return { bg: '#e2e8f0', text: '#475569' };
    }
  }

  async function updateOrderStatus(orderId, selectElement) {
    const newStatus = selectElement.value;
    const prevStatus = selectElement.getAttribute('data-prev');
    let cancelReason = '';

    if (newStatus === 'Cancelled') {
      cancelReason = prompt('Please provide a reason for cancellation:');
      if (cancelReason === null) {
        selectElement.value = prevStatus;
        return;
      }
    }

    try {
      const res = await fetch('/admin/api/order/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, newStatus, cancelReason })
      });
      const data = await res.json();
      if (data.success) {
        showToast('✓ Order status updated to ' + newStatus);
        selectElement.setAttribute('data-prev', newStatus);
        // UI updates handled via socket
      } else {
        showToast('❌ ' + data.message);
        selectElement.value = prevStatus;
      }
    } catch(err) {
      showToast('❌ Error connecting to server');
      selectElement.value = prevStatus;
    }
  }

  // Dynamic Tab Switching
  const pageTitles = {
    'dashboard': 'Overview',
    'orders': 'Bookings & Orders',
    'coupons': 'Discount Coupons',
    'payments': 'Finance & Payment Analytics V2',
    'users': 'User Directory',
    'store': 'Products & Inventory',
    'categories': 'Category Management',
    'brands': 'Brand Management',
    'reviews': 'Product Reviews Moderation',
    'auditlogs': 'Admin Activity Audit Log',
    'otps': 'OTP Monitoring',
    'logins': 'Login Logs',
    'delivery': 'Delivery & Logistics'
  };

  function switchAdminTab(tab) {
    // Hide all pages
    document.querySelectorAll('.page').forEach(p => p.classList.add('d-none'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    
    // Show target page
    const page = document.getElementById('page-' + tab);
    if (page) page.classList.remove('d-none');
    
    // Highlight sidebar link
    const navItem = document.querySelector(`.nav-item[onclick*="${tab}"]`);
    if (navItem) navItem.classList.add('active');
    
    // Title update
    document.getElementById('page-title').textContent = pageTitles[tab] || 'Admin';
    if (tab === 'delivery') loadDeliverySettings();
    if (tab === 'payments') loadFinanceAnalytics();
    if (tab === 'categories') loadCategories();
    if (tab === 'brands') loadBrands();
    if (tab === 'reviews') loadReviews();
    if (tab === 'auditlogs') loadAuditLogs();
  }

  let distanceRules = [];

  async function loadDeliverySettings() {
    try {
      const res = await fetch('/admin/api/delivery-settings');
      const data = await res.json();
      if (data.success && data.settings) {
        document.getElementById('defaultDeliveryFee').value = data.settings.defaultDeliveryFee || 100;
        document.getElementById('minOrderAmount').value = data.settings.minOrderAmount || 0;
        document.getElementById('maxDeliveryDistance').value = data.settings.maxDeliveryDistance || 50;
        if(data.settings.storeLocation) {
          document.getElementById('storeAddress').value = data.settings.storeLocation.address || '';
          document.getElementById('storeLat').value = data.settings.storeLocation.lat || 27.4243;
          document.getElementById('storeLng').value = data.settings.storeLocation.lng || 74.3722;
        }
        distanceRules = data.settings.distanceRules || [];
        renderDistanceRules();
      }
    } catch(e) { console.error(e); }
  }

  function renderDistanceRules() {
    const container = document.getElementById('distanceRulesContainer');
    container.innerHTML = '';
    distanceRules.forEach((rule, idx) => {
      container.innerHTML += `
        <div class="card p-3 mb-3" style="border: 1px solid var(--rule);">
          <div class="row align-items-end">
            <div class="col-md-3">
              <label>Min Distance (KM)</label>
              <input type="number" class="form-control" value="${rule.minKm}" onchange="updateDistanceRule(${idx}, 'minKm', this.value)">
            </div>
            <div class="col-md-3">
              <label>Max Distance (KM)</label>
              <input type="number" class="form-control" value="${rule.maxKm}" onchange="updateDistanceRule(${idx}, 'maxKm', this.value)">
            </div>
            <div class="col-md-4">
              <label>Delivery Fee (₹)</label>
              <input type="number" class="form-control" value="${rule.deliveryFee}" onchange="updateDistanceRule(${idx}, 'deliveryFee', this.value)">
            </div>
            <div class="col-md-2 text-end">
              <button class="btn btn-danger btn-sm w-100" onclick="removeDistanceRule(${idx})">Delete</button>
            </div>
          </div>
        </div>
      `;
    });
  }

  function addDistanceRule() {
    distanceRules.push({ minKm: 0, maxKm: 5, deliveryFee: 30 });
    renderDistanceRules();
  }

  function updateDistanceRule(idx, field, value) {
    distanceRules[idx][field] = parseFloat(value) || 0;
  }

  function removeDistanceRule(idx) {
    distanceRules.splice(idx, 1);
    renderDistanceRules();
  }

  async function saveDeliverySettings() {
    const payload = {
      defaultDeliveryFee: document.getElementById('defaultDeliveryFee').value,
      minOrderAmount: document.getElementById('minOrderAmount').value,
      maxDeliveryDistance: document.getElementById('maxDeliveryDistance').value,
      storeLocation: JSON.stringify({
        address: document.getElementById('storeAddress').value,
        lat: parseFloat(document.getElementById('storeLat').value),
        lng: parseFloat(document.getElementById('storeLng').value)
      }),
      distanceRules: JSON.stringify(distanceRules)
    };
    
    try {
      const res = await fetch('/admin/api/delivery-settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if(data.success) {
        showToast('Delivery settings saved successfully!');
      } else {
        showToast('Failed to save settings: ' + data.message);
      }
    } catch (e) {
      showToast('Error saving settings');
    }
  }

  // Filter Bookings/Orders
  function filterOrders() {
    const status = document.getElementById('filter-order-status').value;
    const query = document.getElementById('search-orders').value.trim().toLowerCase();
    
    document.querySelectorAll('.order-row').forEach(row => {
      const matchStatus = !status || row.dataset.status === status;
      const matchSearch = !query || row.dataset.search.includes(query);
      
      if (matchStatus && matchSearch) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  // Filter Users
  function filterUsers() {
    const role = document.getElementById('filter-user-role').value;
    const query = document.getElementById('search-users').value.trim().toLowerCase();
    
    document.querySelectorAll('.user-row').forEach(row => {
      const matchRole = !role || row.dataset.role === role;
      const matchSearch = !query || row.dataset.search.includes(query);
      
      if (matchRole && matchSearch) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  // Filter OTPs
  function filterOtps() {
    const query = document.getElementById('search-otps').value.trim().toLowerCase();
    document.querySelectorAll('.otp-row').forEach(row => {
      if (!query || row.dataset.search.includes(query)) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  // Filter Logins
  function filterLogins() {
    const query = document.getElementById('search-logins').value.trim().toLowerCase();
    document.querySelectorAll('.login-row').forEach(row => {
      if (!query || row.dataset.search.includes(query)) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  // Activity log display
  function viewUserActivity(name, escapedJson) {
    const logs = JSON.parse(unescape(escapedJson));
    document.getElementById('modal-activity-title').textContent = `${name}'s Activity History`;
    
    const body = document.getElementById('modal-activity-body');
    if (logs.length === 0) {
      body.innerHTML = 'No activities recorded for this user.';
    } else {
      body.innerHTML = logs.reverse().map(l => `
        <div style="border-bottom: 1px solid var(--rule); padding: 6px 0;">
          <strong>[${new Date(l.timestamp).toLocaleString('en-IN')}]</strong> ${l.action}<br>
          <span style="font-size:0.75rem; color:#7F8C8D;">IP: ${l.ip || '127.0.0.1'} | Browser: ${l.userAgent || '—'}</span>
        </div>
      `).join('');
    }
    
    document.getElementById('activity-modal').classList.add('open');
  }

  function closeActivityModal() {
    document.getElementById('activity-modal').classList.remove('open');
  }

  function filterProducts() {
    const query = document.getElementById('search-products').value.trim().toLowerCase();
    document.querySelectorAll('.product-row').forEach(row => {
      row.classList.toggle('d-none', query && !row.dataset.search.includes(query));
    });
  }

  function openBulkImportModal() {
    document.getElementById('import-results').classList.add('d-none');
    document.getElementById('bulkImportForm').reset();
    const modal = new bootstrap.Modal(document.getElementById('bulkImportModal'));
    modal.show();
  }

  document.getElementById('bulkImportForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fileInput = document.getElementById('csvFile');
    if(!fileInput.files[0]) return showToast('Please select a CSV file');
    
    const btn = document.getElementById('btn-import');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Importing...';
    
    const formData = new FormData();
    formData.append('csvFile', fileInput.files[0]);
    const csrf = document.querySelector('input[name="_csrf"]') ? document.querySelector('input[name="_csrf"]').value : '';
    if(csrf) formData.append('_csrf', csrf);
    
    try {
      const res = await fetch('/api/admin/products/bulk-import', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      
      const resDiv = document.getElementById('import-results');
      resDiv.classList.remove('d-none');
      
      if(data.success) {
        document.getElementById('import-summary').innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill"></i> ${data.message}</span>`;
        const errList = document.getElementById('import-errors');
        if(data.errors && data.errors.length > 0) {
          errList.innerHTML = `<li class="text-dark fw-bold mt-2">Partial Errors:</li>` + data.errors.map(err => `<li>${err}</li>`).join('');
        } else {
          errList.innerHTML = '';
        }
        showToast('Import completed!');
        setTimeout(() => location.reload(), 3000);
      } else {
        document.getElementById('import-summary').innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Import Failed: ${data.message}</span>`;
        if(data.errors) {
          document.getElementById('import-errors').innerHTML = data.errors.map(err => `<li>${err}</li>`).join('');
        }
      }
    } catch(err) {
      showToast('Upload error occurred');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-upload"></i> Start Import';
    }
  });

  function exportUsersToCSV() {
    window.open('/admin/export-users', '_blank');
  }

  function exportPayments() {
    window.location.href = '/admin/api/export-payments';
  }

  async function initiateRefund(paymentId) {
    if(!confirm('Are you sure you want to refund this payment?')) return;
    try {
      const res = await fetch('/admin/api/refund', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ paymentId })
      });
      const data = await res.json();
      if(data.success) {
        showToast('Refund processed successfully');
        setTimeout(() => location.reload(), 1500);
      } else {
        alert(data.message || 'Refund failed');
      }
    } catch (e) {
      alert('Error processing refund');
    }
  }

  let toastTimer;
  function showToast(msg) {
    const el = document.getElementById('toast');
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove('show'), 3000);
  }

  window.addEventListener('DOMContentLoaded', () => {
    // Determine active tab
    const hash = window.location.hash.replace('#', '');
    if(hash) switchAdminTab(hash);

    // Initialize Analytics Charts
    initCharts();

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success') === 'status') {
      showToast('✓ Order status updated successfully!');
      switchAdminTab('orders');
    }
    if (urlParams.get('success') === 'deleted') {
      showToast('✓ Order record deleted successfully!');
      switchAdminTab('orders');
    }
    if (urlParams.get('success') === 'product-added') {
      showToast('📦 Product added successfully!');
      switchAdminTab('store');
    }
    if (urlParams.get('success') === 'product-updated') {
      showToast('📦 Product updated successfully!');
      switchAdminTab('store');
    }
    if (urlParams.get('success') === 'product-deleted') {
      showToast('🗑️ Product deleted successfully!');
      switchAdminTab('store');
    }
    
    // Initialize badge colors
    document.querySelectorAll('[id^="badge-status-"]').forEach(badge => {
      badge.style.backgroundColor = getStatusColor(badge.textContent.trim()).bg;
      badge.style.color = getStatusColor(badge.textContent.trim()).text;
    });
  });

  // document.getElementById('status-modal').addEventListener('click', function(e) { if(e.target===this) closeAdminModal(); });
  document.getElementById('activity-modal').addEventListener('click', function(e) { if(e.target===this) closeActivityModal(); });


  socket.on('order_status_updated', (data) => {
    const { orderId, status, paymentStatus } = data;
    
    // Update Recent Bookings badge & select
    const badge1 = document.getElementById('badge-status-' + orderId);
    const select1 = document.getElementById('select-status-' + orderId);
    if (badge1) {
      badge1.textContent = status;
      badge1.style.backgroundColor = getStatusColor(status).bg;
      badge1.style.color = getStatusColor(status).text;
    }
    if (select1) {
      select1.value = status;
      select1.setAttribute('data-prev', status);
    }

    // Update Main Orders List badge & select
    const badge2 = document.getElementById('badge-status-main-' + orderId);
    const select2 = document.getElementById('select-status-main-' + orderId);
    if (badge2) {
      badge2.textContent = status;
      badge2.style.backgroundColor = getStatusColor(status).bg;
      badge2.style.color = getStatusColor(status).text;
    }
    if (select2) {
      select2.value = status;
      select2.setAttribute('data-prev', status);
    }
    
    // Automatically update Payment Status badge if it was updated
    const rows = document.querySelectorAll('.order-row');
    rows.forEach(row => {
      const td = row.querySelector('td:nth-child(5)'); // total amount cell with pay badge
      if (td && row.innerHTML.includes(orderId)) {
         const payBadge = td.querySelector('.badge');
         if (payBadge && paymentStatus) {
            payBadge.textContent = paymentStatus;
            payBadge.className = 'badge ' + (paymentStatus === 'Completed' ? 'badge-confirmed' : 'badge-pending');
         }
      }
    });
  });
  socket.on('admin_notification', (data) => {
    // Play a gentle notification sound
    try {
      const audio = new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3');
      audio.volume = 0.5;
      audio.play();
    } catch(e) {}
    
    showToast(`🔔 ${data.message}`);
    // Optionally auto-refresh data
    if(data.type === 'new_order') {
      setTimeout(() => window.location.reload(), 2000);
    }
  });

  async function toggleStore(checkbox) {
    const isEnabled = checkbox.checked;
    try {
      const res = await fetch('/admin/api/toggle-store', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: isEnabled })
      });
      const data = await res.json();
      if(data.success) {
        showToast('Store is now ' + (isEnabled ? 'ENABLED' : 'DISABLED'));
      } else {
        checkbox.checked = !isEnabled;
        showToast('❌ Failed to toggle store');
      }
    } catch(err) {
      checkbox.checked = !isEnabled;
      showToast('❌ Error connecting to server');
    }
  }

  function initCharts() {
    if (typeof Chart === 'undefined') return;
    const revCtx = document.getElementById('revenueChart');
    const invCtx = document.getElementById('inventoryChart');
    if (!revCtx || !invCtx) return;

    const productsStr = '<%- JSON.stringify(products).replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/"/g, "\\\"") %>';
    let products = [];
    try { products = JSON.parse(productsStr); } catch(e){}

    const categories = {};
    products.forEach(p => {
      const cat = p.category || 'Other';
      categories[cat] = (categories[cat] || 0) + 1;
    });

    new Chart(invCtx, {
      type: 'doughnut',
      data: {
        labels: Object.keys(categories),
        datasets: [{
          data: Object.values(categories),
          backgroundColor: ['#C9602A', '#1C2B2B', '#E8C9A8', '#2D7D4F', '#C0392B', '#B8860B']
        }]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
    });

    new Chart(revCtx, {
      type: 'line',
      data: {
        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
        datasets: [{
          label: 'Monthly Revenue (₹)',
          data: [12000, 19000, 15000, 22000, 18000, <%= stats.totalRevenue || 25000 %>],
          borderColor: '#C9602A',
          backgroundColor: 'rgba(201, 96, 42, 0.1)',
          fill: true,
          tension: 0.4
        }]
      },
      options: { responsive: true, maintainAspectRatio: false }
    });
  }

  // COUPON MANAGEMENT LOGIC
  let editCouponId = null;

  async function loadCoupons() {
    try {
      const res = await fetch('/api/admin/coupons');
      const data = await res.json();
      if (data.success) {
        const tbody = document.getElementById('coupons-tbody');
        if (data.coupons.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No coupons found.</td></tr>';
          return;
        }

        tbody.innerHTML = data.coupons.map(c => `
          <tr>
            <td><strong>${c.code}</strong></td>
            <td>${c.type === 'percentage' ? c.discount + '%' : '₹' + c.discount}</td>
            <td>₹${c.minOrderValue}</td>
            <td>${c.usageLimit ? c.usedCount + '/' + c.usageLimit : c.usedCount + ' (Unlimited)'}</td>
            <td>${new Date(c.expiryDate).toLocaleDateString()}</td>
            <td>
              <span class="badge ${c.status === 'Active' ? 'bg-success' : 'bg-secondary'}">${c.status}</span>
            </td>
            <td>
              <button class="btn btn-sm btn-outline me-1" onclick='editCoupon(${JSON.stringify(c).replace(/'/g, "&#39;")})'><i class="bi bi-pencil"></i></button>
              <button class="btn btn-sm btn-outline text-danger" onclick="deleteCoupon('${c._id}')"><i class="bi bi-trash"></i></button>
            </td>
          </tr>
        `).join('');
      }
    } catch (e) {
      showToast('Error loading coupons');
    }
  }

  function showCouponModal() {
    editCouponId = null;
    document.getElementById('couponForm').reset();
    document.getElementById('couponModalTitle').innerText = 'Create Coupon';
    new bootstrap.Modal(document.getElementById('couponModal')).show();
  }

  function editCoupon(coupon) {
    editCouponId = coupon._id;
    document.getElementById('couponModalTitle').innerText = 'Edit Coupon';
    
    document.getElementById('couponCode').value = coupon.code;
    document.getElementById('couponDescription').value = coupon.description;
    document.getElementById('couponType').value = coupon.type;
    document.getElementById('couponDiscount').value = coupon.discount;
    document.getElementById('couponMinOrder').value = coupon.minOrderValue;
    document.getElementById('couponMaxDiscount').value = coupon.maxDiscount || '';
    document.getElementById('couponExpiry').value = new Date(coupon.expiryDate).toISOString().split('T')[0];
    document.getElementById('couponUsageLimit').value = coupon.usageLimit || '';
    document.getElementById('couponUserLimit').value = coupon.perUserLimit;
    document.getElementById('couponStatus').value = coupon.status;
    
    new bootstrap.Modal(document.getElementById('couponModal')).show();
  }

  async function saveCoupon() {
    const data = {
      code: document.getElementById('couponCode').value,
      description: document.getElementById('couponDescription').value,
      type: document.getElementById('couponType').value,
      discount: Number(document.getElementById('couponDiscount').value),
      minOrderValue: Number(document.getElementById('couponMinOrder').value),
      maxDiscount: document.getElementById('couponMaxDiscount').value ? Number(document.getElementById('couponMaxDiscount').value) : null,
      expiryDate: document.getElementById('couponExpiry').value,
      usageLimit: document.getElementById('couponUsageLimit').value ? Number(document.getElementById('couponUsageLimit').value) : null,
      perUserLimit: Number(document.getElementById('couponUserLimit').value),
      status: document.getElementById('couponStatus').value
    };

    const url = editCouponId ? '/api/admin/coupon/' + editCouponId : '/api/admin/coupon';
    const method = editCouponId ? 'PUT' : 'POST';

    try {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        showToast(result.message);
        bootstrap.Modal.getInstance(document.getElementById('couponModal')).hide();
        loadCoupons();
      } else {
        showToast('❌ ' + result.message);
      }
    } catch (e) {
      showToast('❌ Failed to save coupon');
    }
  }

  async function deleteCoupon(id) {
    if (!confirm('Are you sure you want to delete this coupon?')) return;
    try {
      const res = await fetch('/api/admin/coupon/' + id, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) {
        showToast('Coupon deleted');
        loadCoupons();
      } else {
        showToast('❌ ' + result.message);
      }
    } catch (e) {
      showToast('❌ Failed to delete coupon');
    }
  }

  // Intercept tab switch to load data
  const originalSwitchAdminTab = window.switchAdminTab;
  window.switchAdminTab = function(tabId) {
    originalSwitchAdminTab(tabId);
    if (tabId === 'coupons') loadCoupons();
    if (tabId === 'payments') loadFinanceAnalytics();
  };

  // ── FINANCE & PAYMENT ANALYTICS V2 CLIENT CONTROLLER ───────────
  let financeChartInstance = null;
  let financeDebounceTimer = null;
  let currentFinancePage = 1;

  function debounceFinanceSearch() {
    clearTimeout(financeDebounceTimer);
    financeDebounceTimer = setTimeout(() => {
      currentFinancePage = 1;
      loadFinanceAnalytics();
    }, 350);
  }

  async function loadFinanceAnalytics(targetPage = 1) {
    currentFinancePage = targetPage;
    const range = document.getElementById('fin-filter-range') ? document.getElementById('fin-filter-range').value : '30days';
    const status = document.getElementById('fin-filter-status') ? document.getElementById('fin-filter-status').value : 'all';
    const method = document.getElementById('fin-filter-method') ? document.getElementById('fin-filter-method').value : 'all';
    const search = document.getElementById('fin-search-input') ? document.getElementById('fin-search-input').value.trim() : '';

    try {
      // 1. Fetch Summary & Chart Data
      const summaryRes = await fetch(`/api/admin/finance/summary?range=${range}&status=${status}&method=${method}`);
      const summaryData = await summaryRes.json();

      if (summaryData.success && summaryData.summary) {
        const s = summaryData.summary;
        const fmt = (num) => '₹' + (Number(num) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        if (document.getElementById('fin-today-rev')) document.getElementById('fin-today-rev').textContent = fmt(s.todayRevenue);
        if (document.getElementById('fin-7day-rev')) document.getElementById('fin-7day-rev').textContent = fmt(s.sevenDayRevenue);
        if (document.getElementById('fin-30day-rev')) document.getElementById('fin-30day-rev').textContent = fmt(s.thirtyDayRevenue);
        if (document.getElementById('fin-aov')) document.getElementById('fin-aov').textContent = fmt(s.averageOrderValue);
        if (document.getElementById('fin-success-count')) document.getElementById('fin-success-count').textContent = s.successfulCount;
        
        if (document.getElementById('fin-pending-amount')) document.getElementById('fin-pending-amount').textContent = fmt(s.pendingAmount);
        if (document.getElementById('fin-pending-count')) document.getElementById('fin-pending-count').textContent = `${s.pendingCount} Pending Txns`;
        
        if (document.getElementById('fin-refund-amount')) document.getElementById('fin-refund-amount').textContent = fmt(s.totalRefunds);
        if (document.getElementById('fin-refund-count')) document.getElementById('fin-refund-count').textContent = `${s.refundCount} Refunded Txns`;

        const netProfitEl = document.getElementById('fin-net-profit');
        const profitStatusEl = document.getElementById('fin-profit-status');

        if (netProfitEl) {
          if (s.hasProductCostData && typeof s.netProfit === 'number') {
            netProfitEl.textContent = fmt(s.netProfit);
            netProfitEl.className = s.netProfit >= 0 ? 'fw-bold my-1 text-success' : 'fw-bold my-1 text-danger';
            if (profitStatusEl) {
              profitStatusEl.textContent = `${s.profitMargin !== null ? s.profitMargin.toFixed(1) + '% margin' : ''} (${s.profitStatusText})`;
            }
          } else {
            netProfitEl.textContent = '—';
            netProfitEl.className = 'fw-bold my-1 text-dark';
            if (profitStatusEl) {
              profitStatusEl.textContent = 'Profit unavailable — cost data not configured';
            }
          }
        }

        // Render Chart
        if (summaryData.trend) {
          renderFinanceChart(summaryData.trend);
        }
      }

      // 2. Fetch Paginated Transactions List
      const paymentsRes = await fetch(`/api/admin/finance/payments?page=${currentFinancePage}&limit=15&range=${range}&status=${status}&method=${method}&search=${encodeURIComponent(search)}`);
      const paymentsData = await paymentsRes.json();

      const tbody = document.getElementById('fin-transactions-tbody');
      if (tbody && paymentsData.success) {
        tbody.innerHTML = '';
        const list = paymentsData.payments || [];
        if (list.length === 0) {
          tbody.innerHTML = `<tr><td colspan="7" class="text-center text-muted py-4"><i class="bi bi-inbox fs-3 d-block mb-1"></i> No transactions found matching criteria</td></tr>`;
        } else {
          list.forEach(p => {
            const dateStr = new Date(p.transactionTime).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            let badgeClass = 'bg-secondary';
            if (p.status === 'Paid' || p.status === 'COD Completed') badgeClass = 'bg-success';
            else if (p.status === 'Pending' || p.status === 'COD Pending') badgeClass = 'bg-warning text-dark';
            else if (p.status === 'Failed' || p.status === 'Cancelled') badgeClass = 'bg-danger';
            else if (p.status === 'Refunded') badgeClass = 'bg-info text-dark';

            tbody.innerHTML += `
              <tr>
                <td style="font-size: 0.82rem; color: #555;">${dateStr}</td>
                <td><code class="fw-bold">${p.orderId || 'N/A'}</code></td>
                <td><span class="badge bg-light text-dark border">${p.method}</span></td>
                <td style="font-size: 0.82rem; color: #666;" class="text-truncate" style="max-width: 140px;">${p.razorpayPaymentId || p.paymentId}</td>
                <td><strong style="color: var(--accent);">₹${(Number(p.amount) || 0).toLocaleString('en-IN')}</strong></td>
                <td><span class="badge ${badgeClass} px-2.5 py-1" style="font-size: 0.75rem;">${p.status}</span></td>
                <td class="text-end">
                  <button class="btn btn-outline btn-xs" onclick="openPaymentDetailModal('${p.paymentId}')">
                    <i class="bi bi-eye me-1"></i> Details
                  </button>
                  ${(p.status === 'Paid' || p.status === 'COD Completed') ? `<button class="btn btn-outline-danger btn-xs ms-1" onclick="initiateRefund('${p.paymentId}')">Refund</button>` : ''}
                </td>
              </tr>
            `;
          });
        }

        // Render Pagination Controls
        const pag = paymentsData.pagination;
        const info = document.getElementById('fin-pagination-info');
        const btns = document.getElementById('fin-pagination-btns');
        if (info) info.textContent = `Showing page ${pag.page} of ${pag.totalPages} (${pag.totalCount} total transactions)`;
        if (btns) {
          let btnHtml = '';
          btnHtml += `<button class="btn btn-outline btn-sm" ${pag.page <= 1 ? 'disabled' : ''} onclick="loadFinanceAnalytics(${pag.page - 1})"><i class="bi bi-chevron-left"></i> Prev</button>`;
          btnHtml += `<button class="btn btn-outline btn-sm disabled">${pag.page} / ${pag.totalPages}</button>`;
          btnHtml += `<button class="btn btn-outline btn-sm" ${pag.page >= pag.totalPages ? 'disabled' : ''} onclick="loadFinanceAnalytics(${pag.page + 1})">Next <i class="bi bi-chevron-right"></i></button>`;
          btns.innerHTML = btnHtml;
        }
      }

    } catch (err) {
      console.error('Error loading finance analytics:', err);
      showToast('❌ Error loading finance data');
    }
  }

  function renderFinanceChart(trend) {
    const ctx = document.getElementById('revenueTrendChart');
    if (!ctx) return;

    if (financeChartInstance) {
      financeChartInstance.destroy();
    }

    financeChartInstance = new Chart(ctx, {
      type: 'line',
      data: {
        labels: trend.labels,
        datasets: [{
          label: 'Captured Revenue (₹)',
          data: trend.dataPoints,
          borderColor: '#C9602A',
          backgroundColor: 'rgba(201, 96, 42, 0.1)',
          fill: true,
          tension: 0.35,
          pointRadius: 4,
          pointBackgroundColor: '#C9602A'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (ctx) => ' Revenue: ₹' + ctx.parsed.y.toLocaleString('en-IN')
            }
          }
        },
        scales: {
          x: { grid: { display: false } },
          y: {
            beginAtZero: true,
            ticks: {
              callback: (val) => '₹' + val.toLocaleString('en-IN')
            }
          }
        }
      }
    });
  }

  function exportFinanceCSV() {
    const range = document.getElementById('fin-filter-range') ? document.getElementById('fin-filter-range').value : 'all';
    const status = document.getElementById('fin-filter-status') ? document.getElementById('fin-filter-status').value : 'all';
    const method = document.getElementById('fin-filter-method') ? document.getElementById('fin-filter-method').value : 'all';
    window.open(`/api/admin/finance/export?range=${range}&status=${status}&method=${method}`, '_blank');
  }

  function openPaymentDetailModal(paymentId) {
    if (typeof viewPaymentDetails === 'function') {
      viewPaymentDetails(paymentId);
    } else {
      showToast('Transaction ID: ' + paymentId);
    }
  }
</script>

<!-- Coupon Modal -->
