  // Audit Logs
  async function loadAuditLogs() {
    try {
      const res = await fetch('/api/admin/audit-logs');
      const data = await res.json();
      if (data.success) {
        allAuditLogs = data.logs || [];
        updateAuditStats();
        filterAuditLogs();
      }
    } catch (e) { console.error('Error loading audit logs:', e); }
  }

  function updateAuditStats() {
    const total = allAuditLogs.length;
    const todayStr = new Date().toDateString();
    const today = allAuditLogs.filter(l => new Date(l.createdAt || l.timestamp).toDateString() === todayStr).length;
    const admins = new Set(allAuditLogs.map(l => l.adminName)).size || 1;

    if (document.getElementById('audit-stat-total')) document.getElementById('audit-stat-total').textContent = total;
    if (document.getElementById('audit-stat-today')) document.getElementById('audit-stat-today').textContent = today;
    if (document.getElementById('audit-stat-admins')) document.getElementById('audit-stat-admins').textContent = admins;
  }

  function filterAuditLogs() {
    const query = (document.getElementById('search-auditlogs')?.value || '').trim().toLowerCase();

    const filtered = allAuditLogs.filter(l => {
      if (!query) return true;
      return (l.adminName && l.adminName.toLowerCase().includes(query)) ||
             (l.action && l.action.toLowerCase().includes(query)) ||
             (l.resource && l.resource.toLowerCase().includes(query)) ||
             (l.details && l.details.toLowerCase().includes(query)) ||
             (l.ipAddress && l.ipAddress.toLowerCase().includes(query));
    });

    renderAuditLogsTable(filtered);
  }

  function renderAuditLogsTable(list) {
    const tbody = document.getElementById('auditlogs-tbody');
    if (!tbody) return;
    if (list.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted">No admin activity logs recorded yet.</td></tr>`;
      return;
    }
    tbody.innerHTML = list.map(l => `
      <tr>
        <td class="text-muted">${new Date(l.createdAt || l.timestamp).toLocaleString('en-IN')}</td>
        <td class="fw-bold">${l.adminName}</td>
        <td><span class="badge bg-secondary">${l.action}</span></td>
        <td><code>${l.resource}:${l.resourceId || '-'}</code></td>
        <td>${l.details}</td>
        <td class="text-muted font-monospace">${l.ipAddress}</td>
      </tr>
    `).join('');
  }

