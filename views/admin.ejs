  // Reviews
  async function loadReviews() {
    try {
      const res = await fetch('/api/admin/reviews');
      const data = await res.json();
      if (data.success) {
        allReviews = data.reviews || [];
        updateReviewStats();
        filterReviews();
      }
    } catch (e) { console.error('Error loading reviews:', e); }
  }

  function updateReviewStats() {
    const total = allReviews.length;
    const pending = allReviews.filter(r => r.status === 'Pending').length;
    const approved = allReviews.filter(r => r.status === 'Approved').length;
    const avg = total > 0 ? (allReviews.reduce((sum, r) => sum + Number(r.rating || 0), 0) / total).toFixed(1) : '0.0';

    if (document.getElementById('review-stat-total')) document.getElementById('review-stat-total').textContent = total;
    if (document.getElementById('review-stat-pending')) document.getElementById('review-stat-pending').textContent = pending;
    if (document.getElementById('review-stat-approved')) document.getElementById('review-stat-approved').textContent = approved;
    if (document.getElementById('review-stat-avg')) document.getElementById('review-stat-avg').textContent = `${avg} ★`;
  }

  function filterReviews() {
    const query = (document.getElementById('search-reviews')?.value || '').trim().toLowerCase();
    const status = document.getElementById('filter-review-status')?.value || '';

    const filtered = allReviews.filter(r => {
      const matchQuery = !query || (r.productId && r.productId.toLowerCase().includes(query)) || (r.userName && r.userName.toLowerCase().includes(query)) || (r.text && r.text.toLowerCase().includes(query));
      const matchStatus = !status || r.status === status;
      return matchQuery && matchStatus;
    });

    renderReviewsTable(filtered);
  }

  function renderReviewsTable(list) {
    const tbody = document.getElementById('reviews-tbody');
    if (!tbody) return;
    if (list.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-muted">No product reviews match your criteria.</td></tr>`;
      return;
    }
    tbody.innerHTML = list.map(r => `
      <tr>
        <td class="fw-bold">${r.productId}</td>
        <td>${r.userName}<br><span class="badge bg-light text-dark" style="font-size:0.7rem;">${r.verifiedBuyer ? '✓ Verified Purchase' : 'Guest'}</span></td>
        <td><span class="text-warning fw-bold">${r.rating} ★</span></td>
        <td style="max-width: 300px;"><strong>${r.title || ''}</strong><p class="m-0 text-muted small">${r.text || ''}</p></td>
        <td><span class="badge ${r.status === 'Approved' ? 'bg-success' : (r.status === 'Rejected' ? 'bg-danger' : 'bg-warning text-dark')}">${r.status || 'Pending'}</span></td>
        <td class="text-end">
          ${r.status !== 'Approved' ? `<button class="btn btn-success btn-xs me-1" onclick="updateReviewStatus('${r._id}', 'Approved')">Approve</button>` : ''}
          ${r.status !== 'Rejected' ? `<button class="btn btn-warning btn-xs me-1" onclick="updateReviewStatus('${r._id}', 'Rejected')">Reject</button>` : ''}
          <button class="btn btn-danger btn-xs" onclick="deleteReview('${r._id}')"><i class="bi bi-trash"></i></button>
        </td>
      </tr>
    `).join('');
  }

  async function updateReviewStatus(id, status) {
    try {
      const res = await fetch(`/api/admin/review/${id}/status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status })
