        <div class="modal-dialog modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title">Bulk Import Products via CSV</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
              <div class="alert alert-info py-2">
                <i class="bi bi-info-circle me-1"></i> Ensure your CSV file matches the strict schema format. 
                <a href="/admin/products/csv-template" target="_blank" class="fw-bold text-decoration-underline ms-1">Download Strict CSV Template</a>
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Select CSV File</label>
                <input type="file" id="csvFileInput" class="form-control" accept=".csv">
              </div>
              <div class="mb-3">
                <label class="form-label fw-bold">Or Paste Raw CSV Data</label>
                <textarea id="csvRawText" class="form-control font-monospace" rows="5" placeholder="productId,name,category,brand,price,stock..."></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
              <button type="button" class="btn btn-secondary" onclick="previewBulkImport()">Preview CSV</button>
              <button type="button" class="btn btn-accent" onclick="executeBulkImport()">Start Import</button>
            </div>
          </div>
        </div>
      </div>
    `;
    const old = document.getElementById('csvImportModal');
    if (old) old.remove();
    document.body.insertAdjacentHTML('beforeend', modalHtml);
    const m = new bootstrap.Modal(document.getElementById('csvImportModal'));
    m.show();
  }

  async function getCsvPayload() {
    const fileInput = document.getElementById('csvFileInput');
    const textInput = document.getElementById('csvRawText');
    if (fileInput && fileInput.files && fileInput.files[0]) {
      return await fileInput.files[0].text();
    } else if (textInput && textInput.value.trim()) {
      return textInput.value.trim();
    }
    return '';
  }

  async function previewBulkImport() {
    const csvData = await getCsvPayload();
    if (!csvData) return showToast('❌ Please select a CSV file or paste raw CSV text first.');

    try {
      const res = await fetch('/api/admin/products/preview-csv', {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain' },
        body: csvData
      });
      const data = await res.json();
      if (!data.success) {
        return showToast('❌ ' + (data.message || 'CSV preview failed'));
      }

      let previewHtml = `
        <div class="modal fade" id="csvPreviewModal" tabindex="-1">
          <div class="modal-dialog modal-xl">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title fw-bold">CSV Import Validation & Data Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <div class="row text-center mb-3">
                  <div class="col-4">
                    <div class="p-2 border rounded bg-light">
                      <div class="small text-muted">Total Rows</div>
                      <div class="fs-4 fw-bold">${data.total || 0}</div>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 border rounded bg-success-subtle text-success">
                      <div class="small">Valid Rows</div>
                      <div class="fs-4 fw-bold">${data.validCount || 0}</div>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 border rounded bg-danger-subtle text-danger">
                      <div class="small">Invalid Rows</div>
                      <div class="fs-4 fw-bold">${data.invalidCount || 0}</div>
                    </div>
                  </div>
                </div>
      `;

      if (data.previewSamples && data.previewSamples.length > 0) {
        previewHtml += `
          <h6 class="fw-bold mb-2">Sample Products Preview (${data.previewSamples.length} rows):</h6>
          <div class="table-responsive border rounded mb-3" style="max-height: 250px;">
            <table class="table table-sm table-hover m-0 align-middle" style="font-size:0.8rem;">
              <thead class="table-dark">
                <tr><th>Row</th><th>Product Name</th><th>Category</th><th>Brand</th><th>Price</th><th>Discount</th><th>Stock</th><th>SKU</th><th>Images</th></tr>
              </thead>
              <tbody>
                ${data.previewSamples.map(p => `
                  <tr>
                    <td class="fw-bold">${p.row}</td>
                    <td class="fw-semibold">${p.name}</td>
                    <td>${p.category}</td>
                    <td>${p.brand}</td>
                    <td>₹${p.price}</td>
                    <td>₹${p.discountPrice}</td>
                    <td>${p.stock}</td>
                    <td><code>${p.sku}</code></td>
                    <td><span class="badge bg-info">${p.imageCount} imgs</span></td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        `;
      }

      if (data.errors && data.errors.length > 0) {
        previewHtml += `
          <h6 class="text-danger fw-bold">Validation Errors Detected (${data.errors.length}):</h6>
          <div style="max-height: 180px; overflow-y: auto;" class="border rounded">
            <table class="table table-sm table-striped m-0" style="font-size:0.8rem;">
              <thead><tr><th>Row #</th><th>Error Reason</th></tr></thead>
              <tbody>
                ${data.errors.map(err => `<tr><td class="fw-bold">Row ${err.row}</td><td class="text-danger">${err.error}</td></tr>`).join('')}
              </tbody>
            </table>
          </div>
        `;
      }

      previewHtml += `
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Close Preview</button>
                <button type="button" class="btn btn-accent" onclick="bootstrap.Modal.getInstance(document.getElementById('csvPreviewModal')).hide(); executeBulkImport();">Confirm & Execute Import (${data.validCount} valid)</button>
              </div>
            </div>
          </div>
        </div>
      `;

      const oldPrev = document.getElementById('csvPreviewModal');
      if (oldPrev) oldPrev.remove();
      document.body.insertAdjacentHTML('beforeend', previewHtml);
      const mPrev = new bootstrap.Modal(document.getElementById('csvPreviewModal'));
      mPrev.show();

    } catch (err) {
      showToast('❌ Error generating CSV preview.');
    }
  }

  async function executeBulkImport() {
    const csvData = await getCsvPayload();
    if (!csvData) {
      return showToast('❌ Please select a CSV file or paste raw CSV text.');
    }

    try {
      const res = await fetch('/api/admin/products/bulk-import', {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain' },
        body: csvData
      });
      const data = await res.json();
      const mEl = document.getElementById('csvImportModal');
      if (mEl) bootstrap.Modal.getInstance(mEl).hide();

      // Show Results Modal
      let reportHtml = `
        <div class="modal fade" id="importReportModal" tabindex="-1">
          <div class="modal-dialog modal-lg">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">Bulk Import Summary</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <div class="row text-center mb-3">
                  <div class="col-4">
                    <div class="p-2 border rounded bg-light">
                      <div class="small text-muted">Total Rows</div>
                      <div class="fs-4 fw-bold">${data.total || 0}</div>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 border rounded bg-success-subtle text-success">
                      <div class="small">Successful</div>
                      <div class="fs-4 fw-bold">${data.successCount || 0}</div>
                    </div>
                  </div>
                  <div class="col-4">
                    <div class="p-2 border rounded bg-danger-subtle text-danger">
                      <div class="small">Failed</div>
                      <div class="fs-4 fw-bold">${data.failCount || 0}</div>
                    </div>
                  </div>
                </div>
      `;

      if (data.errors && data.errors.length > 0) {
        reportHtml += `
          <h6 class="text-danger fw-bold">Validation Errors (${data.errors.length}):</h6>
          <div style="max-height: 250px; overflow-y: auto;" class="border rounded">
            <table class="table table-sm table-striped m-0" style="font-size:0.8rem;">
              <thead><tr><th>Row #</th><th>Error Details</th></tr></thead>
              <tbody>
                ${data.errors.map(err => `<tr><td class="fw-bold">Row ${err.row}</td><td class="text-danger">${err.error}</td></tr>`).join('')}
              </tbody>
            </table>
          </div>
        `;
      } else {
        reportHtml += `<div class="alert alert-success py-2">✓ All rows imported successfully with 0 errors!</div>`;
      }

      reportHtml += `
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-accent" onclick="window.location.reload()">Done</button>
              </div>
            </div>
          </div>
        </div>
      `;

      const oldR = document.getElementById('importReportModal');
      if (oldR) oldR.remove();
      document.body.insertAdjacentHTML('beforeend', reportHtml);
      const mR = new bootstrap.Modal(document.getElementById('importReportModal'));
      mR.show();

    } catch (e) {
      showToast('❌ Error executing CSV import.');
    }
  }

  function exportProductsCSV() {
    window.open('/admin/products/export-csv', '_blank');
  }

  // Extend Tab Switch interceptor
  const prevSwitch = window.switchAdminTab;
  window.switchAdminTab = function(tabId) {
    if (prevSwitch) prevSwitch(tabId);
    if (tabId === 'categories') loadCategories();
    if (tabId === 'brands') loadBrands();
    if (tabId === 'reviews') loadReviews();
    if (tabId === 'auditlogs') loadAuditLogs();
  };
</script>
</body>
</html>
