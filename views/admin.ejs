<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Kumawat P&E — Admin Portal</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  
  <!-- Bootstrap 5 & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />
  
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body style="overflow: hidden;">

<div class="admin-layout">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="name">Kumawat P&amp;E</div>
      <div class="sub">Admin Portal</div>
    </div>
    <div class="sidebar-user">
      <div class="greeting">Logged in as</div>
      <div class="uname"><%= adminUser.name %></div>
      <div id="sidebar-role" style="margin-top:6px;">
        <span class="role-badge role-admin">Admin</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section-label">Dashboard</div>
      <div class="nav-item active" onclick="switchAdminTab('dashboard')">
        <i class="bi bi-grid-1x2 me-2"></i> Overview
      </div>
      <div class="nav-section-label">Manage</div>
      <div class="nav-item" onclick="switchAdminTab('coupons')">
        <i class="bi bi-ticket-perforated me-2"></i> Discount Coupons
      </div>
      <div class="nav-item" onclick="switchAdminTab('orders')">
        <i class="bi bi-cart-check me-2"></i> Bookings &amp; Orders
      </div>
      <div class="nav-item" onclick="switchAdminTab('payments')">
        <i class="bi bi-wallet2 me-2"></i> Payments &amp; Refunds
      </div>
      <div class="nav-item" onclick="switchAdminTab('users')">
        <i class="bi bi-people me-2"></i> User Directory
      </div>
      <div class="nav-section-label">Store Management</div>
      <div class="nav-item" onclick="switchAdminTab('store')">
        <i class="bi bi-shop me-2"></i> Products &amp; Inventory
      </div>
      <div class="nav-item" onclick="switchAdminTab('delivery')">
        <i class="bi bi-truck me-2"></i> Delivery &amp; Logistics
      </div>
      <div class="nav-section-label">Security Audit</div>
      <div class="nav-item" onclick="switchAdminTab('otps')">
        <i class="bi bi-shield-lock me-2"></i> OTP Monitoring
      </div>
      <div class="nav-item" onclick="switchAdminTab('logins')">
        <i class="bi bi-journal-text me-2"></i> Login Logs
      </div>
    </nav>
    <div class="sidebar-footer">
      <a href="/auth/logout" class="btn btn-outline btn-full" style="color:rgba(255,255,255,.6); border-color:rgba(255,255,255,.2); font-size:.8rem;">
        <i class="bi bi-box-arrow-left"></i> Logout
      </a>
      <div class="built">built with ❤️ by 21.coders</div>
    </div>
  </aside>

  <!-- MAIN AREA -->
  <div class="main-area" style="height: 100vh;">
    <div class="topbar">
      <h1 id="page-title">Overview</h1>
      <div class="topbar-right">
        <span style="font-size:.85rem; color:var(--ink-light); margin-right: 15px;"><i class="bi bi-shield-fill-check text-success"></i> Connected</span>
        <div class="form-check form-switch" style="display: inline-block; margin-right: 15px;">
          <input class="form-check-input" type="checkbox" id="storeToggleSwitch" <%= storeEnabled ? 'checked' : '' %> onchange="toggleStore(this)">
          <label class="form-check-label" for="storeToggleSwitch" style="font-size: 0.85rem; color: var(--ink);">Store Enabled</label>
        </div>
        <a href="/" class="btn btn-outline" style="font-size:.78rem; padding:7px 14px;"><i class="bi bi-box-arrow-up-right"></i> View Site</a>
      </div>
    </div>

    <!-- PAGE CONTAINER (Scrollable) -->
    <div style="flex: 1; overflow-y: auto; padding-bottom: 50px;">
      
      <!-- PAGE: DASHBOARD -->
      <div id="page-dashboard" class="page active">
        <div class="stats-row">
          <div class="stat-card accent">
            <div class="label">Total Orders / Bookings</div>
            <div class="value"><%= stats.totalOrders %></div>
            <div class="sub">All time bookings</div>
          </div>
          <div class="stat-card green">
            <div class="label">Total Revenue</div>
            <div class="value">₹<%= stats.totalRevenue %></div>
            <div class="sub">Calculated labour fees</div>
          </div>
          <div class="stat-card yellow">
            <div class="label">Pending Deliveries</div>
            <div class="value"><%= stats.pendingDeliveries %></div>
            <div class="sub">Need confirmation</div>
          </div>
          <div class="stat-card">
            <div class="label">Registered Customers</div>
            <div class="value"><%= stats.totalUsers %></div>
            <div class="sub">Active profiles</div>
          </div>
        </div>

        <!-- ANALYTICS CHARTS -->
        <div class="row mt-4">
          <div class="col-lg-8 mb-4">
            <div class="card h-100">
              <div class="card-header">
                <h3>Revenue & Sales Analytics</h3>
              </div>
              <div class="card-body p-4">
                <canvas id="revenueChart" style="max-height: 300px;"></canvas>
              </div>
            </div>
          </div>
          <div class="col-lg-4 mb-4">
            <div class="card h-100">
              <div class="card-header">
                <h3>Inventory Distribution</h3>
              </div>
              <div class="card-body p-4">
                <canvas id="inventoryChart" style="max-height: 300px;"></canvas>
              </div>
            </div>
          </div>
        </div>

        <div class="row mt-2">
          <div class="col-12">
            <div class="card">
              <div class="card-header">
                <h3>Recent Bookings</h3>
                <button class="btn btn-outline btn-xs" onclick="switchAdminTab('orders')">View All</button>
              </div>
              <div class="card-body" style="padding:0;">
                <div class="table-wrap">
                  <table>
                    <thead>
                      <tr>
                        <th>ID</th>
                        <th>Customer</th>
                        <th>Preferred Date</th>
                        <th>Amount</th>
                        <th>Delivery Status</th>
                        <th>Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (orders.length === 0) { %>
                        <tr><td colspan="6" class="text-center py-4">No recent bookings.</td></tr>
                      <% } else { %>
                        <% orders.slice(-5).reverse().forEach(o => { %>
                          <tr>
                            <td><code><%= o.orderId %></code></td>
                            <td><strong><%= o.customerName %></strong><div style="font-size:0.75rem;"><%= o.customerPhone %></div></td>
                            <td><%= new Date(o.preferredDate).toLocaleDateString('en-IN') %><div style="font-size:0.75rem;"><%= o.timeSlot %></div></td>
                            <td><strong>₹<%= o.totalAmount %></strong></td>
                            <td>
                              <span class="badge" id="badge-status-<%= o.orderId %>" style="font-weight:600;"><%= o.deliveryStatus %></span>
                            </td>
                            <td>
                              <select class="btn btn-outline btn-xs" onchange="updateOrderStatus('<%= o.orderId %>', this)" id="select-status-<%= o.orderId %>" data-prev="<%= o.deliveryStatus %>" style="padding: 2px 6px; font-size: 0.75rem;">
                                <% ['Pending', 'Confirmed', 'Processing', 'Packed', 'Out For Delivery', 'Delivered', 'Cancelled'].forEach(st => { %>
                                  <option value="<%= st %>" <%= o.deliveryStatus === st ? 'selected' : '' %>><%= st %></option>
                                <% }) %>
                              </select>
                            </td>
                          </tr>
                        <% }) %>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: ORDERS -->
      <div id="page-orders" class="page d-none">
        <div class="card">
          <div class="card-header">
            <h3>Manage Bookings &amp; Deliveries</h3>
            <div class="filters-right">
              <select id="filter-order-status" class="filter-select" onchange="filterOrders()">
                <option value="">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="In Transit">In Transit</option>
                <option value="Delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>
              </select>
            </div>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <input type="text" id="search-orders" class="search-input" placeholder="Search by customer name, phone, order ID..." onkeyup="filterOrders()" />
            </div>
            
            <div class="table-wrap">
              <table id="orders-table">
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (orders.length === 0) { %>
                    <tr><td colspan="8" class="text-center py-4">No orders found.</td></tr>
                  <% } else { %>
                    <% orders.reverse().forEach(o => { %>
                      <tr class="order-row" data-status="<%= o.deliveryStatus %>" data-search="<%= (o.orderId + ' ' + o.customerName + ' ' + o.customerPhone).toLowerCase() %>">
                        <td><code><%= o.orderId %></code></td>
                        <td>
                          <strong><%= o.customerName %></strong>
                          <div style="font-size:0.75rem; margin-top:2px;">
                            <a href="tel:<%= o.customerPhone %>" style="color:var(--accent);"><i class="bi bi-phone"></i> <%= o.customerPhone %></a>
                          </div>
                        </td>
                        <td>
                          <%= new Date(o.createdAt).toLocaleDateString('en-IN') %>
                        </td>
                        <td>
                          <div style="font-size:0.8rem; max-width: 150px;">
                            <%= o.items.reduce((acc, item) => acc + item.quantity, 0) %> items
                            <br>
                            <span class="text-muted" style="font-size: 0.7rem;"><%= o.items.map(item => item.name).join(', ') %></span>
                          </div>
                        </td>
                        <td>
                          <strong>₹<%= o.totalAmount %></strong>
                        </td>
                        <td>
                          <div style="font-size:0.75rem;"><%= o.paymentMethod %></div>
                          <span class="badge <%= o.paymentStatus === 'Completed' ? 'badge-confirmed' : 'badge-pending' %>" style="font-size:0.65rem; padding:1px 6px;"><%= o.paymentStatus %></span>
                        </td>
                        <td>
                          <span class="badge" id="badge-status-main-<%= o.orderId %>" style="font-weight:600;"><%= o.deliveryStatus %></span>
                        </td>
                        <td>
                          <div class="action-btns" style="display:flex; flex-direction:column; gap: 4px;">
                            <select class="form-select form-select-sm" onchange="updateOrderStatus('<%= o.orderId %>', this)" id="select-status-main-<%= o.orderId %>" data-prev="<%= o.deliveryStatus %>" style="font-size: 0.75rem;">
                              <% ['Pending', 'Confirmed', 'Processing', 'Packed', 'Shipped', 'Out For Delivery', 'Delivered', 'Cancelled'].forEach(st => { %>
                                <option value="<%= st %>" <%= o.deliveryStatus === st ? 'selected' : '' %>><%= st %></option>
                              <% }) %>
                            </select>
                            <div class="d-flex gap-1">
                              <a href="/order/<%= o.orderId %>" target="_blank" class="btn btn-outline btn-xs flex-fill" style="padding: 2px 5px;"><i class="bi bi-eye"></i></a>
                              <a href="/invoice/<%= o.orderId %>" target="_blank" class="btn btn-primary btn-xs flex-fill" style="padding: 2px 5px;"><i class="bi bi-printer"></i></a>
                              <a href="/admin/order/delete/<%= o.orderId %>" onclick="return confirm('Are you sure you want to delete this order?')" class="btn btn-danger btn-xs flex-fill" style="padding: 2px 5px;"><i class="bi bi-trash"></i></a>
                            </div>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: PAYMENTS -->
      <div id="page-payments" class="page d-none">
        <div class="card p-4">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Payment Transactions</h5>
            <button class="btn btn-outline" onclick="exportPayments()"><i class="bi bi-download"></i> Export CSV</button>
          </div>
          
          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Order ID</th>
                  <th>Method</th>
                  <th>Txn ID</th>
                  <th>Amount</th>
                  <th>Status</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% if(payments && payments.length > 0) { %>
                  <% payments.forEach(p => { %>
                    <tr>
                      <td style="font-size:0.85rem; color:#666;"><%= new Date(p.transactionTime).toLocaleString() %></td>
                      <td><%= p.orderId || 'N/A' %></td>
                      <td><span class="badge bg-light text-dark border"><%= p.method %></span></td>
                      <td style="font-size:0.8rem;"><%= p.razorpayPaymentId || p.paymentId %></td>
                      <td class="fw-bold">₹<%= p.amount %></td>
                      <td>
                        <% if(p.status === 'Paid') { %>
                          <span class="badge bg-success bg-opacity-10 text-success border border-success">Paid</span>
                        <% } else if(p.status === 'Pending') { %>
                          <span class="badge bg-warning bg-opacity-10 text-warning border border-warning">Pending</span>
                        <% } else if(p.status === 'Failed' || p.status === 'Cancelled') { %>
                          <span class="badge bg-danger bg-opacity-10 text-danger border border-danger"><%= p.status %></span>
                        <% } else if(p.status === 'Refunded') { %>
                          <span class="badge bg-info bg-opacity-10 text-info border border-info">Refunded</span>
                        <% } else { %>
                          <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary"><%= p.status %></span>
                        <% } %>
                      </td>
                      <td>
                        <% if(p.status === 'Paid') { %>
                          <button class="btn btn-outline-danger btn-xs" onclick="initiateRefund('<%= p.paymentId %>')">Refund</button>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="7" class="text-center text-muted py-4">No transactions found</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- PAGE: USERS -->
      <div id="page-users" class="page d-none">
        <div class="card">
          <div class="card-header">
            <h3>Registered Customers Directory</h3>
            <button class="btn btn-green btn-xs" onclick="exportUsersToCSV()"><i class="bi bi-file-earmark-spreadsheet"></i> Export User Data (CSV)</button>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <div class="filters-left">
                <input type="text" id="search-users" class="search-input" placeholder="Search by name, email, mobile, address..." onkeyup="filterUsers()" />
                <select id="filter-user-role" class="filter-select" onchange="filterUsers()">
                  <option value="">All Roles</option>
                  <option value="user">User</option>
                  <option value="admin">Admin</option>
                </select>
              </div>
            </div>

            <div class="table-wrap">
              <table id="users-table">
                <thead>
                  <tr>
                    <th>Customer Name</th>
                    <th>User ID</th>
                    <th>Email Address</th>
                    <th>Mobile</th>
                    <th>Address</th>
                    <th>Loyalty Card</th>
                    <th>Dates (Joined / Last Login)</th>
                    <th>Activity Log</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                    <tr class="user-row" data-role="<%= u.role %>" data-search="<%= (u.name + ' ' + u.email + ' ' + u.mobile + ' ' + u.address + ' ' + u.userId).toLowerCase() %>">
                      <td>
                        <strong><%= u.name %></strong>
                        <div><span class="badge <%= u.role === 'admin' ? 'badge-admin' : 'badge-user' %>" style="font-size:0.65rem; padding:1px 5px;"><%= u.role %></span></div>
                      </td>
                      <td><code><%= u.userId %></code></td>
                      <td><%= u.email %></td>
                      <td><a href="tel:<%= u.mobile %>" style="color:var(--accent);"><%= u.mobile %></a></td>
                      <td style="max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= u.address %>"><%= u.address || '—' %></td>
                      <td>
                        <span class="badge bg-secondary text-white font-monospace"><%= u.cardNumber || 'None' %></span>
                      </td>
                      <td style="font-size: 0.78rem;">
                        <div>Reg: <%= new Date(u.createdAt).toLocaleDateString('en-IN') %></div>
                        <div class="text-muted">Login: <%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString('en-IN') : 'Never' %></div>
                      </td>
                      <td>
                        <button class="btn btn-outline btn-xs" onclick="viewUserActivity('<%= u.name %>', '<%= escape(JSON.stringify(u.activities)) %>')">Logs (<%= u.activities.length %>)</button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: STORE MANAGEMENT -->
      <div id="page-store" class="page d-none">
        <div class="card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h3>Products &amp; Inventory</h3>
            <div>
              <form action="/admin/store/toggle" method="POST" style="display:inline-block; margin-right: 15px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <% if (storeEnabled) { %>
                  <button type="submit" class="btn btn-outline btn-xs border-success text-success"><i class="bi bi-toggle-on"></i> Store is ON (Disable)</button>
                <% } else { %>
                  <button type="submit" class="btn btn-outline btn-xs border-danger text-danger"><i class="bi bi-toggle-off"></i> Store is OFF (Enable)</button>
                <% } %>
              </form>
              <button class="btn btn-outline btn-xs me-2" onclick="openBulkImportModal()"><i class="bi bi-file-earmark-spreadsheet"></i> Bulk Import (CSV)</button>
              <a href="/admin/products/new" class="btn btn-accent btn-xs"><i class="bi bi-plus-lg"></i> Add New Product</a>
            </div>
          </div>

          <!-- Bulk Import Modal -->
          <div class="modal fade" id="bulkImportModal" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header border-0">
                  <h5 class="modal-title" style="font-family:var(--font-display); font-weight:700;">Bulk Import Products</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                  <p class="text-muted" style="font-size:0.9rem;">Upload a CSV file to create or update multiple products at once. For updating, ensure the <strong class="text-dark">productId</strong> matches exactly.</p>
                  <a href="/admin/products/csv-template" class="btn btn-outline btn-sm mb-4"><i class="bi bi-download"></i> Download Strict CSV Template</a>
                  
                  <div class="border p-4 bg-light rounded" style="border-style:dashed!important;">
                    <form id="bulkImportForm">
                      <input type="file" id="csvFile" name="csvFile" accept=".csv" class="form-control mb-3" required />
                      <button type="submit" class="btn btn-accent w-100" id="btn-import"><i class="bi bi-upload"></i> Start Import</button>
                    </form>
                  </div>
                  
                  <div id="import-results" class="mt-3 text-start d-none p-3 rounded" style="font-size:0.85rem; background: var(--bg);">
                    <div id="import-summary" class="fw-bold mb-2"></div>
                    <ul id="import-errors" class="text-danger ps-3 mb-0"></ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <div class="px-4 py-3" style="background: rgba(0,0,0,0.02); border-bottom: 1px solid var(--rule);">
            <div class="row text-center">
              <% 
                const activeCount = products.filter(p => p.status === 'Active' || !p.status).length;
                const outOfStockCount = products.filter(p => p.status === 'Out Of Stock').length;
                const hiddenCount = products.filter(p => p.status === 'Hidden').length;
              %>
              <div class="col-3">
                <div style="font-size: 1.5rem; font-weight: 700;"><%= products.length %></div>
                <div style="font-size: 0.8rem; color: var(--ink-light);">Total Products</div>
              </div>
              <div class="col-3 border-start">
                <div style="font-size: 1.5rem; font-weight: 700; color: var(--success);"><%= activeCount %></div>
                <div style="font-size: 0.8rem; color: var(--ink-light);">Active</div>
              </div>
              <div class="col-3 border-start">
                <div style="font-size: 1.5rem; font-weight: 700; color: var(--danger);"><%= outOfStockCount %></div>
                <div style="font-size: 0.8rem; color: var(--ink-light);">Out of Stock</div>
              </div>
              <div class="col-3 border-start">
                <div style="font-size: 1.5rem; font-weight: 700; color: var(--ink-light);"><%= hiddenCount %></div>
                <div style="font-size: 0.8rem; color: var(--ink-light);">Hidden/Disabled</div>
              </div>
            </div>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <input type="text" id="search-products" class="search-input" placeholder="Search products by name or SKU..." onkeyup="filterProducts()" />
            </div>
            <div class="table-wrap">
              <table id="products-table">
                <thead>
                  <tr>
                    <th>Image</th>
                    <th>Product Name &amp; SKU</th>
                    <th>Category</th>
                    <th>Pricing</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!products || products.length === 0) { %>
                    <tr>
                      <td colspan="7" class="text-center py-5">
                        <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0.7;">
                          <i class="bi bi-box-seam" style="font-size: 3rem; margin-bottom: 10px;"></i>
                          <h4 style="font-family: var(--font-display); font-weight: 600;">📦 No products added yet</h4>
                          <p style="font-size: 0.95rem;">Click "Add New Product" to create your first product.</p>
                        </div>
                      </td>
                    </tr>
                  <% } else { %>
                    <% products.filter(p => p.status !== 'Deleted').reverse().forEach(p => { %>
                      <tr class="product-row" data-search="<%= (p.name + ' ' + p.sku).toLowerCase() %>">
                        <td>
                          <% if (p.images && p.images.length > 0) { %>
                            <img alt="Image" loading="lazy" decoding="async" src="<%= p.images[0] %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px;" />
                          <% } else { %>
                            <div style="width: 50px; height: 50px; background: #eee; border-radius: 4px; display:flex; align-items:center; justify-content:center;"><i class="bi bi-image text-muted"></i></div>
                          <% } %>
                        </td>
                        <td>
                          <strong><%= p.name %></strong>
                          <div style="font-size:0.75rem; color:var(--ink-light);"><%= p.sku || 'N/A' %></div>
                        </td>
                        <td><span class="badge bg-light text-dark"><%= p.category %></span></td>
                        <td>
                          <% if (p.discountPrice) { %>
                            <span style="text-decoration:line-through; color:#999; font-size:0.8rem;">₹<%= p.price %></span>
                            <strong style="color:var(--accent);">₹<%= p.discountPrice %></strong>
                          <% } else { %>
                            <strong>₹<%= p.price %></strong>
                          <% } %>
                        </td>
                        <td>
                          <div style="font-weight: 600; font-size: 1.1rem;"><%= p.stock %></div>
                          <% if (p.stock <= 5) { %>
                            <span class="badge bg-warning text-dark mt-1" style="font-size:0.7rem;">LOW STOCK</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (p.status === 'Hidden') { %>
                            <span class="badge bg-secondary">Disabled</span>
                          <% } else if (p.stock <= 0 || p.status === 'Out Of Stock') { %>
                            <span class="badge bg-danger">Out of Stock</span>
                          <% } else { %>
                            <span class="badge bg-success"><%= p.status || 'Active' %></span>
                          <% } %>
                        </td>
                        <td>
                          <div class="action-btns">
                            <a href="/admin/products/edit/<%= p.productId %>" class="btn btn-outline btn-xs"><i class="bi bi-pencil"></i> Edit</a>
                            <a href="/admin/products/delete/<%= p.productId %>" onclick="return confirm('Permanently delete this product?')" class="btn btn-danger btn-xs"><i class="bi bi-trash"></i></a>
                          </div>
                        </td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: OTPS -->
      <div id="page-otps" class="page d-none">
        <div class="card">
          <div class="card-header">
            <h3>Forgot Password OTP Logs &amp; Monitoring</h3>
            <span class="badge bg-info text-white">Rate-Limit Active: Max 3/req</span>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <input type="text" id="search-otps" class="search-input" placeholder="Search by mobile number..." onkeyup="filterOtps()" />
            </div>

            <div class="table-wrap">
              <table id="otps-table">
                <thead>
                  <tr>
                    <th>Mobile</th>
                    <th>OTP Code</th>
                    <th>Requested At</th>
                    <th>Expires At</th>
                    <th>Status</th>
                    <th>Attempts</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (otpLogs.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-4">No OTP activities recorded.</td></tr>
                  <% } else { %>
                    <% otpLogs.reverse().forEach(o => { %>
                      <tr class="otp-row" data-search="<%= o.mobile %>">
                        <td><strong><%= o.mobile %></strong></td>
                        <td><code style="font-size:0.9rem; font-weight:bold; color:var(--accent);"><%= o.otp %></code></td>
                        <td><%= new Date(o.createdAt).toLocaleString('en-IN') %></td>
                        <td><%= new Date(o.expiresAt).toLocaleString('en-IN') %></td>
                        <td>
                          <%
                            let badge = 'badge-pending';
                            if (o.status === 'Verified') badge = 'badge-confirmed';
                            if (o.status === 'Expired' || new Date() > o.expiresAt) badge = 'badge-cancelled';
                          %>
                          <span class="badge <%= badge %>"><%= new Date() > o.expiresAt && o.status === 'Pending' ? 'Expired' : o.status %></span>
                        </td>
                        <td><span class="badge bg-dark text-white"><%= o.requestCount %> / 3</span></td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: LOGINS -->
      <div id="page-logins" class="page d-none">
        <div class="card">
          <div class="card-header">
            <h3>Login Security Audit Trial Logs</h3>
            <span class="badge bg-dark text-white">Total Records: <%= loginLogs.length %></span>
          </div>
          <div class="card-body" style="padding:0;">
            <div class="filters-bar px-3 py-2 border-bottom">
              <input type="text" id="search-logins" class="search-input" placeholder="Search by Username/Email/Mobile..." onkeyup="filterLogins()" />
            </div>

            <div class="table-wrap">
              <table id="logins-table">
                <thead>
                  <tr>
                    <th>Username / Identity</th>
                    <th>Timestamp</th>
                    <th>IP Address</th>
                    <th>Status</th>
                    <th>Browser details</th>
                    <th>Reason (if Failed)</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (loginLogs.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-4">No login security records.</td></tr>
                  <% } else { %>
                    <% loginLogs.reverse().forEach(l => { %>
                      <tr class="login-row" data-search="<%= l.emailOrMobile.toLowerCase() %>">
                        <td><strong><%= l.emailOrMobile %></strong></td>
                        <td><%= new Date(l.createdAt).toLocaleString('en-IN') %></td>
                        <td><code><%= l.ipAddress || '127.0.0.1' %></code></td>
                        <td>
                          <span class="badge <%= l.status === 'Success' ? 'badge-confirmed' : 'badge-cancelled' %>"><%= l.status %></span>
                        </td>
                        <td style="font-size:0.75rem; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="<%= l.userAgent %>">
                          <%= l.userAgent %>
                        </td>
                        <td class="text-danger font-weight-bold"><%= l.failureReason || '—' %></td>
                      </tr>
                    <% }) %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- PAGE: COUPONS -->
      <div id="page-coupons" class="page d-none">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2 class="mb-0">Discount Coupons</h2>
          <button class="btn btn-accent" onclick="showCouponModal()"><i class="bi bi-plus-lg"></i> Create Coupon</button>
        </div>
        <div class="card p-0" style="border-radius: var(--radius); border: 1px solid var(--rule);">
          <div class="table-responsive">
            <table class="table align-middle m-0" id="coupons-table">
              <thead class="table-light">
                <tr>
                  <th>Code</th>
                  <th>Type & Discount</th>
                  <th>Min Order</th>
                  <th>Usage Limit</th>
                  <th>Expiry</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="coupons-tbody">
                <tr><td colspan="7" class="text-center py-4">Loading coupons...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- PAGE: DELIVERY & LOGISTICS -->
      <div id="page-delivery" class="page d-none">
        <div class="dashboard-block mb-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="m-0">Delivery Settings & Routing</h3>
            <button class="btn btn-accent" onclick="saveDeliverySettings()">Save Settings</button>
          </div>
          <div class="row">
            <div class="col-md-4">
              <div class="field">
                <label>Default Delivery Fee (₹)</label>
                <input type="number" id="defaultDeliveryFee" class="form-control" value="100">
                <div class="form-text">Fallback fee if distance slab is not matched.</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="field">
                <label>Max Delivery Distance (KM)</label>
                <input type="number" id="maxDeliveryDistance" class="form-control" value="50">
              </div>
            </div>
            <div class="col-md-4">
              <div class="field">
                <label>Minimum Order Amount (₹)</label>
                <input type="number" id="minOrderAmount" class="form-control" value="0">
              </div>
            </div>
          </div>

          <hr class="my-4">
          
          <div class="mb-4">
            <h4 class="m-0 mb-3">Store Location Settings</h4>
            <div class="row">
              <div class="col-12 mb-2">
                <label>Store Address</label>
                <input type="text" id="storeAddress" class="form-control" value="Kumawat P&E, Adda Ball, Kui Ke Pass, Station Road, Govindgarh, Rajasthan">
              </div>
              <div class="col-md-6 mb-2">
                <label>Store Latitude</label>
                <input type="number" step="any" id="storeLat" class="form-control" value="27.4243">
              </div>
              <div class="col-md-6 mb-2">
                <label>Store Longitude</label>
                <input type="number" step="any" id="storeLng" class="form-control" value="74.3722">
              </div>
            </div>
          </div>

          <hr class="my-4">
          
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="m-0">Distance Rules (Slabs)</h4>
            <button class="btn btn-outline btn-sm" onclick="addDistanceRule()">+ Add Distance Slab</button>
          </div>
          
          <div id="distanceRulesContainer">
            <!-- Rules will be rendered here dynamically -->
          </div>
        </div>
      </div>

    </div>
  </div><!-- /main-area -->
</div>

<!-- MODAL: USER ACTIVITY DETAILS -->
<div class="modal-overlay" id="activity-modal">
  <div class="modal" style="max-width: 600px;">
    <h3 id="modal-activity-title">User Audit Activity Logs</h3>
    <div style="max-height: 300px; overflow-y: auto; font-size: 0.82rem; background: var(--bg); padding: 14px; border-radius: var(--radius); font-family: monospace;" id="modal-activity-body">
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline" onclick="closeActivityModal()">Close</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div id="toast"></div>

<!-- Bootstrap 5 Bundle JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();

  function getStatusColor(status) {
    switch(status) {
      case 'Pending': return { bg: '#fff3cd', text: '#856404' }; // Yellow
      case 'Confirmed': return { bg: '#cce5ff', text: '#004085' }; // Blue
      case 'Processing': return { bg: '#ffe8cc', text: '#d97706' }; // Orange
      case 'Packed': return { bg: '#e2d9f3', text: '#5a32a3' }; // Purple
      case 'Shipped': return { bg: '#e2d9f3', text: '#5a32a3' }; // Purple
      case 'Out For Delivery': return { bg: '#cff4fc', text: '#055160' }; // Cyan
      case 'Delivered': return { bg: '#d1e7dd', text: '#0f5132' }; // Green
      case 'Cancelled': return { bg: '#f8d7da', text: '#842029' }; // Red
      default: return { bg: '#e2e8f0', text: '#475569' };
    }
  }

  async function updateOrderStatus(orderId, selectElement) {
    const newStatus = selectElement.value;
    const prevStatus = selectElement.getAttribute('data-prev');
    let cancelReason = '';

    if (newStatus === 'Cancelled') {
      cancelReason = prompt('Please provide a reason for cancellation:');
      if (cancelReason === null) {
        selectElement.value = prevStatus;
        return;
      }
    }

    try {
      const res = await fetch('/admin/api/order/status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, newStatus, cancelReason })
      });
      const data = await res.json();
      if (data.success) {
        showToast('✓ Order status updated to ' + newStatus);
        selectElement.setAttribute('data-prev', newStatus);
        // UI updates handled via socket
      } else {
        showToast('❌ ' + data.message);
        selectElement.value = prevStatus;
      }
    } catch(err) {
      showToast('❌ Error connecting to server');
      selectElement.value = prevStatus;
    }
  }

  // Dynamic Tab Switching
  const pageTitles = {
    'dashboard': 'Overview',
    'orders': 'Bookings & Orders',
    'coupons': 'Discount Coupons',
    'users': 'User Directory',
    'store': 'Products & Inventory',
    'otps': 'OTP Monitoring',
    'logins': 'Login Logs',
    'delivery': 'Delivery & Logistics'
  };

  function switchAdminTab(tab) {
    // Hide all pages
    document.querySelectorAll('.page').forEach(p => p.classList.add('d-none'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    
    // Show target page
    const page = document.getElementById('page-' + tab);
    if (page) page.classList.remove('d-none');
    
    // Highlight sidebar link
    const navItem = document.querySelector(`.nav-item[onclick*="${tab}"]`);
    if (navItem) navItem.classList.add('active');
    
    // Title update
    document.getElementById('page-title').textContent = pageTitles[tab] || 'Admin';
    if (tab === 'delivery') loadDeliverySettings();
  }

  let distanceRules = [];

  async function loadDeliverySettings() {
    try {
      const res = await fetch('/admin/api/delivery-settings');
      const data = await res.json();
      if (data.success && data.settings) {
        document.getElementById('defaultDeliveryFee').value = data.settings.defaultDeliveryFee || 100;
        document.getElementById('minOrderAmount').value = data.settings.minOrderAmount || 0;
        document.getElementById('maxDeliveryDistance').value = data.settings.maxDeliveryDistance || 50;
        if(data.settings.storeLocation) {
          document.getElementById('storeAddress').value = data.settings.storeLocation.address || '';
          document.getElementById('storeLat').value = data.settings.storeLocation.lat || 27.4243;
          document.getElementById('storeLng').value = data.settings.storeLocation.lng || 74.3722;
        }
        distanceRules = data.settings.distanceRules || [];
        renderDistanceRules();
      }
    } catch(e) { console.error(e); }
  }

  function renderDistanceRules() {
    const container = document.getElementById('distanceRulesContainer');
    container.innerHTML = '';
    distanceRules.forEach((rule, idx) => {
      container.innerHTML += `
        <div class="card p-3 mb-3" style="border: 1px solid var(--rule);">
          <div class="row align-items-end">
            <div class="col-md-3">
              <label>Min Distance (KM)</label>
              <input type="number" class="form-control" value="${rule.minKm}" onchange="updateDistanceRule(${idx}, 'minKm', this.value)">
            </div>
            <div class="col-md-3">
              <label>Max Distance (KM)</label>
              <input type="number" class="form-control" value="${rule.maxKm}" onchange="updateDistanceRule(${idx}, 'maxKm', this.value)">
            </div>
            <div class="col-md-4">
              <label>Delivery Fee (₹)</label>
              <input type="number" class="form-control" value="${rule.deliveryFee}" onchange="updateDistanceRule(${idx}, 'deliveryFee', this.value)">
            </div>
            <div class="col-md-2 text-end">
              <button class="btn btn-danger btn-sm w-100" onclick="removeDistanceRule(${idx})">Delete</button>
            </div>
          </div>
        </div>
      `;
    });
  }

  function addDistanceRule() {
    distanceRules.push({ minKm: 0, maxKm: 5, deliveryFee: 30 });
    renderDistanceRules();
  }

  function updateDistanceRule(idx, field, value) {
    distanceRules[idx][field] = parseFloat(value) || 0;
  }

  function removeDistanceRule(idx) {
    distanceRules.splice(idx, 1);
    renderDistanceRules();
  }

  async function saveDeliverySettings() {
    const payload = {
      defaultDeliveryFee: document.getElementById('defaultDeliveryFee').value,
      minOrderAmount: document.getElementById('minOrderAmount').value,
      maxDeliveryDistance: document.getElementById('maxDeliveryDistance').value,
      storeLocation: JSON.stringify({
        address: document.getElementById('storeAddress').value,
        lat: parseFloat(document.getElementById('storeLat').value),
        lng: parseFloat(document.getElementById('storeLng').value)
      }),
      distanceRules: JSON.stringify(distanceRules)
    };
    
    try {
      const res = await fetch('/admin/api/delivery-settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if(data.success) {
        showToast('Delivery settings saved successfully!');
      } else {
        showToast('Failed to save settings: ' + data.message);
      }
    } catch (e) {
      showToast('Error saving settings');
    }
  }

  // Filter Bookings/Orders
  function filterOrders() {
    const status = document.getElementById('filter-order-status').value;
    const query = document.getElementById('search-orders').value.trim().toLowerCase();
    
    document.querySelectorAll('.order-row').forEach(row => {
      const matchStatus = !status || row.dataset.status === status;
      const matchSearch = !query || row.dataset.search.includes(query);
      
      if (matchStatus && matchSearch) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  // Filter Users
  function filterUsers() {
    const role = document.getElementById('filter-user-role').value;
    const query = document.getElementById('search-users').value.trim().toLowerCase();
    
    document.querySelectorAll('.user-row').forEach(row => {
      const matchRole = !role || row.dataset.role === role;
      const matchSearch = !query || row.dataset.search.includes(query);
      
      if (matchRole && matchSearch) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  // Filter OTPs
  function filterOtps() {
    const query = document.getElementById('search-otps').value.trim().toLowerCase();
    document.querySelectorAll('.otp-row').forEach(row => {
      if (!query || row.dataset.search.includes(query)) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  // Filter Logins
  function filterLogins() {
    const query = document.getElementById('search-logins').value.trim().toLowerCase();
    document.querySelectorAll('.login-row').forEach(row => {
      if (!query || row.dataset.search.includes(query)) {
        row.classList.remove('d-none');
      } else {
        row.classList.add('d-none');
      }
    });
  }

  // Activity log display
  function viewUserActivity(name, escapedJson) {
    const logs = JSON.parse(unescape(escapedJson));
    document.getElementById('modal-activity-title').textContent = `${name}'s Activity History`;
    
    const body = document.getElementById('modal-activity-body');
    if (logs.length === 0) {
      body.innerHTML = 'No activities recorded for this user.';
    } else {
      body.innerHTML = logs.reverse().map(l => `
        <div style="border-bottom: 1px solid var(--rule); padding: 6px 0;">
          <strong>[${new Date(l.timestamp).toLocaleString('en-IN')}]</strong> ${l.action}<br>
          <span style="font-size:0.75rem; color:#7F8C8D;">IP: ${l.ip || '127.0.0.1'} | Browser: ${l.userAgent || '—'}</span>
        </div>
      `).join('');
    }
    
    document.getElementById('activity-modal').classList.add('open');
  }

  function closeActivityModal() {
    document.getElementById('activity-modal').classList.remove('open');
  }

  function filterProducts() {
    const query = document.getElementById('search-products').value.trim().toLowerCase();
    document.querySelectorAll('.product-row').forEach(row => {
      row.classList.toggle('d-none', query && !row.dataset.search.includes(query));
    });
  }

  function openBulkImportModal() {
    document.getElementById('import-results').classList.add('d-none');
    document.getElementById('bulkImportForm').reset();
    const modal = new bootstrap.Modal(document.getElementById('bulkImportModal'));
    modal.show();
  }

  document.getElementById('bulkImportForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const fileInput = document.getElementById('csvFile');
    if(!fileInput.files[0]) return showToast('Please select a CSV file');
    
    const btn = document.getElementById('btn-import');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Importing...';
    
    const formData = new FormData();
    formData.append('csvFile', fileInput.files[0]);
    const csrf = document.querySelector('input[name="_csrf"]') ? document.querySelector('input[name="_csrf"]').value : '';
    if(csrf) formData.append('_csrf', csrf);
    
    try {
      const res = await fetch('/api/admin/products/bulk-import', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      
      const resDiv = document.getElementById('import-results');
      resDiv.classList.remove('d-none');
      
      if(data.success) {
        document.getElementById('import-summary').innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill"></i> ${data.message}</span>`;
        const errList = document.getElementById('import-errors');
        if(data.errors && data.errors.length > 0) {
          errList.innerHTML = `<li class="text-dark fw-bold mt-2">Partial Errors:</li>` + data.errors.map(err => `<li>${err}</li>`).join('');
        } else {
          errList.innerHTML = '';
        }
        showToast('Import completed!');
        setTimeout(() => location.reload(), 3000);
      } else {
        document.getElementById('import-summary').innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Import Failed: ${data.message}</span>`;
        if(data.errors) {
          document.getElementById('import-errors').innerHTML = data.errors.map(err => `<li>${err}</li>`).join('');
        }
      }
    } catch(err) {
      showToast('Upload error occurred');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-upload"></i> Start Import';
    }
  });

  function exportUsersToCSV() {
    window.open('/admin/export-users', '_blank');
  }

  function exportPayments() {
    window.location.href = '/admin/api/export-payments';
  }

  async function initiateRefund(paymentId) {
    if(!confirm('Are you sure you want to refund this payment?')) return;
    try {
      const res = await fetch('/admin/api/refund', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ paymentId })
      });
      const data = await res.json();
      if(data.success) {
        showToast('Refund processed successfully');
        setTimeout(() => location.reload(), 1500);
      } else {
        alert(data.message || 'Refund failed');
      }
    } catch (e) {
      alert('Error processing refund');
    }
  }

  let toastTimer;
  function showToast(msg) {
    const el = document.getElementById('toast');
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove('show'), 3000);
  }

  window.addEventListener('DOMContentLoaded', () => {
    // Determine active tab
    const hash = window.location.hash.replace('#', '');
    if(hash) switchAdminTab(hash);

    // Initialize Analytics Charts
    initCharts();

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success') === 'status') {
      showToast('✓ Order status updated successfully!');
      switchAdminTab('orders');
    }
    if (urlParams.get('success') === 'deleted') {
      showToast('✓ Order record deleted successfully!');
      switchAdminTab('orders');
    }
    if (urlParams.get('success') === 'product-added') {
      showToast('📦 Product added successfully!');
      switchAdminTab('store');
    }
    if (urlParams.get('success') === 'product-updated') {
      showToast('📦 Product updated successfully!');
      switchAdminTab('store');
    }
    if (urlParams.get('success') === 'product-deleted') {
      showToast('🗑️ Product deleted successfully!');
      switchAdminTab('store');
    }
    
    // Initialize badge colors
    document.querySelectorAll('[id^="badge-status-"]').forEach(badge => {
      badge.style.backgroundColor = getStatusColor(badge.textContent.trim()).bg;
      badge.style.color = getStatusColor(badge.textContent.trim()).text;
    });
  });

  // document.getElementById('status-modal').addEventListener('click', function(e) { if(e.target===this) closeAdminModal(); });
  document.getElementById('activity-modal').addEventListener('click', function(e) { if(e.target===this) closeActivityModal(); });


  socket.on('order_status_updated', (data) => {
    const { orderId, status, paymentStatus } = data;
    
    // Update Recent Bookings badge & select
    const badge1 = document.getElementById('badge-status-' + orderId);
    const select1 = document.getElementById('select-status-' + orderId);
    if (badge1) {
      badge1.textContent = status;
      badge1.style.backgroundColor = getStatusColor(status).bg;
      badge1.style.color = getStatusColor(status).text;
    }
    if (select1) {
      select1.value = status;
      select1.setAttribute('data-prev', status);
    }

    // Update Main Orders List badge & select
    const badge2 = document.getElementById('badge-status-main-' + orderId);
    const select2 = document.getElementById('select-status-main-' + orderId);
    if (badge2) {
      badge2.textContent = status;
      badge2.style.backgroundColor = getStatusColor(status).bg;
      badge2.style.color = getStatusColor(status).text;
    }
    if (select2) {
      select2.value = status;
      select2.setAttribute('data-prev', status);
    }
    
    // Automatically update Payment Status badge if it was updated
    const rows = document.querySelectorAll('.order-row');
    rows.forEach(row => {
      const td = row.querySelector('td:nth-child(5)'); // total amount cell with pay badge
      if (td && row.innerHTML.includes(orderId)) {
         const payBadge = td.querySelector('.badge');
         if (payBadge && paymentStatus) {
            payBadge.textContent = paymentStatus;
            payBadge.className = 'badge ' + (paymentStatus === 'Completed' ? 'badge-confirmed' : 'badge-pending');
         }
      }
    });
  });
  socket.on('admin_notification', (data) => {
    // Play a gentle notification sound
    try {
      const audio = new Audio('https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3');
      audio.volume = 0.5;
      audio.play();
    } catch(e) {}
    
    showToast(`🔔 ${data.message}`);
    // Optionally auto-refresh data
    if(data.type === 'new_order') {
      setTimeout(() => window.location.reload(), 2000);
    }
  });

  async function toggleStore(checkbox) {
    const isEnabled = checkbox.checked;
    try {
      const res = await fetch('/admin/api/toggle-store', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ enabled: isEnabled })
      });
      const data = await res.json();
      if(data.success) {
        showToast('Store is now ' + (isEnabled ? 'ENABLED' : 'DISABLED'));
      } else {
        checkbox.checked = !isEnabled;
        showToast('❌ Failed to toggle store');
      }
    } catch(err) {
      checkbox.checked = !isEnabled;
      showToast('❌ Error connecting to server');
    }
  }

  function initCharts() {
    if (typeof Chart === 'undefined') return;
    const revCtx = document.getElementById('revenueChart');
    const invCtx = document.getElementById('inventoryChart');
    if (!revCtx || !invCtx) return;

    const productsStr = '<%- JSON.stringify(products).replace(/\\/g, "\\\\").replace(/'/g, "\\'").replace(/"/g, "\\\"") %>';
    let products = [];
    try { products = JSON.parse(productsStr); } catch(e){}

    const categories = {};
    products.forEach(p => {
      const cat = p.category || 'Other';
      categories[cat] = (categories[cat] || 0) + 1;
    });

    new Chart(invCtx, {
      type: 'doughnut',
      data: {
        labels: Object.keys(categories),
        datasets: [{
          data: Object.values(categories),
          backgroundColor: ['#C9602A', '#1C2B2B', '#E8C9A8', '#2D7D4F', '#C0392B', '#B8860B']
        }]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
    });

    new Chart(revCtx, {
      type: 'line',
      data: {
        labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
        datasets: [{
          label: 'Monthly Revenue (₹)',
          data: [12000, 19000, 15000, 22000, 18000, <%= stats.totalRevenue || 25000 %>],
          borderColor: '#C9602A',
          backgroundColor: 'rgba(201, 96, 42, 0.1)',
          fill: true,
          tension: 0.4
        }]
      },
      options: { responsive: true, maintainAspectRatio: false }
    });
  }

  // COUPON MANAGEMENT LOGIC
  let editCouponId = null;

  async function loadCoupons() {
    try {
      const res = await fetch('/api/admin/coupons');
      const data = await res.json();
      if (data.success) {
        const tbody = document.getElementById('coupons-tbody');
        if (data.coupons.length === 0) {
          tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No coupons found.</td></tr>';
          return;
        }

        tbody.innerHTML = data.coupons.map(c => `
          <tr>
            <td><strong>${c.code}</strong></td>
            <td>${c.type === 'percentage' ? c.discount + '%' : '₹' + c.discount}</td>
            <td>₹${c.minOrderValue}</td>
            <td>${c.usageLimit ? c.usedCount + '/' + c.usageLimit : c.usedCount + ' (Unlimited)'}</td>
            <td>${new Date(c.expiryDate).toLocaleDateString()}</td>
            <td>
              <span class="badge ${c.status === 'Active' ? 'bg-success' : 'bg-secondary'}">${c.status}</span>
            </td>
            <td>
              <button class="btn btn-sm btn-outline me-1" onclick='editCoupon(${JSON.stringify(c).replace(/'/g, "&#39;")})'><i class="bi bi-pencil"></i></button>
              <button class="btn btn-sm btn-outline text-danger" onclick="deleteCoupon('${c._id}')"><i class="bi bi-trash"></i></button>
            </td>
          </tr>
        `).join('');
      }
    } catch (e) {
      showToast('Error loading coupons');
    }
  }

  function showCouponModal() {
    editCouponId = null;
    document.getElementById('couponForm').reset();
    document.getElementById('couponModalTitle').innerText = 'Create Coupon';
    new bootstrap.Modal(document.getElementById('couponModal')).show();
  }

  function editCoupon(coupon) {
    editCouponId = coupon._id;
    document.getElementById('couponModalTitle').innerText = 'Edit Coupon';
    
    document.getElementById('couponCode').value = coupon.code;
    document.getElementById('couponDescription').value = coupon.description;
    document.getElementById('couponType').value = coupon.type;
    document.getElementById('couponDiscount').value = coupon.discount;
    document.getElementById('couponMinOrder').value = coupon.minOrderValue;
    document.getElementById('couponMaxDiscount').value = coupon.maxDiscount || '';
    document.getElementById('couponExpiry').value = new Date(coupon.expiryDate).toISOString().split('T')[0];
    document.getElementById('couponUsageLimit').value = coupon.usageLimit || '';
    document.getElementById('couponUserLimit').value = coupon.perUserLimit;
    document.getElementById('couponStatus').value = coupon.status;
    
    new bootstrap.Modal(document.getElementById('couponModal')).show();
  }

  async function saveCoupon() {
    const data = {
      code: document.getElementById('couponCode').value,
      description: document.getElementById('couponDescription').value,
      type: document.getElementById('couponType').value,
      discount: Number(document.getElementById('couponDiscount').value),
      minOrderValue: Number(document.getElementById('couponMinOrder').value),
      maxDiscount: document.getElementById('couponMaxDiscount').value ? Number(document.getElementById('couponMaxDiscount').value) : null,
      expiryDate: document.getElementById('couponExpiry').value,
      usageLimit: document.getElementById('couponUsageLimit').value ? Number(document.getElementById('couponUsageLimit').value) : null,
      perUserLimit: Number(document.getElementById('couponUserLimit').value),
      status: document.getElementById('couponStatus').value
    };

    const url = editCouponId ? '/api/admin/coupon/' + editCouponId : '/api/admin/coupon';
    const method = editCouponId ? 'PUT' : 'POST';

    try {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        showToast(result.message);
        bootstrap.Modal.getInstance(document.getElementById('couponModal')).hide();
        loadCoupons();
      } else {
        showToast('❌ ' + result.message);
      }
    } catch (e) {
      showToast('❌ Failed to save coupon');
    }
  }

  async function deleteCoupon(id) {
    if (!confirm('Are you sure you want to delete this coupon?')) return;
    try {
      const res = await fetch('/api/admin/coupon/' + id, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) {
        showToast('Coupon deleted');
        loadCoupons();
      } else {
        showToast('❌ ' + result.message);
      }
    } catch (e) {
      showToast('❌ Failed to delete coupon');
    }
  }

  // Intercept tab switch to load data
  const originalSwitchAdminTab = window.switchAdminTab;
  window.switchAdminTab = function(tabId) {
    originalSwitchAdminTab(tabId);
    if (tabId === 'coupons') loadCoupons();
  };
</script>

<!-- Coupon Modal -->
<div class="modal fade" id="couponModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content border-0" style="border-radius: var(--radius); overflow: hidden;">
      <div class="modal-header bg-light">
        <h5 class="modal-title" id="couponModalTitle">Create Coupon</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <form id="couponForm">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Coupon Code</label>
              <input type="text" class="form-control" id="couponCode" required style="text-transform: uppercase;">
            </div>
            <div class="col-md-6">
              <label class="form-label">Type</label>
              <select class="form-select" id="couponType">
                <option value="percentage">Percentage (%)</option>
                <option value="fixed">Fixed Amount (₹)</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label">Description</label>
              <input type="text" class="form-control" id="couponDescription">
            </div>
            <div class="col-md-6">
              <label class="form-label">Discount Value</label>
              <input type="number" class="form-control" id="couponDiscount" required min="1">
            </div>
            <div class="col-md-6">
              <label class="form-label">Max Discount (₹)</label>
              <input type="number" class="form-control" id="couponMaxDiscount" placeholder="Optional">
            </div>
            <div class="col-md-6">
              <label class="form-label">Min Order Value (₹)</label>
              <input type="number" class="form-control" id="couponMinOrder" required value="0" min="0">
            </div>
            <div class="col-md-6">
              <label class="form-label">Expiry Date</label>
              <input type="date" class="form-control" id="couponExpiry" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Total Usage Limit</label>
              <input type="number" class="form-control" id="couponUsageLimit" placeholder="Unlimited">
            </div>
            <div class="col-md-4">
              <label class="form-label">Per User Limit</label>
              <input type="number" class="form-control" id="couponUserLimit" required value="1" min="1">
            </div>
            <div class="col-md-4">
              <label class="form-label">Status</label>
              <select class="form-select" id="couponStatus">
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer border-0 p-4 pt-0">
        <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-accent" onclick="saveCoupon()">Save Coupon</button>
      </div>
    </div>
  </div>
</div>
</body>
</html>
