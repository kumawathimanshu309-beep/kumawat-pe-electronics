  function updateBrandStats() {
    const total = allBrands.length;
    const active = allBrands.filter(b => b.status === 'Active').length;
    const totalProducts = allBrands.reduce((acc, b) => acc + (b.productCount || 0), 0);

    if (document.getElementById('brand-stat-total')) document.getElementById('brand-stat-total').textContent = total;
    if (document.getElementById('brand-stat-active')) document.getElementById('brand-stat-active').textContent = active;
    if (document.getElementById('brand-stat-products')) document.getElementById('brand-stat-products').textContent = totalProducts;
  }

