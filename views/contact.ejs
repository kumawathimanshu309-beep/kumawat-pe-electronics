<script>
  (function() {
    function updateOpenStatus() {
      var badge = document.getElementById('open-status-badge');
      var textEl = document.getElementById('status-text');
      if (!badge || !textEl) return;

      var now = new Date();
      var day = now.getDay(); // 0 = Sunday, 1 = Mon, ..., 6 = Sat
      var hour = now.getHours();
      var min = now.getMinutes();
      var currentMinutes = hour * 60 + min;

      var isOpen = false;

      if (day >= 1 && day <= 6) {
        // Mon-Sat: 8:00 AM (480 mins) to 9:00 PM (1260 mins)
        if (currentMinutes >= 480 && currentMinutes < 1260) {
          isOpen = true;
        }
      } else if (day === 0) {
        // Sun: 9:00 AM (540 mins) to 6:00 PM (1080 mins)
        if (currentMinutes >= 540 && currentMinutes < 1080) {
          isOpen = true;
        }
      }

      if (isOpen) {
        badge.className = 'status-badge open';
        textEl.textContent = 'Open Now';
      } else {
        badge.className = 'status-badge closed';
        textEl.textContent = 'Closed';
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateOpenStatus);
    } else {
      updateOpenStatus();
    }
  })();
</script>

