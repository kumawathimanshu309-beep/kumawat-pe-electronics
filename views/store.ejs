<%- include('partials/header') %>
<link rel="stylesheet" href="/css/premium-ui.css" />
<section class="hero-section" style="padding-top: 100px; padding-bottom: 50px; background: var(--bg-dark); color: var(--white); position: relative; overflow: hidden;">
  <div class="container text-center position-relative" style="z-index: 2;">
    <h1 style="font-family: var(--font-display); font-size: 3rem; margin-bottom: 10px; font-weight:700;">Premium Electronics Store</h1>
    <p style="color: rgba(255,255,255,0.8); font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Discover the finest selection of authentic electrical accessories, tools, and smart appliances.</p>
  </div>
  <div class="blueprint-dark-bg" style="position:absolute; top:0; left:0; right:0; bottom:0; z-index: 1;"></div>
</section>

<style>
  .top-search-bar {
    position: sticky;
    top: 70px;
    z-index: 99;
    background: var(--bg);
    padding: 15px 0;
    margin-bottom: 20px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .store-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 15px;
  }
  .accordion-button:not(.collapsed) {
    background-color: var(--accent-light);
    color: var(--accent);
    box-shadow: none;
  }
  .accordion-button:focus {
    box-shadow: none;
    border-color: rgba(0,0,0,.125);
  }
  .custom-cat-btn {
    border-radius: 20px;
    padding: 6px 16px;
    font-weight: 600;
  }
  .custom-cat-btn.active {
    background-color: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }
  
  .grid-5-mode {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 1200px) {
    .grid-5-mode { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 991px) {
    .grid-5-mode { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 767px) {
    .grid-5-mode { grid-template-columns: repeat(2, 1fr); }
  }

  .list-mode-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .premium-card-list {
    flex-direction: row;
  }
  .premium-card-list .premium-card-img {
    width: 280px;
    height: 100%;
    margin-bottom: 0;
    margin-right: 20px;
  }
  .premium-card-list .premium-card-body {
    justify-content: center;
  }
  @media (max-width: 991px) {
    .premium-card-list {
      flex-direction: column;
    }
    .premium-card-list .premium-card-img {
      width: 100%;
      height: 240px;
      margin-right: 0;
      margin-bottom: 16px;
    }
  }
</style>

<section class="py-5" style="background: var(--bg);">
  <div class="store-container">
    
    <!-- STICKY SEARCH & CATEGORY TOP BAR -->
    <div class="top-search-bar">
      <!-- Search -->
      <div class="modern-card p-3 mb-3 d-flex align-items-center gap-3">
        <div class="input-group flex-grow-1">
          <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" id="store-search" class="form-control border-start-0 ps-0" placeholder="Search by Product Name, SKU, Category, Description..." aria-label="Search Products" style="font-size: 1rem; padding: 12px;" />
        </div>
        <button class="btn btn-outline" style="white-space: nowrap; padding: 12px 24px;" onclick="resetFilters()"><i class="bi bi-x-circle me-1"></i> Clear Filters</button>
      </div>
      
      <!-- Category Accordion -->
      <div class="accordion" id="categoryAccordion">
        <div class="accordion-item modern-card" style="border:none; border-radius:12px; overflow:hidden;">
          <h2 class="accordion-header" id="headingFilters">
            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFilters" aria-expanded="false" aria-controls="collapseFilters" style="font-weight: 600; padding: 15px 20px;">
              <i class="bi bi-funnel me-2"></i> Categories & Filters
            </button>
          </h2>
          <div id="collapseFilters" class="accordion-collapse collapse" aria-labelledby="headingFilters" data-bs-parent="#categoryAccordion">
            <div class="accordion-body" style="background: #fff;">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <h6 class="text-muted text-uppercase" style="font-size: 0.8rem; font-weight: 700; letter-spacing: 1px;">Categories</h6>
                  <div class="d-flex flex-wrap gap-2 mt-2">
                    <label class="btn btn-sm btn-outline-secondary custom-cat-btn active">
                      <input type="radio" name="catFilter" value="" class="cat-filter d-none" checked> All Categories
                    </label>
                    <label class="btn btn-sm btn-outline-secondary custom-cat-btn">
                      <input type="radio" name="catFilter" value="AC & Appliances" class="cat-filter d-none"> AC & Appliances
                    </label>
                    <label class="btn btn-sm btn-outline-secondary custom-cat-btn">
                      <input type="radio" name="catFilter" value="Electrical" class="cat-filter d-none"> Electrical
                    </label>
                    <label class="btn btn-sm btn-outline-secondary custom-cat-btn">
                      <input type="radio" name="catFilter" value="Plumbing" class="cat-filter d-none"> Plumbing
                    </label>
                    <label class="btn btn-sm btn-outline-secondary custom-cat-btn">
                      <input type="radio" name="catFilter" value="Motors & Pumps" class="cat-filter d-none"> Motors & Pumps
                    </label>
                    <label class="btn btn-sm btn-outline-secondary custom-cat-btn">
                      <input type="radio" name="catFilter" value="Tools" class="cat-filter d-none"> Tools
                    </label>
                    <label class="btn btn-sm btn-outline-secondary custom-cat-btn">
                      <input type="radio" name="catFilter" value="Spare Parts" class="cat-filter d-none"> Spare Parts
                    </label>
                  </div>
                </div>
                
                <div class="col-md-3 mb-3">
                   <h6 class="text-muted text-uppercase" style="font-size: 0.8rem; font-weight: 700; letter-spacing: 1px;">Brand</h6>
                   <div class="d-flex flex-column gap-1 mt-2">
                     <label class="custom-checkbox"><input type="checkbox" value="Havells" class="brand-filter"> Havells</label>
                     <label class="custom-checkbox"><input type="checkbox" value="Anchor" class="brand-filter"> Anchor</label>
                     <label class="custom-checkbox"><input type="checkbox" value="Polycab" class="brand-filter"> Polycab</label>
                     <label class="custom-checkbox"><input type="checkbox" value="Crompton" class="brand-filter"> Crompton</label>
                     <label class="custom-checkbox"><input type="checkbox" value="Legrand" class="brand-filter"> Legrand</label>
                   </div>
                </div>
                
                <div class="col-md-3 mb-3">
                   <h6 class="text-muted text-uppercase" style="font-size: 0.8rem; font-weight: 700; letter-spacing: 1px;">Price & Stock</h6>
                   <div class="d-flex gap-2 align-items-center mt-2 mb-3">
                     <input type="number" id="minPrice" class="form-control form-control-sm" placeholder="Min ₹" aria-label="Minimum Price" />
                     <span class="text-muted" aria-hidden="true">-</span>
                     <input type="number" id="maxPrice" class="form-control form-control-sm" placeholder="Max ₹" aria-label="Maximum Price" />
                   </div>
                   <label class="custom-checkbox"><input type="checkbox" value="In Stock" id="inStockFilter"> In Stock Only</label>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- RIGHT MAIN CONTENT -->
    <main class="store-main w-100">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 p-3 modern-card bg-white" style="border-radius: 12px;">
        <div id="results-count" style="font-size: 0.95rem; font-weight:700; color: var(--ink);">Loading...</div>
        <div class="d-flex gap-3 align-items-center">
          <div class="btn-group" role="group" aria-label="View Mode">
            <button type="button" class="btn btn-outline btn-sm active" id="view-grid" onclick="setViewMode('grid')" aria-label="Grid View"><i class="bi bi-grid-fill" aria-hidden="true"></i></button>
            <button type="button" class="btn btn-outline btn-sm" id="view-list" onclick="setViewMode('list')" aria-label="List View"><i class="bi bi-list-task" aria-hidden="true"></i></button>
          </div>
          <select id="sort-select" class="form-select form-select-sm" aria-label="Sort Products" style="width: auto; cursor:pointer; border-radius: 8px; font-weight: 600; color: var(--ink-light);">
            <option value="newest">Newest First</option>
            <option value="price_asc">Price: Low to High</option>
            <option value="price_desc">Price: High to Low</option>
            <option value="rating_desc">Highest Rated</option>
          </select>
        </div>
      </div>

      <div class="grid-5-mode" id="store-products-grid">
        <!-- Dynamic Products -->
      </div>

      <div class="text-center mt-5" id="load-more-container" style="display: none;">
        <button class="btn btn-outline px-5 py-2 fw-bold" id="load-more-btn" style="border-radius:20px;">Load More Products</button>
      </div>
      
      <div id="no-results" class="premium-empty d-none">
        <i class="bi bi-search"></i>
        <h3>No products found</h3>
        <p>Try adjusting your search or filter criteria to find what you're looking for.</p>
        <button class="btn btn-accent px-4" onclick="resetFilters()">Clear All Filters</button>
      </div>
    </main>

  </div>
</section>

<!-- Socket.io for Real-time Updates -->
<script src="/socket.io/socket.io.js"></script>

<script>
  let currentPage = 1;
  const limit = 12;
  let isLoading = false;
  let hasMore = true;
  let userWishlist = [];
  let currentView = 'grid';
  let compareList = JSON.parse(localStorage.getItem('compareList') || '[]');

  function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => { clearTimeout(timeout); func(...args); };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  function setViewMode(mode) {
    currentView = mode;
    document.getElementById('view-grid').classList.toggle('active', mode === 'grid');
    document.getElementById('view-grid').classList.toggle('btn-accent', mode === 'grid');
    document.getElementById('view-list').classList.toggle('active', mode === 'list');
    document.getElementById('view-list').classList.toggle('btn-accent', mode === 'list');
    loadProducts(false, true); 
  }

  async function fetchUserWishlist() {
    try {
      const res = await fetch('/api/wishlist');
      const data = await res.json();
      if (data.success && data.wishlist) {
        userWishlist = data.wishlist.map(w => w.productId);
      }
    } catch(e) {}
  }

  function toggleCompare(productId, event) {
    event.stopPropagation();
    let idx = compareList.indexOf(productId);
    if(idx > -1) {
      compareList.splice(idx, 1);
      showToast('Removed from compare');
    } else {
      if(compareList.length >= 4) {
        showToast('You can only compare up to 4 items.');
        return;
      }
      compareList.push(productId);
      showToast('Added to compare');
    }
    localStorage.setItem('compareList', JSON.stringify(compareList));
    loadProducts(false, true);
  }

  function generateSkeleton() {
    let html = '';
    const count = currentView === 'grid' ? 10 : 4;
    for(let i=0; i<count; i++) {
      if (currentView === 'grid') {
        html += `
          <div class="skeleton-card">
            <div class="premium-skeleton w-100 h-50 mb-3"></div>
            <div class="premium-skeleton w-75 mb-2" style="height:20px;"></div>
            <div class="premium-skeleton w-100 mb-3" style="height:14px;"></div>
            <div class="premium-skeleton w-50 mb-4" style="height:24px;"></div>
            <div class="mt-auto d-flex gap-2">
              <div class="premium-skeleton flex-grow-1" style="height:44px; border-radius:50px;"></div>
              <div class="premium-skeleton flex-grow-1" style="height:44px; border-radius:50px;"></div>
            </div>
          </div>
        `;
      } else {
        html += `
          <div class="skeleton-card" style="flex-direction: row;">
            <div class="premium-skeleton w-25 h-100 me-4"></div>
            <div class="d-flex flex-column flex-grow-1 py-3">
              <div class="premium-skeleton w-50 mb-2" style="height:24px;"></div>
              <div class="premium-skeleton w-75 mb-4" style="height:16px;"></div>
              <div class="premium-skeleton w-25 mb-4" style="height:28px;"></div>
              <div class="mt-auto d-flex gap-3">
                <div class="premium-skeleton" style="width:140px; height:44px; border-radius:50px;"></div>
                <div class="premium-skeleton" style="width:140px; height:44px; border-radius:50px;"></div>
              </div>
            </div>
          </div>
        `;
      }
    }
    return html;
  }

  let cachedProducts = [];

  async function loadProducts(append = false, fromCache = false) {
    if (isLoading && !fromCache) return;
    isLoading = true;

    const grid = document.getElementById('store-products-grid');
    if (currentView === 'grid') {
      grid.classList.add('grid-5-mode');
      grid.classList.remove('list-mode-container');
    } else {
      grid.classList.remove('grid-5-mode');
      grid.classList.add('list-mode-container');
    }
    
    if (!append && !fromCache) {
      grid.innerHTML = generateSkeleton();
    }

    const search = document.getElementById('store-search').value;
    
    if (!fromCache) {
      const checkedCategory = document.querySelector('.cat-filter:checked');
      const categories = checkedCategory && checkedCategory.value ? [checkedCategory.value] : [];
      const brands = Array.from(document.querySelectorAll('.brand-filter:checked')).map(cb => cb.value);
      const minPrice = document.getElementById('minPrice').value;
      const maxPrice = document.getElementById('maxPrice').value;
      const sort = document.getElementById('sort-select').value;
      const inStock = document.getElementById('inStockFilter').checked;

      if (!append) currentPage = 1;

      const params = new URLSearchParams({
        page: currentPage,
        limit,
        q: search, // Changed to q to correctly trigger backend name/category/brand search
        categories: categories.join(','),
        brands: brands.join(','),
        minPrice,
        maxPrice,
        sort,
        inStock: inStock ? 'true' : 'false'
      });

      try {
        const res = await fetch('/api/store/products?' + params.toString());
        const data = await res.json();

        if (data.success) {
          document.getElementById('results-count').innerText = `Showing ${data.products.length} of ${data.pagination.total} products`;

          if (data.pagination.total === 0) {
            document.getElementById('no-results').classList.remove('d-none');
            document.getElementById('load-more-container').style.display = 'none';
            grid.innerHTML = '';
            cachedProducts = [];
            isLoading = false;
            return;
          } else {
            document.getElementById('no-results').classList.add('d-none');
            hasMore = currentPage < data.pagination.pages;
            document.getElementById('load-more-container').style.display = hasMore ? 'block' : 'none';
            
            if (append) {
              cachedProducts = cachedProducts.concat(data.products);
            } else {
              cachedProducts = data.products;
            }
          }
        }
      } catch(e) {
        console.error(e);
        document.getElementById('results-count').innerText = 'Error loading products.';
        grid.innerHTML = '';
        isLoading = false;
        return;
      }
    }

    // Client-side filtering on loaded products (for SKU, Description, etc.)
    let filteredProducts = cachedProducts;
    if (search.trim()) {
      const lowerQ = search.toLowerCase();
      filteredProducts = cachedProducts.filter(p => {
        const matchesName = (p.name || '').toLowerCase().includes(lowerQ);
        const matchesCategory = (p.category || '').toLowerCase().includes(lowerQ);
        const matchesBrand = (p.brand || '').toLowerCase().includes(lowerQ);
        const matchesSKU = (p.sku || '').toLowerCase().includes(lowerQ);
        const matchesDesc = (p.description || '').toLowerCase().includes(lowerQ);
        return matchesName || matchesCategory || matchesBrand || matchesSKU || matchesDesc;
      });
      // Fallback: if search filtered out everything locally, show appropriate count
      if (!fromCache && search.trim() && filteredProducts.length < cachedProducts.length) {
         document.getElementById('results-count').innerText = `Showing ${filteredProducts.length} local matches`;
      }
    }

    const html = filteredProducts.map(p => {
      const isWishlisted = userWishlist.includes(p.productId);
      const isCompared = compareList.includes(p.productId);
      const heartClass = isWishlisted ? 'bi-heart-fill text-accent' : 'bi-heart';
      const compareClass = isCompared ? 'bi-bar-chart-fill text-accent' : 'bi-bar-chart';
      
      const escapedName = p.name.replace(/'/g, "\\'").replace(/"/g, '&quot;');
      const imgSrc = p.images && p.images.length > 0 ? p.images[0] : '';
      const sku = p.sku || '';
      const cat = p.category || '';
      const discountPrice = p.discountPrice || p.price;

      let badgeHtml = '';
      if (p.stock <= 0 || p.status === 'Out Of Stock') badgeHtml += `<span class="premium-badge badge-oos">Out of Stock</span>`;
      else if (p.stock <= 5) badgeHtml += `<span class="premium-badge badge-stock">Only ${p.stock} left</span>`;
      
      if (p.discountPrice && p.price > p.discountPrice) {
        badgeHtml += `<span class="premium-badge badge-sale">Sale</span>`;
      }
      
      if(p.badges && p.badges.length) {
         p.badges.forEach(b => {
           badgeHtml += `<span class="premium-badge badge-new">${b}</span>`;
         });
      }

      let priceHtml = '';
      if (p.discountPrice && p.discountPrice < p.price) {
        const pct = Math.round(((p.price - p.discountPrice)/p.price)*100);
        priceHtml = `
          <span class="premium-price-current">₹${p.discountPrice}</span>
          <span class="premium-price-old">₹${p.price}</span>
          <span class="premium-discount-percent">${pct}% OFF</span>
        `;
      } else {
        priceHtml = `<span class="premium-price-current">₹${p.price}</span>`;
      }

      const ratingNum = p.ratings && p.ratings.average ? p.ratings.average : 4.5;
      const ratingCount = p.ratings && p.ratings.count ? p.ratings.count : 0;
      let stars = '';
      for(let i=1; i<=5; i++){
         stars += `<i class="bi ${i <= ratingNum ? 'bi-star-fill' : 'bi-star'}" style="color: #F39C12;"></i>`;
      }

      let buttonsHtml = '';
      if (p.stock > 0 && p.status !== 'Out Of Stock') {
        buttonsHtml = `
          <button class="btn btn-accent flex-grow-1" onclick="event.stopPropagation(); buyNowDirect({name: '${escapedName}', price: ${discountPrice}, originalPrice: ${p.price}, image: '${imgSrc}', sku: '${sku}', category: '${cat}', type: 'product'})"><i class="bi bi-cart-check"></i> Buy Now</button>
          <button class="btn btn-outline flex-grow-1" onclick="event.stopPropagation(); addToCart('${escapedName}', ${discountPrice}, ${p.price}, '${imgSrc}', '${sku}', '${cat}')">Add to Cart</button>
        `;
      } else {
        buttonsHtml = `<button class="btn btn-secondary disabled w-100" disabled>Sold Out</button>`;
      }

      const cardClass = currentView === 'grid' ? 'premium-card' : 'premium-card premium-card-list';

      return `
        <div class="${cardClass}" onclick="window.location.href='/product/${p.productId}'" style="cursor: pointer;">
          
          <div class="premium-card-img">
             <div class="premium-badges">${badgeHtml}</div>
             <div class="premium-wishlist-btn" title="Wishlist" onclick="event.stopPropagation(); toggleStoreWishlist('${p.productId}', this)"><i class="bi ${heartClass}"></i></div>
             ${imgSrc ? `<img src="${imgSrc}" loading="lazy" decoding="async" alt="${escapedName}" />` : `<i class="bi bi-image text-muted" style="font-size: 3rem;"></i>`}
          </div>
          
          <div class="d-flex flex-column flex-grow-1">
            <h3 class="premium-card-title">${p.name}</h3>
            <p class="premium-card-desc">
              ${p.description ? (p.description.length > 50 ? p.description.substring(0, 50) + '...' : p.description) : 'Premium quality product.'}
            </p>
            <div style="font-size: 0.8rem; margin-bottom: 12px; display: flex; align-items: center; gap: 4px;">${stars} <span class="text-muted ms-1">(${ratingCount})</span></div>
            
            <div class="premium-price-row mt-auto">${priceHtml}</div>
            <div class="d-flex gap-2 w-100">${buttonsHtml}</div>
          </div>

        </div>
      `;
    }).join('');

    grid.innerHTML = html;
    isLoading = false;
  }

  async function toggleStoreWishlist(productId, btn) {
    try {
      const res = await fetch('/api/wishlist/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ productId })
      });
      const data = await res.json();
      if (data.success) {
        const icon = btn.querySelector('i');
        if (data.action === 'added') {
          icon.classList.remove('bi-heart');
          icon.classList.add('bi-heart-fill', 'text-accent');
          showToast('Added to wishlist');
          userWishlist.push(productId);
        } else {
          icon.classList.remove('bi-heart-fill', 'text-accent');
          icon.classList.add('bi-heart');
          showToast('Removed from wishlist');
          userWishlist = userWishlist.filter(id => id !== productId);
        }
        const badge = document.getElementById('wishlist-badge');
        if (badge) {
          badge.innerText = data.count;
          badge.style.display = data.count > 0 ? 'block' : 'none';
        }
      } else {
        if (data.message === 'Unauthorized' || data.message.includes('Session expired')) {
           window.location.href = '/login';
        } else {
           showToast('Failed to update wishlist');
        }
      }
    } catch(e) {
      showToast('Error updating wishlist');
    }
  }

  function resetFilters() {
    document.getElementById('store-search').value = '';
    document.getElementById('minPrice').value = '';
    document.getElementById('maxPrice').value = '';
    document.getElementById('inStockFilter').checked = false;
    document.querySelectorAll('.cat-filter').forEach(cb => {
       if(cb.value === '') cb.checked = true;
       else cb.checked = false;
    });
    document.querySelectorAll('.custom-cat-btn').forEach(btn => {
       if(btn.querySelector('input').value === '') btn.classList.add('active');
       else btn.classList.remove('active');
    });
    document.querySelectorAll('.brand-filter').forEach(cb => cb.checked = false);
    document.getElementById('sort-select').value = 'newest';
    loadProducts();
  }

  // Event Listeners
  document.getElementById('store-search').addEventListener('input', debounce(() => {
    // We pass fromCache=true first to do immediate local filtering
    loadProducts(false, true);
    // Then fetch from server
    loadProducts(false, false);
  }, 300));
  
  document.querySelectorAll('.cat-filter').forEach(cb => {
    cb.addEventListener('change', (e) => {
      document.querySelectorAll('.custom-cat-btn').forEach(btn => btn.classList.remove('active'));
      e.target.closest('.custom-cat-btn').classList.add('active');
      loadProducts();
    });
  });

  document.querySelectorAll('.brand-filter, #inStockFilter').forEach(cb => {
    cb.addEventListener('change', () => loadProducts());
  });
  document.getElementById('sort-select').addEventListener('change', () => loadProducts());
  document.getElementById('minPrice').addEventListener('change', debounce(() => loadProducts(), 500));
  document.getElementById('maxPrice').addEventListener('change', debounce(() => loadProducts(), 500));

  document.getElementById('load-more-btn').addEventListener('click', () => {
    currentPage++;
    loadProducts(true);
  });

  // Init
  document.addEventListener('DOMContentLoaded', async () => {
    await fetchUserWishlist();
    loadProducts();
  });

  const socket = io();
  socket.on('product_updated', (data) => {
    showToast('Store inventory updated! Refreshing...');
    setTimeout(() => {
      loadProducts(false);
    }, 2000);
  });
</script>

<%- include('partials/footer') %>
