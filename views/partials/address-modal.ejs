<!-- Address Management Modal -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: 12px; border: none;">
      <div class="modal-header" style="border-bottom: 1px solid var(--rule);">
        <h5 class="modal-title" id="addressModalLabel" style="font-family: var(--font-display); font-weight: 700;">Add New Address</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" style="padding: 24px;">
        <button type="button" class="btn btn-outline-primary w-100 mb-4" onclick="getCurrentLocationModal()" style="font-weight: 600; padding: 10px;">
          <i class="bi bi-geo-alt-fill"></i> Use Current Location
        </button>
        
        <input type="hidden" id="modalAddrLat" value="">
        <input type="hidden" id="modalAddrLng" value="">

        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">Full Name *</label>
            <input type="text" id="modalAddrName" class="form-control" placeholder="e.g. Rahul Kumar">
          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">Mobile Number *</label>
            <input type="tel" id="modalAddrMobile" class="form-control" placeholder="10-digit number">
          </div>
          <div class="col-12">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">House / Flat No. *</label>
            <input type="text" id="modalAddrHouse" class="form-control" placeholder="e.g. 104, A Wing">
          </div>
          <div class="col-12">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">Street / Area *</label>
            <input type="text" id="modalAddrStreet" class="form-control" placeholder="e.g. Main Market Road">
          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">Landmark (Optional)</label>
            <input type="text" id="modalAddrLandmark" class="form-control" placeholder="e.g. Near Shiv Temple">
          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">Pincode *</label>
            <input type="text" id="modalAddrPincode" class="form-control" placeholder="e.g. 303603">
          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">City *</label>
            <input type="text" id="modalAddrCity" class="form-control" placeholder="City">
          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-size: 0.85rem; font-weight: 600;">State *</label>
            <input type="text" id="modalAddrState" class="form-control" placeholder="State">
          </div>
        </div>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--rule);">
        <button type="button" class="btn btn-outline" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-accent" id="modalSaveAddrBtn" onclick="saveAddressFromModal()">Save Address</button>
      </div>
    </div>
  </div>
</div>

<script>
  function showAddressModal() {
    window.editAddressIndex = null;
    document.getElementById('modalAddrName').value = '';
    document.getElementById('modalAddrMobile').value = '';
    document.getElementById('modalAddrHouse').value = '';
    document.getElementById('modalAddrStreet').value = '';
    document.getElementById('modalAddrLandmark').value = '';
    document.getElementById('modalAddrPincode').value = '';
    document.getElementById('modalAddrCity').value = '';
    document.getElementById('modalAddrState').value = '';
    document.getElementById('modalAddrLat').value = '';
    document.getElementById('modalAddrLng').value = '';
    document.getElementById('addressModalLabel').innerText = 'Add New Address';

    const modal = new bootstrap.Modal(document.getElementById('addressModal'));
    modal.show();
  }

  async function getCurrentLocationModal() {
    if (!navigator.geolocation) {
      alert("Geolocation is not supported by your browser");
      return;
    }
    
    const btn = document.querySelector('button[onclick="getCurrentLocationModal()"]');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Locating...';
    btn.disabled = true;

    navigator.geolocation.getCurrentPosition(async (position) => {
      const lat = position.coords.latitude;
      const lng = position.coords.longitude;
      
      document.getElementById('modalAddrLat').value = lat;
      document.getElementById('modalAddrLng').value = lng;

      try {
        const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`);
        const data = await response.json();
        
        if(data && data.address) {
          const addr = data.address;
          document.getElementById('modalAddrCity').value = addr.city || addr.town || addr.village || addr.county || '';
          document.getElementById('modalAddrState').value = addr.state || '';
          document.getElementById('modalAddrPincode').value = addr.postcode || '';
          
          let street = [];
          if(addr.road) street.push(addr.road);
          if(addr.suburb) street.push(addr.suburb);
          if(addr.neighbourhood) street.push(addr.neighbourhood);
          document.getElementById('modalAddrStreet').value = street.join(', ');
        }
      } catch (err) {
        console.error("Reverse geocoding failed", err);
      } finally {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }
    }, (error) => {
      console.error(error);
      alert("Unable to retrieve your location.");
      btn.innerHTML = originalText;
      btn.disabled = false;
    });
  }

  async function saveAddressFromModal() {
    const btn = document.getElementById('modalSaveAddrBtn');
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';
    btn.disabled = true;

    const addressData = {
      fullName: document.getElementById('modalAddrName').value.trim(),
      mobile: document.getElementById('modalAddrMobile').value.trim(),
      house: document.getElementById('modalAddrHouse').value.trim(),
      street: document.getElementById('modalAddrStreet').value.trim(),
      landmark: document.getElementById('modalAddrLandmark').value.trim(),
      pincode: document.getElementById('modalAddrPincode').value.trim(),
      city: document.getElementById('modalAddrCity').value.trim(),
      state: document.getElementById('modalAddrState').value.trim(),
      lat: document.getElementById('modalAddrLat').value ? Number(document.getElementById('modalAddrLat').value) : undefined,
      lng: document.getElementById('modalAddrLng').value ? Number(document.getElementById('modalAddrLng').value) : undefined
    };

    if(!addressData.fullName || !addressData.mobile || !addressData.house || !addressData.street || !addressData.pincode || !addressData.city || !addressData.state) {
      alert("Please fill all required fields.");
      btn.innerHTML = 'Save Address';
      btn.disabled = false;
      return;
    }

    try {
      const isEdit = window.editAddressIndex !== undefined && window.editAddressIndex !== null;
      const endpoint = isEdit ? `/api/user/address/${window.editAddressIndex}` : '/api/user/address';
      
      const response = await fetch(endpoint, {
        method: isEdit ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(addressData)
      });
      const data = await response.json();
      
      if (data.success) {
        // Close modal
        bootstrap.Modal.getInstance(document.getElementById('addressModal')).hide();
        // Refresh page to show new address
        window.location.reload();
      } else {
        alert(data.message || 'Failed to save address');
      }
    } catch (err) {
      console.error(err);
      alert('Network error while saving address');
    } finally {
      btn.innerHTML = 'Save Address';
      btn.disabled = false;
    }
  }
</script>
