<!-- Cart Drawer Overlay -->
<div class="cart-drawer-overlay" id="cartDrawerOverlay" onclick="toggleCartDrawer()"></div>

<!-- Cart Drawer Panel -->
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-drawer-header">
    <h4 class="m-0">Your Cart</h4>
    <button class="btn-close" onclick="toggleCartDrawer()"></button>
  </div>
  
  <div class="cart-drawer-body" id="cart-drawer-body">
    <!-- Items render here -->
  </div>
  
  <div class="cart-drawer-footer">
    <div class="d-flex justify-content-between mb-2">
      <span class="text-muted">Items Total</span>
      <strong id="drawer-items-total">₹0</strong>
    </div>
    <div class="d-flex justify-content-between mb-2">
      <span class="text-muted">Delivery Charges</span>
      <strong class="text-success" style="font-size: 0.85rem;">Calculated at checkout</strong>
    </div>
    <hr>
    <div class="d-flex justify-content-between mb-3" style="font-size: 1.2rem;">
      <strong>Grand Total</strong>
      <strong id="drawer-grand-total">₹0</strong>
    </div>
    
    <div class="d-flex gap-2">
      <button class="btn btn-outline w-50" onclick="toggleCartDrawer()">Continue</button>
      <button class="btn btn-accent w-50" onclick="window.location.href='/checkout'">Checkout</button>
    </div>
  </div>
</div>

<style>

  /* Cart Drawer */
  .cart-drawer-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5);
    z-index: 1050;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s;
  }
  .cart-drawer-overlay.show {
    opacity: 1;
    visibility: visible;
  }
  
  .cart-drawer {
    position: fixed;
    top: 0; right: -400px;
    width: 400px;
    height: 100vh;
    background: var(--bg);
    z-index: 1051;
    box-shadow: -5px 0 25px rgba(0,0,0,0.1);
    transition: right 0.3s ease;
    display: flex;
    flex-direction: column;
    max-width: 100vw;
  }
  .cart-drawer.open {
    right: 0;
  }
  
  .cart-drawer-header {
    padding: 20px;
    border-bottom: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }
  
  .cart-drawer-footer {
    padding: 20px;
    border-top: 1px solid var(--rule);
    background: var(--white);
  }

  .drawer-item {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }
  .drawer-item img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
  }
  .drawer-item-details { flex: 1; }
  .drawer-item-title { font-weight: bold; margin-bottom: 5px; font-size: 1rem; }
  .drawer-item-price { color: var(--accent); font-weight: bold; }
  .drawer-qty-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }
  .drawer-qty-btn {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: var(--white);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
</style>

<script>
  let cart = [];
  const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;

  function getCurrentCartQuantity() {
    if (!Array.isArray(cart)) return 0;
    // Count products for ecommerce navbar badge (exclude services)
    return cart
      .filter(item => item.type === 'product' || item.productId || (item.id && item.type !== 'service'))
      .reduce((sum, item) => sum + (parseInt(item.quantity) || 1), 0);
  }

  // Global window helpers for synchronized state
  window.getKumawatCart = function() {
    return Array.isArray(cart) ? cart : [];
  };

  window.setKumawatCart = function(newCart) {
    if (Array.isArray(newCart)) {
      cart = newCart;
      saveCart();
    }
  };

  function updateCartIndicators(totalItems) {
    const count = typeof totalItems === 'number' ? totalItems : getCurrentCartQuantity();
    const displayCount = count > 99 ? '99+' : String(count);

    const badges = document.querySelectorAll('#cart-badge-count, #mobile-bottom-cart-count, .cart-count-badge, [data-cart-count]');
    badges.forEach(badge => {
      badge.textContent = displayCount;
      if (count > 0) {
        badge.style.display = 'inline-flex';
        badge.removeAttribute('hidden');
        if (typeof window.animateBadgeBump === 'function' && badge.id) {
          window.animateBadgeBump(badge.id);
        }
      } else {
        badge.style.display = 'none';
        badge.setAttribute('hidden', 'true');
      }
      const parentBtn = badge.closest('button, a, .mobile-bottom-nav-item');
      if (parentBtn) {
        parentBtn.setAttribute('aria-label', count > 0 ? `Shopping cart, ${count} item${count !== 1 ? 's' : ''}` : 'Shopping cart');
      }
    });
  }

  function openCartDrawer() {
    const drawer = document.getElementById('cartDrawer');
    const overlay = document.getElementById('cartDrawerOverlay');
    if (drawer && overlay) {
      drawer.classList.add('open');
      overlay.classList.add('show');
    }
  }

  function toggleCartDrawer() {
    const drawer = document.getElementById('cartDrawer');
    const overlay = document.getElementById('cartDrawerOverlay');
    if (drawer && overlay) {
      const isOpen = drawer.classList.contains('open');
      if (isOpen) {
        drawer.classList.remove('open');
        overlay.classList.remove('show');
      } else {
        openCartDrawer();
      }
    }
  }

  async function loadCart() {
    if (isLoggedIn) {
      const localCartStr = localStorage.getItem('kumawat_cart');
      if (localCartStr) {
        try {
          const localCart = JSON.parse(localCartStr);
          if (localCart.length > 0) {
            await fetch('/api/cart/sync', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ cart: localCart })
            });
            localStorage.removeItem('kumawat_cart');
          }
        } catch(e){}
      }
      
      try {
        if (!window._cartFetchPromise) {
          window._cartFetchPromise = fetch('/api/cart').then(r => r.json());
        }
        const data = await window._cartFetchPromise;
        if (data && data.success) cart = data.cart;
      } catch (e) {
        window._cartFetchPromise = null;
        console.error(e);
      }
    } else {
      const saved = localStorage.getItem('kumawat_cart');
      if (saved) {
        try { cart = JSON.parse(saved); } catch (e) { cart = []; }
      }
    }
    updateCartUI();
  }

  async function saveCart() {
    window._cartFetchPromise = null;
    if (isLoggedIn) {
      try {
        await fetch('/api/cart/overwrite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cart })
        });
      } catch (e) { console.error(e); }
    } else {
      localStorage.setItem('kumawat_cart', JSON.stringify(cart));
    }
    updateCartUI();
  }

  window.addEventListener('DOMContentLoaded', loadCart);
  window.addEventListener('pageshow', loadCart);
  window.addEventListener('storage', function(e) {
    if (e.key === 'kumawat_cart') {
      try {
        cart = JSON.parse(e.newValue || '[]');
        updateCartUI();
      } catch (err) {}
    }
  });

  async function addToCart(escapedName, price, originalPrice, image, sku, category, buttonEl) {
    let btn = null;
    if (buttonEl && buttonEl instanceof HTMLElement) {
      btn = buttonEl;
    } else if (typeof event !== 'undefined' && event && event.currentTarget instanceof HTMLElement) {
      btn = event.currentTarget;
    }

    let originalBtnHtml = '';
    if (btn && !btn.disabled) {
      btn.disabled = true;
      originalBtnHtml = btn.innerHTML;
      btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 0.85rem; height: 0.85rem;"></span> Adding...`;
    }

    try {
      let item;
      if (typeof escapedName === 'object') {
        item = escapedName;
        item.name = unescape(item.name);
        item.quantity = item.quantity || 1;
      } else {
        const name = unescape(escapedName);
        item = { name, price, originalPrice, image, sku, category, type: typeof category !== 'undefined' ? 'product' : 'service', quantity: 1 };
      }

      const existing = cart.find(i => i.name === item.name);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push(item);
      }

      await saveCart();
      
      const displayName = item.name.length > 28 ? item.name.substring(0, 28) + '…' : item.name;
      if (typeof showToast === 'function') {
        showToast(`🛒 ${displayName} added to cart ✓`);
      }
    } catch (err) {
      console.error("Add to cart error:", err);
      if (typeof showToast === 'function') {
        showToast("⚠️ Could not add to cart. Please try again.");
      }
    } finally {
      if (btn) {
        setTimeout(() => {
          btn.disabled = false;
          btn.innerHTML = originalBtnHtml;
        }, 300);
      }
    }
  }

  async function buyNowDirect(itemObj, buttonEl) {
    let btn = null;
    if (buttonEl && buttonEl instanceof HTMLElement) {
      btn = buttonEl;
    } else if (typeof event !== 'undefined' && event && event.currentTarget instanceof HTMLElement) {
      btn = event.currentTarget;
    }

    let originalBtnHtml = '';
    if (btn && !btn.disabled) {
      btn.disabled = true;
      originalBtnHtml = btn.innerHTML;
      btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="width: 0.85rem; height: 0.85rem;"></span> Processing...`;
    }

    try {
      if (typeof itemObj.name === 'string') itemObj.name = unescape(itemObj.name);
      const existing = cart.find(item => item.name === itemObj.name);
      if (!existing) {
        itemObj.quantity = 1;
        cart.push(itemObj);
      } else {
        existing.quantity += 1;
      }
      await saveCart();
      window.location.href = '/checkout';
    } catch (err) {
      console.error("Buy now error:", err);
      if (typeof showToast === 'function') {
        showToast("⚠️ Could not process request. Please try again.");
      }
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = originalBtnHtml;
      }
    }
  }

  async function removeFromCart(name) {
    const rawName = unescape(name);
    cart = cart.filter(item => item.name !== rawName);
    if (isLoggedIn) {
      try {
        await fetch('/api/cart/remove', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId: rawName })
        });
      } catch (e) { console.error(e); }
    } else {
      localStorage.setItem('kumawat_cart', JSON.stringify(cart));
    }
    updateCartUI();
  }

  async function adjustQty(name, amount) {
    const rawName = unescape(name);
    const item = cart.find(item => item.name === rawName);
    if (item) {
      item.quantity += amount;
      if (item.quantity <= 0) {
        await removeFromCart(rawName);
      } else {
        if (isLoggedIn) {
          try {
            await fetch('/api/cart/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ productId: rawName, quantity: item.quantity })
            });
          } catch (e) { console.error(e); }
        } else {
          localStorage.setItem('kumawat_cart', JSON.stringify(cart));
        }
        updateCartUI();
      }
    }
  }

  async function clearCart() {
    cart = [];
    if (isLoggedIn) {
      try {
        await fetch('/api/cart/clear', { method: 'POST' });
      } catch (e) { console.error(e); }
    } else {
      localStorage.removeItem('kumawat_cart');
    }
    updateCartUI();
  }

  function updateCartUI() {
    const totalItems = getCurrentCartQuantity();
    let totalPrice = 0;

    if (Array.isArray(cart)) {
      cart.forEach(item => {
        const qty = parseInt(item.quantity) || 1;
        totalPrice += (parseFloat(item.price) || 0) * qty;
      });
    }

    const drawerBody = document.getElementById('cart-drawer-body');
    if (drawerBody) {
      drawerBody.innerHTML = '';
      if (cart.length === 0) {
        drawerBody.innerHTML = `
          <div class="text-center py-5 text-muted">
            <i class="bi bi-cart-x mb-3" style="font-size: 3rem;"></i>
            <h5>Your cart is empty</h5>
            <button class="btn btn-outline mt-3" onclick="toggleCartDrawer(); window.location.href='/store'">Shop Now</button>
          </div>
        `;
      } else {
        cart.forEach(item => {
          const qty = parseInt(item.quantity) || 1;
          const itemTotal = (parseFloat(item.price) || 0) * qty;
          
          let imgHtml = item.image 
            ? `<img loading="lazy" decoding="async" src="${item.image}" alt="${item.name}">` 
            : `<div style="width:80px; height:80px; background:#eee; border-radius:8px; display:flex; align-items:center; justify-content:center;"><i class="bi bi-image text-muted"></i></div>`;
            
          drawerBody.innerHTML += `
            <div class="drawer-item">
              ${imgHtml}
              <div class="drawer-item-details">
                <div class="drawer-item-title">${item.name}</div>
                <div class="drawer-item-price">₹${parseFloat(item.price).toLocaleString('en-IN')}</div>
                <div class="drawer-qty-controls">
                  <button class="drawer-qty-btn" onclick="adjustQty('${escape(item.name)}', -1)" aria-label="Decrease quantity">-</button>
                  <span>${qty}</span>
                  <button class="drawer-qty-btn" onclick="adjustQty('${escape(item.name)}', 1)" aria-label="Increase quantity">+</button>
                  <button class="btn btn-sm btn-link text-danger ms-auto p-0" onclick="removeFromCart('${escape(item.name)}')" aria-label="Remove item"><i class="bi bi-trash"></i></button>
                </div>
              </div>
            </div>
          `;
        });
      }
    }

    // Update all visible cart count indicators across navigation
    updateCartIndicators(totalItems);

    // Update Drawer totals
    const drawerItemsTotal = document.getElementById('drawer-items-total');
    if (drawerItemsTotal) drawerItemsTotal.textContent = `₹${totalPrice.toLocaleString('en-IN')}`;
    
    const drawerGrandTotal = document.getElementById('drawer-grand-total');
    if (drawerGrandTotal) drawerGrandTotal.textContent = `₹${totalPrice.toLocaleString('en-IN')}`;

    // Dispatch cart updated custom events for any external listeners
    window.dispatchEvent(new CustomEvent('cartUpdated', { detail: { cart, totalItems, totalPrice } }));
    window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart, totalItems, totalPrice } }));
  }
</script>
