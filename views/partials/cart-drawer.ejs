<!-- Floating Cart Button -->
<button class="floating-cart-btn" onclick="toggleCartDrawer()">
  <i class="bi bi-cart3"></i> Cart (<span id="floating-cart-count">0</span>)
</button>

<!-- Sticky Mobile Checkout Bar -->
<div class="mobile-checkout-bar d-md-none" id="mobile-checkout-bar" style="display: none !important;">
  <div class="d-flex justify-content-between align-items-center w-100 px-3 py-2">
    <div>
      <div style="font-size: 0.8rem; color: rgba(255,255,255,0.7);">Items: <span id="mobile-cart-count">0</span></div>
      <div style="font-weight: bold; font-size: 1.1rem;" id="mobile-cart-total">₹0</div>
    </div>
    <button class="btn btn-accent btn-sm" onclick="toggleCartDrawer()">View Cart</button>
  </div>
</div>

<!-- Cart Drawer Overlay -->
<div class="cart-drawer-overlay" id="cartDrawerOverlay" onclick="toggleCartDrawer()"></div>

<!-- Cart Drawer Panel -->
<div class="cart-drawer" id="cartDrawer">
  <div class="cart-drawer-header">
    <h4 class="m-0">Your Cart</h4>
    <button class="btn-close" onclick="toggleCartDrawer()"></button>
  </div>
  
  <div class="cart-drawer-body" id="cart-drawer-body">
    <!-- Items render here -->
  </div>
  
  <div class="cart-drawer-footer">
    <div class="d-flex justify-content-between mb-2">
      <span class="text-muted">Items Total</span>
      <strong id="drawer-items-total">₹0</strong>
    </div>
    <div class="d-flex justify-content-between mb-2">
      <span class="text-muted">Delivery Charges</span>
      <strong class="text-success" style="font-size: 0.85rem;">Calculated at checkout</strong>
    </div>
    <hr>
    <div class="d-flex justify-content-between mb-3" style="font-size: 1.2rem;">
      <strong>Grand Total</strong>
      <strong id="drawer-grand-total">₹0</strong>
    </div>
    
    <div class="d-flex gap-2">
      <button class="btn btn-outline w-50" onclick="toggleCartDrawer()">Continue</button>
      <button class="btn btn-accent w-50" onclick="window.location.href='/checkout'">Checkout</button>
    </div>
  </div>
</div>

<style>
  /* Floating Cart Button */
  .floating-cart-btn {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: var(--accent);
    color: var(--dark);
    border: none;
    padding: 12px 24px;
    border-radius: 50px;
    font-weight: bold;
    font-size: 1.1rem;
    box-shadow: 0 10px 25px rgba(201, 96, 42, 0.4);
    cursor: pointer;
    z-index: 1040;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .floating-cart-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(201, 96, 42, 0.5);
  }

  /* Sticky Mobile Bar */
  .mobile-checkout-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--bg-dark);
    color: var(--white);
    z-index: 1035;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  /* Cart Drawer */
  .cart-drawer-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.5);
    z-index: 1050;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s;
  }
  .cart-drawer-overlay.show {
    opacity: 1;
    visibility: visible;
  }
  
  .cart-drawer {
    position: fixed;
    top: 0; right: -400px;
    width: 400px;
    height: 100vh;
    background: var(--bg);
    z-index: 1051;
    box-shadow: -5px 0 25px rgba(0,0,0,0.1);
    transition: right 0.3s ease;
    display: flex;
    flex-direction: column;
    max-width: 100vw;
  }
  .cart-drawer.open {
    right: 0;
  }
  
  .cart-drawer-header {
    padding: 20px;
    border-bottom: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }
  
  .cart-drawer-footer {
    padding: 20px;
    border-top: 1px solid var(--rule);
    background: var(--white);
  }

  .drawer-item {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }
  .drawer-item img {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
  }
  .drawer-item-details { flex: 1; }
  .drawer-item-title { font-weight: bold; margin-bottom: 5px; font-size: 1rem; }
  .drawer-item-price { color: var(--accent); font-weight: bold; }
  .drawer-qty-controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }
  .drawer-qty-btn {
    width: 28px; height: 28px;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: var(--white);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
</style>

<script>
  let cart = [];
  const isLoggedIn = <%= typeof user !== 'undefined' && user ? 'true' : 'false' %>;

  function toggleCartDrawer() {
    const drawer = document.getElementById('cartDrawer');
    const overlay = document.getElementById('cartDrawerOverlay');
    drawer.classList.toggle('open');
    overlay.classList.toggle('show');
  }

  async function loadCart() {
    if (isLoggedIn) {
      const localCartStr = localStorage.getItem('kumawat_cart');
      if (localCartStr) {
        try {
          const localCart = JSON.parse(localCartStr);
          if (localCart.length > 0) {
            await fetch('/api/cart/sync', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ cart: localCart })
            });
            localStorage.removeItem('kumawat_cart');
          }
        } catch(e){}
      }
      
      try {
        const res = await fetch('/api/cart');
        const data = await res.json();
        if (data.success) cart = data.cart;
      } catch (e) { console.error(e); }
    } else {
      const saved = localStorage.getItem('kumawat_cart');
      if (saved) {
        try { cart = JSON.parse(saved); } catch (e) { cart = []; }
      }
    }
    updateCartUI();
  }

  async function saveCart() {
    if (isLoggedIn) {
      try {
        await fetch('/api/cart/overwrite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ cart })
        });
      } catch (e) { console.error(e); }
    } else {
      localStorage.setItem('kumawat_cart', JSON.stringify(cart));
    }
    updateCartUI();
  }

  window.addEventListener('DOMContentLoaded', loadCart);

  function addToCart(escapedName, price, originalPrice, image, sku, category) {
    let item;
    if (typeof escapedName === 'object') {
      item = escapedName;
      item.name = unescape(item.name);
      item.quantity = 1;
    } else {
      const name = unescape(escapedName);
      item = { name, price, originalPrice, image, sku, category, type: typeof category !== 'undefined' ? 'product' : 'service', quantity: 1 };
    }

    const existing = cart.find(i => i.name === item.name);
    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push(item);
    }
    saveCart();
    
    showToast(`✅ ${item.name} Added to Cart`);
  }

  function buyNowDirect(itemObj) {
    if(typeof itemObj.name === 'string') itemObj.name = unescape(itemObj.name);
    const existing = cart.find(item => item.name === itemObj.name);
    if (!existing) {
      itemObj.quantity = 1;
      cart.push(itemObj);
    } else {
      existing.quantity += 1;
    }
    saveCart();
    window.location.href = '/checkout';
  }

  async function removeFromCart(name) {
    cart = cart.filter(item => item.name !== name);
    if (isLoggedIn) {
      try {
        await fetch('/api/cart/remove', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId: name }) // using name as identifier fallback
        });
      } catch (e) { console.error(e); }
    } else {
      localStorage.setItem('kumawat_cart', JSON.stringify(cart));
    }
    updateCartUI();
  }

  async function adjustQty(name, amount) {
    const item = cart.find(item => item.name === name);
    if (item) {
      item.quantity += amount;
      if (item.quantity <= 0) {
        await removeFromCart(name);
      } else {
        if (isLoggedIn) {
          try {
            await fetch('/api/cart/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ productId: name, quantity: item.quantity })
            });
          } catch (e) { console.error(e); }
        } else {
          localStorage.setItem('kumawat_cart', JSON.stringify(cart));
        }
        updateCartUI();
      }
    }
  }

  function updateCartUI() {
    let totalItems = 0;
    let totalPrice = 0;

    const drawerBody = document.getElementById('cart-drawer-body');
    if (drawerBody) {
      drawerBody.innerHTML = '';
      if (cart.length === 0) {
        drawerBody.innerHTML = `
          <div class="text-center py-5 text-muted">
            <i class="bi bi-cart-x mb-3" style="font-size: 3rem;"></i>
            <h5>Your cart is empty</h5>
            <button class="btn btn-outline mt-3" onclick="toggleCartDrawer(); window.location.href='/store'">Shop Now</button>
          </div>
        `;
      } else {
        cart.forEach(item => {
          totalItems += item.quantity;
          totalPrice += item.price * item.quantity;
          
          let imgHtml = item.image 
            ? `<img src="${item.image}" alt="${item.name}">` 
            : `<div style="width:80px; height:80px; background:#eee; border-radius:8px; display:flex; align-items:center; justify-content:center;"><i class="bi bi-image text-muted"></i></div>`;
            
          drawerBody.innerHTML += `
            <div class="drawer-item">
              ${imgHtml}
              <div class="drawer-item-details">
                <div class="drawer-item-title">${item.name}</div>
                <div class="drawer-item-price">₹${item.price}</div>
                <div class="drawer-qty-controls">
                  <button class="drawer-qty-btn" onclick="adjustQty('${item.name}', -1)">-</button>
                  <span>${item.quantity}</span>
                  <button class="drawer-qty-btn" onclick="adjustQty('${item.name}', 1)">+</button>
                  <button class="btn btn-sm btn-link text-danger ms-auto p-0" onclick="removeFromCart('${item.name}')"><i class="bi bi-trash"></i></button>
                </div>
              </div>
            </div>
          `;
        });
      }
    }

    // Update floating buttons and texts
    document.getElementById('floating-cart-count') && (document.getElementById('floating-cart-count').textContent = totalItems);
    document.getElementById('mobile-cart-count') && (document.getElementById('mobile-cart-count').textContent = totalItems);
    document.getElementById('mobile-cart-total') && (document.getElementById('mobile-cart-total').textContent = `₹${totalPrice}`);
    document.getElementById('drawer-items-total') && (document.getElementById('drawer-items-total').textContent = `₹${totalPrice}`);
    document.getElementById('drawer-grand-total') && (document.getElementById('drawer-grand-total').textContent = `₹${totalPrice}`);

    // Show/hide floating btn
    const floatBtn = document.querySelector('.floating-cart-btn');
    const mobileBar = document.getElementById('mobile-checkout-bar');
    
    // Hide cart buttons on checkout page
    if (window.location.pathname === '/checkout') {
      if(floatBtn) floatBtn.style.display = 'none';
      if(mobileBar) mobileBar.style.setProperty('display', 'none', 'important');
    } else {
      if(floatBtn) floatBtn.style.display = totalItems > 0 ? 'block' : 'none';
      if(mobileBar) mobileBar.style.setProperty('display', totalItems > 0 ? 'block' : 'none', 'important');
    }
  }

  // Init
  document.addEventListener('DOMContentLoaded', loadCart);
</script>
