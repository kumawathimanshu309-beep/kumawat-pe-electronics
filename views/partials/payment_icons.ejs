<div class="payment-icons-list" aria-label="Accepted payment methods">
  <span class="badge bg-secondary text-light" style="background-color: var(--ink-light) !important;" title="Cash Payment">
    <i class="bi bi-cash-stack"></i> Cash
  </span>
  <span class="badge bg-info text-dark" style="background-color: #e3f2fd !important; color: #0d47a1 !important; border: 1px solid #90caf9;" title="UPI Payments">
    <i class="bi bi-qr-code-scan"></i> UPI
  </span>
  <span class="badge text-white" style="background: linear-gradient(45deg, #4285F4, #34A853, #FBBC05, #EA4335) !important;" title="Google Pay">
    <i class="bi bi-google"></i> Pay
  </span>
  <span class="badge text-white" style="background-color: #5f259f !important;" title="PhonePe">
    <i class="bi bi-phone"></i> PhonePe
  </span>
  <span class="badge text-white" style="background-color: #00baf2 !important;" title="Paytm">
    <i class="bi bi-wallet2"></i> Paytm
  </span>
  <span class="badge bg-dark text-white" title="Credit Card">
    <i class="bi bi-credit-card-2-front"></i> Credit
  </span>
  <span class="badge bg-dark text-white" title="Debit Card">
    <i class="bi bi-credit-card"></i> Debit
  </span>
</div>
