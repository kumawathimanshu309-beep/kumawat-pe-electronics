<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Kumawat Plumbing & Electricals — Trusted home repair services in Govindgarh. Leaks, wiring, fittings, same-day visits. Managed by Himanshu Kumawat." />
  <meta name="theme-color" content="#1C2B2B" />
  <title><%= typeof title !== 'undefined' ? title : 'Kumawat Plumbing & Electricals | Govindgarh' %></title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;0,700;1,400&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/style.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo" aria-label="Kumawat Plumbing & Electricals home">
        <svg class="logo-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="18" cy="18" r="17" stroke="#C9602A" stroke-width="1.5"/>
          <path d="M13 23 L20 16" stroke="#1C2B2B" stroke-width="2" stroke-linecap="round"/>
          <circle cx="22" cy="14" r="3" stroke="#C9602A" stroke-width="1.5"/>
          <path d="M19 9 L16 17 L19 17 L17 27 L23 16 L20 16 Z" fill="#C9602A"/>
        </svg>
        <div class="logo-text">Kumawat P&amp;E <span>Plumbing &amp; Electricals</span></div>
      </a>

      <% const active = typeof activePage !== 'undefined' ? activePage : '' %>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/" class="<%= active === 'home' ? 'active' : '' %>">Home</a>
        <a href="/services" class="<%= active === 'services' ? 'active' : '' %>">Services</a>
        <a href="/about" class="<%= active === 'about' ? 'active' : '' %>">About</a>
        <a href="/pricing" class="<%= active === 'pricing' ? 'active' : '' %>">Pricing</a>
        <a href="/contact" class="<%= active === 'contact' ? 'active' : '' %>">Contact</a>
        
        <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'super_admin')) { %>
          <a href="/admin" target="_blank" class="<%= active === 'admin' ? 'active' : '' %>" style="color: var(--accent); font-weight: 600;">Admin Dashboard</a>
        <% } %>
      </nav>

      <div class="header-ctas">
        <% if (typeof user !== 'undefined' && user) { %>
          <span style="font-size: 0.85rem; font-weight: 600; color: var(--ink-light);">Hi, <%= user.name.split(' ')[0] %></span>
          <a href="/auth/logout" class="btn btn-outline" style="padding: 7px 14px; font-size: 0.78rem;">Logout</a>
          <div class="user-menu d-flex align-items-center gap-2">
            <a href="/dashboard" class="btn btn-outline" style="border-radius: 20px; padding: 6px 16px; font-size: 0.85rem;">My Account</a>
          </div>
        <% } else { %>
          <a href="/login" class="btn btn-outline <%= active === 'login' ? 'active' : '' %>">Login</a>
          <a href="/register" class="btn btn-accent <%= active === 'register' ? 'active' : '' %>">Register</a>
        <% } %>
        <a href="https://wa.me/919462759965?text=Hi%20Himanshu%2C%20I%20need%20a%20plumbing%20or%20electrical%20service.%20Can%20you%20help%3F" class="btn btn-whatsapp" target="_blank" rel="noopener">
          <i class="bi bi-whatsapp"></i> WhatsApp
        </a>
      </div>

      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    <a href="/" class="<%= active === 'home' ? 'active' : '' %>" onclick="closeMobileNav()">Home</a>
    <a href="/services" class="<%= active === 'services' ? 'active' : '' %>" onclick="closeMobileNav()">Services</a>
    <a href="/about" class="<%= active === 'about' ? 'active' : '' %>" onclick="closeMobileNav()">About</a>
    <a href="/pricing" class="<%= active === 'pricing' ? 'active' : '' %>" onclick="closeMobileNav()">Pricing</a>
    <a href="/contact" class="<%= active === 'contact' ? 'active' : '' %>" onclick="closeMobileNav()">Contact</a>
    <% if (typeof user !== 'undefined' && user) { %>
      <% if (user.role === 'admin' || user.role === 'super_admin') { %>
        <a href="/admin" target="_blank" class="<%= active === 'admin' ? 'active' : '' %>" onclick="closeMobileNav()" style="color: var(--accent); font-weight: bold;">Admin Dashboard</a>
      <% } %>
      <a href="/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>" onclick="closeMobileNav()">My Account</a>
      <a href="/auth/logout" onclick="closeMobileNav()">Logout</a>
    <% } else { %>
      <a href="/login" class="<%= active === 'login' ? 'active' : '' %>" onclick="closeMobileNav()">Login</a>
      <a href="/register" class="<%= active === 'register' ? 'active' : '' %>" onclick="closeMobileNav()">Register</a>
    <% } %>
  </nav>
</header>
