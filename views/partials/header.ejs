<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= (typeof seo !== 'undefined' && seo.description) ? seo.description : 'Kumawat Plumbing & Electricals — Premium electronics, home appliances, and electrical tools. Managed by Himanshu Kumawat.' %>" />
  <meta name="keywords" content="<%= (typeof seo !== 'undefined' && seo.keywords) ? seo.keywords : 'electronics, appliances, electricals, plumbing, tools, govindgarh' %>" />
  <% if (typeof seo !== 'undefined' && seo.canonicalUrl) { %>
    <link rel="canonical" href="<%= optimizeImage(seo.canonicalUrl) %>" />
  <% } %>
  <meta name="theme-color" content="#1C2B2B" />
  <title><%= (typeof seo !== 'undefined' && seo.title) ? seo.title : (typeof title !== 'undefined' ? title : 'Kumawat Plumbing & Electricals | Electronics Store') %></title>
  
  <!-- Organization Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Kumawat Plumbing & Electricals",
    "url": "https://kumawatelectricals.com",
    "logo": "https://kumawatelectricals.com/images/logo.png",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+91-9462759965",
      "contactType": "customer service"
    }
  }
</script>
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="<%= (typeof seo !== 'undefined' && seo.ogType) ? seo.ogType : 'website' %>" />
  <meta property="og:url" content="<%= (typeof seo !== 'undefined' && seo.canonicalUrl) ? seo.canonicalUrl : 'https://kumawatelectricals.com' %>" />
  <meta property="og:title" content="<%= (typeof seo !== 'undefined' && seo.title) ? seo.title : (typeof title !== 'undefined' ? title : 'Kumawat Plumbing & Electricals') %>" />
  <meta property="og:description" content="<%= (typeof seo !== 'undefined' && seo.description) ? seo.description : 'Premium electronics, home appliances, and electrical tools.' %>" />
  <meta property="og:image" content="<%= (typeof seo !== 'undefined' && seo.image) ? seo.image : 'https://kumawatelectricals.com/images/logo.png' %>" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="<%= (typeof seo !== 'undefined' && seo.canonicalUrl) ? seo.canonicalUrl : 'https://kumawatelectricals.com' %>" />
  <meta property="twitter:title" content="<%= (typeof seo !== 'undefined' && seo.title) ? seo.title : (typeof title !== 'undefined' ? title : 'Kumawat Plumbing & Electricals') %>" />
  <meta property="twitter:description" content="<%= (typeof seo !== 'undefined' && seo.description) ? seo.description : 'Premium electronics, home appliances, and electrical tools.' %>" />
  <meta property="twitter:image" content="<%= (typeof seo !== 'undefined' && seo.image) ? seo.image : 'https://kumawatelectricals.com/images/logo.png' %>" />
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;0,700;1,400&family=Manrope:wght@400;500;600;700&display=swap" as="style" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;0,700;1,400&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<a href="#main-content" class="skip-link sr-only sr-only-focusable">Skip to main content</a>

<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <a href="/" class="logo" aria-label="Kumawat Plumbing & Electricals home">
        <svg class="logo-icon" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="18" cy="18" r="17" stroke="#C9602A" stroke-width="1.5"/>
          <path d="M13 23 L20 16" stroke="#1C2B2B" stroke-width="2" stroke-linecap="round"/>
          <circle cx="22" cy="14" r="3" stroke="#C9602A" stroke-width="1.5"/>
          <path d="M19 9 L16 17 L19 17 L17 27 L23 16 L20 16 Z" fill="#C9602A"/>
        </svg>
        <div class="logo-text">Kumawat P&amp;E <span>Plumbing &amp; Electricals</span></div>
      </a>

      <% const active = typeof activePage !== 'undefined' ? activePage : '' %>
      <nav class="desktop-nav" aria-label="Main navigation">
        <a href="/" class="<%= active === 'home' ? 'active' : '' %>">Home</a>
        <a href="/services" class="<%= active === 'services' ? 'active' : '' %>">Services</a>
        <a href="/about" class="<%= active === 'about' ? 'active' : '' %>">About</a>
        <a href="/pricing" class="<%= active === 'pricing' ? 'active' : '' %>">Pricing</a>
        <a href="/contact" class="<%= active === 'contact' ? 'active' : '' %>">Contact</a>
        
        <% if (typeof user !== 'undefined' && user && (user.role === 'admin' || user.role === 'super_admin')) { %>
          <a href="/admin" target="_blank" class="<%= active === 'admin' ? 'active' : '' %>" style="color: var(--accent); font-weight: 600;">Admin Dashboard</a>
        <% } %>
      </nav>

      <div class="header-ctas">
        <% if (typeof user !== 'undefined' && user) { %>
          <% const unreadCount = (typeof notifications !== 'undefined' ? notifications : []).filter(n => !n.read).length; %>
          <span style="font-size: 0.85rem; font-weight: 600; color: var(--ink-light);">Hi, <%= user.name.split(' ')[0] %></span>
          <a href="/auth/logout" class="btn btn-outline" style="padding: 7px 14px; font-size: 0.78rem;">Logout</a>
          <div class="user-menu d-flex align-items-center gap-2">
            <a href="/dashboard?tab=notifications" class="position-relative" style="color: var(--ink); margin-right: 10px; font-size: 1.2rem;">
              <i class="bi bi-bell"></i>
              <% if (unreadCount > 0) { %>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">
                  <%= unreadCount %>
                </span>
              <% } %>
            </a>
            <a href="/dashboard?tab=wishlist" class="position-relative" style="color: var(--ink); margin-right: 15px; font-size: 1.2rem;">
              <i class="bi bi-heart"></i>
              <span id="wishlist-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem; display: none;">0</span>
            </a>
            <a href="/dashboard" class="btn btn-outline" style="border-radius: 20px; padding: 6px 16px; font-size: 0.85rem;">My Account</a>
          </div>
          <script>
            document.addEventListener('DOMContentLoaded', async () => {
              try {
                const res = await fetch('/api/wishlist/count');
                const data = await res.json();
                if (data.success && data.count > 0) {
                  const badge = document.getElementById('wishlist-badge');
                  badge.innerText = data.count;
                  badge.style.display = 'block';
                }
              } catch (e) {}
            });
          </script>
        <% } else { %>
          <a href="/login" class="btn btn-outline <%= active === 'login' ? 'active' : '' %>">Login</a>
          <a href="/register" class="btn btn-accent <%= active === 'register' ? 'active' : '' %>">Register</a>
        <% } %>
        <a href="https://wa.me/919462759965?text=Hi%20Himanshu%2C%20I%20need%20a%20plumbing%20or%20electrical%20service.%20Can%20you%20help%3F" class="btn btn-whatsapp" target="_blank" rel="noopener">
          <i class="bi bi-whatsapp"></i> WhatsApp
        </a>
      </div>

      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    <a href="/" class="<%= active === 'home' ? 'active' : '' %>" onclick="closeMobileNav()">Home</a>
    <a href="/services" class="<%= active === 'services' ? 'active' : '' %>" onclick="closeMobileNav()">Services</a>
    <a href="/about" class="<%= active === 'about' ? 'active' : '' %>" onclick="closeMobileNav()">About</a>
    <a href="/pricing" class="<%= active === 'pricing' ? 'active' : '' %>" onclick="closeMobileNav()">Pricing</a>
    <a href="/contact" class="<%= active === 'contact' ? 'active' : '' %>" onclick="closeMobileNav()">Contact</a>
    <% if (typeof user !== 'undefined' && user) { %>
      <% if (user.role === 'admin' || user.role === 'super_admin') { %>
        <a href="/admin" target="_blank" class="<%= active === 'admin' ? 'active' : '' %>" onclick="closeMobileNav()" style="color: var(--accent); font-weight: bold;">Admin Dashboard</a>
      <% } %>
      <a href="/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>" onclick="closeMobileNav()">My Account</a>
      <a href="/auth/logout" onclick="closeMobileNav()">Logout</a>
    <% } else { %>
      <a href="/login" class="<%= active === 'login' ? 'active' : '' %>" onclick="closeMobileNav()">Login</a>
      <a href="/register" class="<%= active === 'register' ? 'active' : '' %>" onclick="closeMobileNav()">Register</a>
    <% } %>
  </nav>
</header>
