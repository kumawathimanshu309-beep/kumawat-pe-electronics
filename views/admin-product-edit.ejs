<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Product | Store Management</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@400;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body style="overflow: hidden; background: var(--bg);">

<div class="admin-layout" style="height: 100vh;">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="name">Kumawat P&amp;E</div>
      <div class="sub">Store Management</div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-item" onclick="window.location.href='/admin?tab=store'">
        <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
      </div>
    </nav>
  </aside>

  <div class="main-area" style="overflow-y: auto;">
    <div class="top-nav px-4 py-3 d-flex align-items-center bg-white border-bottom">
      <h2 style="margin: 0; font-family: var(--font-display); font-size: 1.5rem;">Edit Product</h2>
    </div>
    
    <div style="padding: 40px;">
      <div class="card" style="max-width: 800px; margin: 0 auto;">
      </div>
      <div class="card-body">
        <form action="/admin/products/edit/<%= product.productId %>" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          
          <div class="field mb-3">
            <label>Product Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" value="<%= product.name %>" required />
          </div>

          <div class="row mb-3">
            <div class="col-md-6 field">
              <label>Regular Price (₹) <span class="text-danger">*</span></label>
              <input type="number" name="price" class="form-control" value="<%= product.price %>" required min="0" />
            </div>
            <div class="col-md-6 field">
              <label>Discount Price (₹) [Optional]</label>
              <input type="number" name="discountPrice" class="form-control" value="<%= product.discountPrice || '' %>" min="0" />
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6 field">
              <label>Category [Optional]</label>
              <% 
                const predefinedCategories = ['Plumbing', 'Electrical', 'AC & Appliances', 'Motors & Pumps', 'Tools', 'Spare Parts'];
                const isCustomCategory = product.category && !predefinedCategories.includes(product.category);
              %>
              <select id="categorySelect" name="<%= isCustomCategory ? '' : 'category' %>" class="form-control" onchange="handleCategoryChange()">
                <option value="Plumbing" <%= product.category === 'Plumbing' ? 'selected' : '' %>>Plumbing</option>
                <option value="Electrical" <%= product.category === 'Electrical' ? 'selected' : '' %>>Electrical</option>
                <option value="AC & Appliances" <%= product.category === 'AC & Appliances' ? 'selected' : '' %>>AC & Appliances</option>
                <option value="Motors & Pumps" <%= product.category === 'Motors & Pumps' ? 'selected' : '' %>>Motors & Pumps</option>
                <option value="Tools" <%= product.category === 'Tools' ? 'selected' : '' %>>Tools</option>
                <option value="Spare Parts" <%= product.category === 'Spare Parts' ? 'selected' : '' %>>Spare Parts</option>
                <option value="Custom" <%= isCustomCategory || product.category === 'Custom' ? 'selected' : '' %>>Custom</option>
              </select>
              <input type="text" id="customCategoryInput" class="form-control mt-2 <%= isCustomCategory ? '' : 'd-none' %>" placeholder="Enter Custom Category" <%= isCustomCategory ? 'required name="category" value="' + product.category + '"' : '' %> />
            </div>
            <div class="col-md-6 field">
              <label>Stock Quantity [Optional]</label>
              <input type="number" name="stock" class="form-control" value="<%= product.stock %>" min="0" />
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-4 field">
              <label>SKU Code [Optional]</label>
              <input type="text" name="sku" class="form-control" value="<%= product.sku || '' %>" />
            </div>
            <div class="col-md-4 field">
              <label>Status</label>
              <select name="status" class="form-control">
                <option value="Active" <%= product.status === 'Active' ? 'selected' : '' %>>Active</option>
                <option value="Out Of Stock" <%= product.status === 'Out Of Stock' ? 'selected' : '' %>>Out Of Stock</option>
                <option value="Hidden" <%= product.status === 'Hidden' ? 'selected' : '' %>>Hidden</option>
              </select>
            </div>
            <div class="col-md-4 field">
              <label>Delivery Available?</label>
              <select name="deliveryAvailable" class="form-control">
                <option value="true" <%= product.deliveryAvailable ? 'selected' : '' %>>Yes</option>
                <option value="false" <%= !product.deliveryAvailable ? 'selected' : '' %>>No</option>
              </select>
            </div>
          </div>

          <h5 class="mt-4 mb-3" style="font-family:var(--font-display); color:var(--accent); border-bottom:1px solid var(--rule); padding-bottom:10px;">Premium Electronics Specifications</h5>

          <div class="row mb-3">
            <div class="col-md-4 field">
              <label>Video URL [Optional]</label>
              <input type="url" name="video" class="form-control" placeholder="https://youtube.com/embed/..." value="<%= product.video || '' %>" />
            </div>
            <div class="col-md-4 field">
              <label>Badges (Comma separated)</label>
              <input type="text" name="badges" class="form-control" placeholder="e.g. New Arrival, Best Seller" value="<%= product.badges ? product.badges.join(', ') : '' %>" />
            </div>
            <div class="col-md-4 field">
              <label>Accessories (Comma separated Product IDs)</label>
              <input type="text" name="accessories" class="form-control" placeholder="ID1, ID2..." value="<%= product.accessories ? product.accessories.join(', ') : '' %>" />
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-6 field">
              <label>Key Features (Comma separated)</label>
              <textarea name="features" class="form-control" rows="2"><%= product.features ? product.features.join(', ') : '' %></textarea>
            </div>
            <div class="col-md-6 field">
              <label>Package Contents</label>
              <textarea name="packageContents" class="form-control" rows="2"><%= product.packageContents ? product.packageContents.join(', ') : '' %></textarea>
            </div>
          </div>

          <div class="row mb-3">
            <div class="col-md-3 field">
              <label>Warranty Duration</label>
              <input type="text" name="spec_warranty" class="form-control" value="<%= (product.specifications && product.specifications.warranty && product.specifications.warranty.get) ? product.specifications.warranty.get('duration') : '' %>" />
            </div>
            <div class="col-md-3 field">
              <label>Voltage</label>
              <input type="text" name="spec_voltage" class="form-control" value="<%= (product.specifications && product.specifications.electrical && product.specifications.electrical.get) ? product.specifications.electrical.get('voltage') : '' %>" />
            </div>
            <div class="col-md-3 field">
              <label>Power/Wattage</label>
              <input type="text" name="spec_wattage" class="form-control" value="<%= (product.specifications && product.specifications.electrical && product.specifications.electrical.get) ? product.specifications.electrical.get('wattage') : '' %>" />
            </div>
            <div class="col-md-3 field">
              <label>Physical Weight</label>
              <input type="text" name="spec_weight" class="form-control" value="<%= (product.specifications && product.specifications.physical && product.specifications.physical.get) ? product.specifications.physical.get('weight') : '' %>" />
            </div>
          </div>

          <div class="field mb-3 mt-4">
            <label>Description [Optional]</label>
            <textarea name="description" class="form-control" rows="4"><%= product.description || '' %></textarea>
          </div>

          <div class="field mb-4">
            <label>Update Product Images</label>
            <input type="file" name="images" class="form-control" multiple accept="image/*" />
            <small class="text-muted">Leave empty to keep existing images. Uploading new images will replace the old ones.</small>
          </div>

          </div>

          <div class="d-flex justify-content-end gap-2 mt-4">
            <a href="/admin?tab=store" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-accent">Update Product</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
function handleCategoryChange() {
  const select = document.getElementById('categorySelect');
  const customInput = document.getElementById('customCategoryInput');
  if (select.value === 'Custom') {
    customInput.classList.remove('d-none');
    customInput.setAttribute('required', 'required');
    customInput.setAttribute('name', 'category');
    select.removeAttribute('name');
  } else {
    customInput.classList.add('d-none');
    customInput.removeAttribute('required');
    customInput.removeAttribute('name');
    customInput.value = '';
    select.setAttribute('name', 'category');
  }
}
</script>
</body>
</html>
