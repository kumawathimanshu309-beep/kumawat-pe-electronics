<%- include('partials/header', { title: 'Order Success | Kumawat P&E', activePage: 'services' }) %>

<div class="container" style="padding: 60px 24px;">
  <div class="text-center mb-5" style="max-width: 600px; margin: 0 auto;">
    <div class="display-1 text-success mb-3"><i class="bi bi-check-circle"></i></div>
    <h2>Order Placed Successfully!</h2>
    <p class="text-muted mt-2">Thank you for booking with Kumawat Plumbing &amp; Electricals. Your order has been registered, and a notification has been sent to your email.</p>
    <div class="mt-4">
      <span class="badge bg-dark text-white p-2 px-3 font-monospace" style="font-size: 1rem; letter-spacing: 0.05em;">ORDER ID: <%= order.orderId %></span>
    </div>
  </div>

  <div class="row g-4">
    <!-- Tracker Section -->
    <div class="col-lg-8 col-12">
      <div class="dashboard-block">
        <h3>Home Delivery Status Tracking</h3>
        
        <div class="tracker-container">
          <% 
            const status = order.deliveryStatus; // Pending, In Transit, Delivered, Cancelled
            let percent = 0;
            let step1 = 'active', step2 = '', step3 = '', step4 = '';
            
            if (status === 'Pending') {
              percent = 0;
              step1 = 'active';
            } else if (status === 'In Transit') {
              percent = 50;
              step1 = 'completed';
              step2 = 'active';
            } else if (status === 'Delivered') {
              percent = 100;
              step1 = 'completed';
              step2 = 'completed';
              step3 = 'completed';
              step4 = 'active';
            } else if (status === 'Cancelled') {
              percent = 0;
            }
          %>
          
          <div class="tracker-line"></div>
          <div class="tracker-progress-line" style="width: <%= percent %>%;"></div>
          
          <div class="tracker-steps">
            <div class="tracker-step <%= step1 %>">
              <div class="tracker-bullet">
                <i class="bi bi-clock-history text-white" style="font-size: 0.65rem;"></i>
              </div>
              <span class="tracker-label">Pending</span>
              <span class="tracker-time">Awaiting confirmation</span>
            </div>
            
            <div class="tracker-step <%= step2 || (percent > 50 ? 'completed' : '') %>">
              <div class="tracker-bullet">
                <i class="bi bi-truck text-white" style="font-size: 0.65rem;"></i>
              </div>
              <span class="tracker-label">In Transit</span>
              <span class="tracker-time">Out for delivery / repair</span>
            </div>
            
            <div class="tracker-step <%= step4 %>">
              <div class="tracker-bullet">
                <i class="bi bi-house-check text-white" style="font-size: 0.65rem;"></i>
              </div>
              <span class="tracker-label">Delivered</span>
              <span class="tracker-time">Service completed</span>
            </div>
          </div>
        </div>

        <div class="alert alert-warning mt-4 d-flex align-items-center" role="alert" style="padding: 12px 18px;">
          <i class="bi bi-info-circle-fill me-2" style="font-size: 1.4rem;"></i>
          <div>
            <strong>Delivery Confirmation Code:</strong> Please share this unique code <code><%= delivery.confirmationCode %></code> with our technician <strong><%= delivery.assignedTo %></strong> once the work is completed or the parts are delivered.
          </div>
        </div>
      </div>

      <!-- Order Details Summary -->
      <div class="dashboard-block mt-4">
        <h3>Booking Details</h3>
        
        <div class="row mt-3">
          <div class="col-md-6 col-12 mb-3">
            <h5 class="text-muted" style="font-size: 0.8rem; text-transform: uppercase;">Scheduled Service Date</h5>
            <p style="font-weight: 600;"><%= new Date(order.preferredDate).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            <p class="text-muted" style="font-size: 0.85rem;"><%= order.timeSlot %></p>
          </div>
          <div class="col-md-6 col-12 mb-3">
            <h5 class="text-muted" style="font-size: 0.8rem; text-transform: uppercase;">Delivery Location</h5>
            <%
              let addressStr = "Address Not Available";
              if (typeof order.deliveryAddress === 'object' && order.deliveryAddress !== null) {
                addressStr = `${order.deliveryAddress.house || ''}, ${order.deliveryAddress.street || ''}\n${order.deliveryAddress.city || ''}, ${order.deliveryAddress.state || ''} - ${order.deliveryAddress.pincode || ''}`;
              } else if (typeof order.deliveryAddress === 'string' && order.deliveryAddress.trim() !== '') {
                try {
                  const parsed = JSON.parse(order.deliveryAddress);
                  addressStr = `${parsed.house || ''}, ${parsed.street || ''}\n${parsed.city || ''}, ${parsed.state || ''} - ${parsed.pincode || ''}`;
                } catch (e) {
                  addressStr = order.deliveryAddress;
                }
              }
            %>
            <p style="font-weight: 600; white-space: pre-wrap;"><%= addressStr %></p>
          </div>
          <div class="col-md-6 col-12 mb-3">
            <h5 class="text-muted" style="font-size: 0.8rem; text-transform: uppercase;">Payment Details</h5>
            <p style="font-weight: 600;"><%= order.paymentMethod %> (<%= order.paymentStatus %>)</p>
            <%- include('partials/payment_icons') %>
          </div>
          <div class="col-md-6 col-12 mb-3">
            <h5 class="text-muted" style="font-size: 0.8rem; text-transform: uppercase;">Assigned Service Personnel</h5>
            <p style="font-weight: 600;"><%= delivery.assignedTo %></p>
            <p class="text-muted" style="font-size: 0.85rem;">Contact: +91 94627 59965 (Himanshu's Office)</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Receipt Details Sidebar -->
    <div class="col-lg-4 col-12">
      <div class="cart-summary-card">
        <h3>Invoice Receipt</h3>
        <hr style="border-top: 1px solid var(--rule); margin: 12px 0;" />
        
        <% order.items.forEach(item => { %>
          <div class="cart-item">
            <div class="info">
              <div class="title"><%= item.name %> <span class="text-muted">x<%= item.quantity %></span></div>
              <div class="desc">₹<%= item.price %> each</div>
            </div>
            <span class="price">₹<%= item.price * item.quantity %></span>
          </div>
        <% }) %>

        <div class="cart-total-row">
          <span>Amount Paid/Due:</span>
          <span class="price" style="font-size: 1.25rem;">₹<%= order.totalAmount %></span>
        </div>
        
        <div class="text-center mt-4">
          <a href="/dashboard" class="btn btn-outline btn-full mb-2"><i class="bi bi-speedometer"></i> View Order History</a>
          <a href="/services" class="btn btn-accent btn-full"><i class="bi bi-cart"></i> Create New Booking</a>
          <div class="col-12 mt-4 text-center">
            <a href="/services" class="btn btn-primary btn-lg" style="border-radius: 8px; font-weight: 600; padding: 12px 30px;">
              <i class="bi bi-cart-plus me-2"></i>Continue Shopping
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Auto clear cart from LocalStorage to match backend state
  localStorage.removeItem('cartItems');
  
  // Optionally reset UI cart badge if present on this page
  const cartBadge = document.getElementById('cart-badge');
  if(cartBadge) cartBadge.textContent = '0';
</script>

<%- include('partials/footer') %>
