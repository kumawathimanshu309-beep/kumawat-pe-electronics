<%- include('partials/header', { title: 'Our Services & Parts | Kumawat P&E', activePage: 'services' }) %>

<div class="container" style="padding: 60px 24px;">
  <div class="services-header text-center" style="max-width: 720px; margin: 0 auto 50px;">
    <p class="section-label">Service &amp; Supply Catalog</p>
    <h2>Book Services or Order Spare Parts</h2>
    <p style="margin-top: 10px;">Select from our premium range of plumbing and electrical services. Any required parts can be delivered directly to your home with optional on-site installation.</p>
    <div style="margin-top: 15px;">
      <%- include('partials/payment_icons') %>
    </div>
  </div>

  <div class="row">
    <!-- Services List -->
    <div class="col-lg-8 col-md-12">
      <div class="row g-4">
        <!-- Service Card 1 -->
        <div class="col-md-6 col-12">
          <div class="service-card h-100">
            <span class="badge-delivery"><i class="bi bi-truck"></i> Delivery Avail.</span>
            <div class="service-icon" style="color: var(--accent); font-size: 2rem;"><i class="bi bi-droplet"></i></div>
            <h3>Leak Detection &amp; Repair</h3>
            <p>Wall seepage, pipe bursts, hidden leaks. Our acoustic detection equipment locates the exact failure point to avoid unnecessary wall cutting.</p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <span class="service-price">₹299 <small>onwards</small></span>
              <button class="btn btn-accent btn-sm" onclick="addToCart('Leak Detection & Repair', 299)">Add to Booking</button>
            </div>
          </div>
        </div>

        <!-- Service Card 2 -->
        <div class="col-md-6 col-12">
          <div class="service-card h-100">
            <span class="badge-delivery"><i class="bi bi-truck"></i> Delivery Avail.</span>
            <div class="service-icon" style="color: var(--accent); font-size: 2rem;"><i class="bi bi-lightning-charge"></i></div>
            <h3>Electrical Wiring / MCB Repair</h3>
            <p>Load balancing, MCB replacements, points install, short circuit diagnosis. All repairs conform to safety standards.</p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <span class="service-price">₹499 <small>onwards</small></span>
              <button class="btn btn-accent btn-sm" onclick="addToCart('Electrical Wiring & MCB Repair', 499)">Add to Booking</button>
            </div>
          </div>
        </div>

        <!-- Service Card 3 -->
        <div class="col-md-6 col-12">
          <div class="service-card h-100">
            <span class="badge-delivery"><i class="bi bi-truck"></i> Delivery Avail.</span>
            <div class="service-icon" style="color: var(--accent); font-size: 2rem;"><i class="bi bi-tools"></i></div>
            <h3>Tap &amp; Sanitary Fitting</h3>
            <p>Replacement of bibcocks, angle valves, health faucets, washbasins, flush valves. Genuine brass fittings available.</p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <span class="service-price">₹199 <small>onwards</small></span>
              <button class="btn btn-accent btn-sm" onclick="addToCart('Tap & Sanitary Fitting', 199)">Add to Booking</button>
            </div>
          </div>
        </div>

        <!-- Service Card 4 -->
        <div class="col-md-6 col-12">
          <div class="service-card h-100">
            <span class="badge-delivery"><i class="bi bi-truck"></i> Delivery Avail.</span>
            <div class="service-icon" style="color: var(--accent); font-size: 2rem;"><i class="bi bi-speedometer2"></i></div>
            <h3>Water Motor &amp; Pump Repair</h3>
            <p>Overhead float switch wiring, motor winding, submersible repair, capacitor replacement, pressure pumps set.</p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <span class="service-price">₹599 <small>onwards</small></span>
              <button class="btn btn-accent btn-sm" onclick="addToCart('Water Motor & Pump Repair', 599)">Add to Booking</button>
            </div>
          </div>
        </div>

        <!-- Service Card 5 -->
        <div class="col-md-6 col-12">
          <div class="service-card h-100">
            <span class="badge-delivery"><i class="bi bi-truck"></i> Delivery Avail.</span>
            <div class="service-icon" style="color: var(--accent); font-size: 2rem;"><i class="bi bi-wind"></i></div>
            <h3>AC Installation &amp; Service</h3>
            <p>Split AC back-to-back install, gas charging (R22/R32/R410), chemical jet washing, filter servicing.</p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <span class="service-price">₹799 <small>per visit</small></span>
              <button class="btn btn-accent btn-sm" onclick="addToCart('AC Installation & Service', 799)">Add to Booking</button>
            </div>
          </div>
        </div>

        <!-- Service Card 6 -->
        <div class="col-md-6 col-12">
          <div class="service-card h-100">
            <span class="badge-delivery"><i class="bi bi-truck"></i> Delivery Avail.</span>
            <div class="service-icon" style="color: var(--accent); font-size: 2rem;"><i class="bi bi-brightness-high"></i></div>
            <h3>Geyser &amp; Appliance Repair</h3>
            <p>Replacement of heavy elements, thermostat safety checks, thermocouple fixes for gas and electrical geysers.</p>
            <div class="d-flex justify-content-between align-items-center mt-3">
              <span class="service-price">₹349 <small>onwards</small></span>
              <button class="btn btn-accent btn-sm" onclick="addToCart('Geyser & Appliance Repair', 349)">Add to Booking</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Products Section -->
      <% if (typeof products !== 'undefined' && products.length > 0) { %>
        <div style="margin-top: 50px;">
          <h3 style="font-family: var(--font-display); font-size: 1.5rem; border-bottom: 2px solid var(--rule); padding-bottom: 12px; margin-bottom: 24px;">Store Products &amp; Spare Parts</h3>
          <div class="row g-4">
            <% products.forEach(p => { %>
              <div class="col-md-6 col-12">
                <div class="service-card h-100" style="padding: 24px;">
                  <% if (p.deliveryAvailable !== false) { %>
                    <span class="badge-delivery" style="top: 12px; right: 12px;"><i class="bi bi-truck"></i> Delivery Avail.</span>
                  <% } %>
                  
                  <div style="width: 100%; height: 160px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff; border-radius: 6px; margin-bottom: 16px; border: 1px solid rgba(0,0,0,0.05);">
                    <% if (p.images && p.images.length > 0) { %>
                      <img src="<%= p.images[0] %>" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="<%= p.name %>" />
                    <% } else { %>
                      <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                    <% } %>
                  </div>

                  <h3 style="font-size: 1.15rem; margin-bottom: 8px;"><%= p.name %></h3>
                  <p style="font-size: 0.85rem; margin-bottom: 15px; flex-grow: 1;">
                    <%= p.description ? (p.description.length > 60 ? p.description.substring(0, 60) + '...' : p.description) : '' %>
                  </p>

                  <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="service-price">
                      <% if (p.discountPrice) { %>
                        <span style="text-decoration:line-through; color:#999; font-size:0.8rem; margin-right: 8px;">₹<%= p.price %></span>
                        ₹<%= p.discountPrice %>
                      <% } else { %>
                        ₹<%= p.price %>
                      <% } %>
                    </span>
                    <% if (p.stock > 0 && p.status !== 'Out Of Stock') { %>
                      <button class="btn btn-accent btn-sm" onclick="addToCart({ 
                        name: '<%= escape(p.name) %>', 
                        price: <%= p.discountPrice || p.price %>, 
                        originalPrice: <%= p.price %>,
                        image: '<%= p.images && p.images.length ? p.images[0] : '' %>',
                        sku: '<%= p.sku || 'N/A' %>',
                        category: '<%= p.category || 'General' %>',
                        type: 'product'
                      })">Add to Booking</button>
                    <% } else { %>
                      <button class="btn btn-secondary btn-sm disabled" disabled>Sold Out</button>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

    </div>


    <!-- Booking / Cart Sidebar -->
    <div class="col-lg-4 col-md-12 mt-4 mt-lg-0">
      <div class="cart-summary-card sticky-top" style="top: 84px; z-index: 5;">
        <h3 style="margin-bottom: 18px; display: flex; align-items: center; justify-content: space-between;">
          <span>Selected Services</span>
          <span class="badge bg-danger text-white" id="cart-count">0</span>
        </h3>
        
        <div id="cart-empty-msg" class="text-center py-4 text-muted">
          <i class="bi bi-cart3" style="font-size: 2.5rem; display: block; margin-bottom: 10px; color: var(--rule);"></i>
          <p>No services selected yet. Click "Add to Booking" to start.</p>
        </div>

        <div id="cart-items-wrapper" style="display: none;">
          <div id="cart-items-list" style="max-height: 250px; overflow-y: auto;"></div>
          
          <div class="cart-total-row">
            <span>Total Labour:</span>
            <span id="cart-total-price">₹0</span>
          </div>

          <div class="alert alert-success d-flex align-items-center" role="alert" style="font-size: 0.8rem; padding: 10px;">
            <i class="bi bi-truck-flatbed me-2" style="font-size: 1.25rem;"></i>
            <div>
              <strong>Home Delivery Available!</strong> Spare parts billed at actual retail cost.
            </div>
          </div>

          <button class="btn btn-accent btn-full" onclick="proceedToCheckout()">Proceed to Checkout <i class="bi bi-arrow-right"></i></button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Services specific logic if any, currently moved to cart-drawer.ejs
</script>

<%- include('partials/footer') %>
