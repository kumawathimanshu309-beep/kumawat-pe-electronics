<!-- ── FEATURED PRODUCTS ───────────────────────────────── -->
<section class="featured-products-section" id="featured-products" style="padding: 80px 0; background-color: var(--white);">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3" style="margin-bottom: 40px;">
      <div>
        <p class="section-label">Our Catalog</p>
        <h2 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; color: var(--ink);">Featured Products</h2>
        <p style="color: var(--ink-light); margin-top: 10px;">High-quality plumbing and electrical supplies delivered right to you.</p>
      </div>
    </div>

    <% if (typeof products !== 'undefined' && products.length > 0) { %>
      <div class="services-grid">
        <% products.forEach(p => { %>
          <div class="service-card" style="padding: 24px;">
            
            <% if (p.deliveryAvailable !== false) { %>
              <span class="badge-delivery" style="top: 12px; right: 12px;"><i class="bi bi-truck"></i> Home Delivery</span>
            <% } %>
            
            <!-- Product Image -->
            <div style="width: 100%; height: 200px; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #fff; border-radius: 6px; margin-bottom: 16px; border: 1px solid rgba(0,0,0,0.05);">
              <% if (p.images && p.images.length > 0) { %>
                <img src="<%= p.images[0] %>" style="max-width: 100%; max-height: 100%; object-fit: contain;" alt="<%= p.name %>" />
              <% } else { %>
                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
              <% } %>
            </div>
            
            <!-- Product Info -->
            <h3 style="font-size: 1.15rem; margin-bottom: 8px;"><%= p.name %></h3>
            
            <p style="font-size: 0.85rem; margin-bottom: 15px; flex-grow: 1;">
              <%= p.description ? (p.description.length > 60 ? p.description.substring(0, 60) + '...' : p.description) : '' %>
            </p>
            
            <div class="service-price" style="margin-bottom: 16px;">
              <% if (p.discountPrice) { %>
                <span style="text-decoration:line-through; color:#999; font-size:0.9rem; margin-right: 8px;">₹<%= p.price %></span>
                ₹<%= p.discountPrice %>
              <% } else { %>
                ₹<%= p.price %>
              <% } %>
            </div>

            <div class="d-flex gap-2" style="margin-top: auto;">
              <a href="/product/<%= p.productId %>" class="btn btn-outline btn-xs" style="flex:1; padding: 8px 10px; font-size: 0.8rem; text-align: center;">View Details</a>
              <% if (p.stock > 0 && p.status !== 'Out Of Stock') { %>
                <button onclick="buyNowDirect({
                  name: '<%= escape(p.name) %>',
                  price: <%= p.discountPrice || p.price %>,
                  originalPrice: <%= p.price %>,
                  image: '<%= p.images && p.images.length ? p.images[0] : '' %>',
                  sku: '<%= p.sku || 'N/A' %>',
                  category: '<%= p.category || 'General' %>',
                  type: 'product'
                })" class="btn btn-accent btn-xs" style="flex:1; padding: 8px 10px; font-size: 0.8rem; text-align: center;"><i class="bi bi-cart-check"></i> Buy Now</button>
              <% } else { %>
                <button class="btn btn-secondary btn-xs disabled" style="flex:1; padding: 8px 10px; font-size: 0.8rem;" disabled>Sold Out</button>
              <% } %>
            </div>

          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="text-center py-5" style="background: #f8f9fa; border-radius: 12px; border: 1px dashed var(--rule);">
        <i class="bi bi-shop text-muted" style="font-size: 3rem; margin-bottom: 15px; display: block;"></i>
        <h4 style="font-family: var(--font-display); font-weight: 600;">Products Coming Soon</h4>
        <p style="color: var(--ink-light); margin: 0;">We are currently updating our online catalog. Check back shortly!</p>
      </div>
    <% } %>
  </div>
</section>

