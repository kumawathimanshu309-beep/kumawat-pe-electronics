    <div class="services-grid">
      <!-- Card 1 -->
      <div class="service-card">
        <span class="badge-delivery"><i class="bi bi-truck"></i> Home Delivery</span>
        <div class="service-icon" style="color: var(--accent); font-size: 2.2rem; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-droplet"></i>
        </div>
        <h3>Leak Detection &amp; Repair</h3>
        <p>Wall seepage, pipe bursts, hidden leaks. We locate and resolve it fast without unnecessary demolition.</p>
        <div class="service-price">₹299 <small>onwards</small></div>
        <a href="/services" class="btn btn-accent btn-xs" style="margin-top:auto;">Book / Order</a>
      </div>

      <!-- Card 2 -->
      <div class="service-card">
        <span class="badge-delivery"><i class="bi bi-truck"></i> Home Delivery</span>
        <div class="service-icon" style="color: var(--accent); font-size: 2.2rem; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-lightning-charge"></i>
        </div>
        <h3>Electrical Wiring &amp; Rewiring</h3>
        <p>Tripping MCBs, sparking switches, points installation. Done to safety standards.</p>
        <div class="service-price">₹499 <small>onwards</small></div>
        <a href="/services" class="btn btn-accent btn-xs" style="margin-top:auto;">Book / Order</a>
      </div>

      <!-- Card 3 -->
      <div class="service-card">
        <span class="badge-delivery"><i class="bi bi-truck"></i> Home Delivery</span>
        <div class="service-icon" style="color: var(--accent); font-size: 2.2rem; display: flex; align-items: center; justify-content: center;">
          <i class="bi bi-tools"></i>
        </div>
        <h3>Tap &amp; Sanitary Fitting</h3>
        <p>New taps, showers, washbasins, cisterns. We carry parts with us to ensure same-day fixes.</p>
        <div class="service-price">₹199 <small>onwards</small></div>
        <a href="/services" class="btn btn-accent btn-xs" style="margin-top:auto;">Book / Order</a>
      </div>
    </div>
  </div>
</section>

<!-- ── FEATURED PRODUCTS ───────────────────────────────── -->
<style>
  .featured-products-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  @media (max-width: 991px) {
    .featured-products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 767px) {
    .featured-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
  .featured-products-grid .service-card {
    padding: 16px !important;
  }
</style>
<section class="featured-products-section" id="featured-products" style="padding: 80px 0; background-color: var(--white);">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3" style="margin-bottom: 40px;">
      <div>
        <p class="section-label">Our Catalog</p>
        <h2 style="font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; color: var(--ink);">Featured Products</h2>
        <p style="color: var(--ink-light); margin-top: 10px;">High-quality plumbing and electrical supplies delivered right to you.</p>
      </div>
    </div>

    <% if (typeof products !== 'undefined' && products.length > 0) { %>
      <div class="featured-products-grid">
        <% products.forEach(p => { %>
          <div class="premium-card">
            
            <div class="premium-badges">
              <% if (p.discountPrice) { %>
                <span class="premium-badge badge-sale">Sale</span>
              <% } %>
              <% if (p.deliveryAvailable !== false) { %>
                <span class="premium-badge badge-new"><i class="bi bi-truck"></i> Delivery</span>
              <% } %>
            </div>
            
            <!-- Product Image -->
            <div class="premium-card-img">
              <% if (p.images && p.images.length > 0) { %>
                <img loading="lazy" decoding="async" src="<%= optimizeImage(p.images[0]) %>" alt="<%= p.name %>" />
              <% } else { %>
                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
              <% } %>
            </div>
            
            <!-- Product Info -->
            <h3 class="premium-card-title"><%= p.name %></h3>
            
            <p class="premium-card-desc">
              <%= p.description ? (p.description.length > 50 ? p.description.substring(0, 50) + '...' : p.description) : 'Premium quality product.' %>
            </p>
            
            <div class="premium-price-row">
              <% if (p.discountPrice) { %>
                <span class="premium-price-current">₹<%= p.discountPrice %></span>
                <span class="premium-price-old">₹<%= p.price %></span>
                <% let discount = Math.round(((p.price - p.discountPrice) / p.price) * 100); %>
                <span class="premium-discount-percent"><%= discount %>% OFF</span>
              <% } else { %>
                <span class="premium-price-current">₹<%= p.price %></span>
              <% } %>
            </div>

            <div class="d-flex flex-column gap-2" style="margin-top: auto;">
              <% if (p.stock > 0 && p.status !== 'Out Of Stock') { %>
                <button onclick="buyNowDirect({
                  name: '<%= escape(p.name) %>',
                  price: <%= p.discountPrice || p.price %>,
                  originalPrice: <%= p.price %>,
                  image: '<%= p.images && p.images.length ? p.images[0] : '' %>',
                  sku: '<%= p.sku || 'N/A' %>',
                  category: '<%= p.category || 'General' %>',
                  type: 'product'
                })" class="btn btn-accent btn-full"><i class="bi bi-cart-check"></i> Buy Now</button>
              <% } else { %>
                <button class="btn btn-secondary btn-full disabled" disabled>Sold Out</button>
              <% } %>
              <a href="/product/<%= p.productId %>" class="btn btn-outline btn-full">View Details</a>
            </div>
          </div>
        <% }) %>
      </div>
      
      <div class="text-center" style="margin-top: 40px;">
        <a href="/store" class="btn btn-accent" style="padding: 12px 32px; font-size: 1.1rem; border-radius: 50px; font-weight: 600; box-shadow: 0 4px 15px rgba(0,0,0,0.1); transition: all 0.3s ease;">
          View More Products <i class="bi bi-arrow-right ms-2"></i>
        </a>
      </div>
    <% } else { %>
      <div class="premium-empty">
        <i class="bi bi-shop"></i>
        <h3>Products Coming Soon</h3>
        <p>We are currently updating our online catalog with premium tools and electronics. Check back shortly!</p>
        <a href="/store" class="btn btn-accent px-4">
          Browse Full Store <i class="bi bi-arrow-right ms-2"></i>
        </a>
      </div>
    <% } %>
  </div>
</section>

