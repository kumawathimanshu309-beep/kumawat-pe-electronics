<!-- ══════════════════════════════════════════════════════════
     SHOP BY CATEGORY  (only shown when categories exist)
══════════════════════════════════════════════════════════ -->
<% if (typeof categories !== 'undefined' && categories.length > 0) { %>
<section class="categories-section" id="categories" aria-labelledby="categories-heading">
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px;">
      <div>
        <p class="section-label">Explore</p>
        <h2 id="categories-heading">Shop by Category</h2>
      </div>
      <a href="/store" class="btn btn-outline" aria-label="Browse all product categories">
        All Products <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

    <%
      const categoryIcons = {
        'smartphone': 'bi-phone-fill',
        'mobile': 'bi-phone-fill',
        'laptop': 'bi-laptop',
        'computer': 'bi-pc-display',
        'tablet': 'bi-tablet-fill',
        'tv': 'bi-tv-fill',
        'television': 'bi-tv-fill',
        'monitor': 'bi-display-fill',
        'audio': 'bi-headphones',
        'headphone': 'bi-headphones',
        'earphone': 'bi-headphones',
        'earbud': 'bi-headphones',
        'speaker': 'bi-speaker-fill',
        'gaming': 'bi-controller',
        'storage': 'bi-hdd-fill',
        'networking': 'bi-wifi',
        'router': 'bi-router-fill',
        'accessories': 'bi-box-seam-fill',
        'accessory': 'bi-box-seam-fill',
        'smart home': 'bi-house-heart-fill',
        'smarthome': 'bi-house-heart-fill',
        'camera': 'bi-camera-fill',
        'watch': 'bi-smartwatch',
        'wearable': 'bi-smartwatch',
        'electrical': 'bi-lightning-charge-fill',
        'plumbing': 'bi-droplet-fill',
        'tools': 'bi-tools',
        'switches': 'bi-toggle-on',
        'lighting': 'bi-lightbulb-fill',
        'fans': 'bi-fan',
        'fan': 'bi-fan',
        'cables': 'bi-usb-drive-fill',
        'cable': 'bi-usb-drive-fill',
        'appliances': 'bi-plug-fill',
        'printer': 'bi-printer-fill',
        'keyboard': 'bi-keyboard-fill',
        'mouse': 'bi-mouse-fill',
        'general': 'bi-box-seam',
      };

      function getCategoryIcon(name) {
        if (!name) return 'bi-box-seam';
        const lower = name.toLowerCase();
        for (const key of Object.keys(categoryIcons)) {
          if (lower.includes(key)) return categoryIcons[key];
        }
        return 'bi-box-seam';
      }
    %>

    <div class="categories-grid" style="margin-top: clamp(24px, 4vw, 40px);">
      <% categories.forEach(cat => {
        const slug = encodeURIComponent(cat.name);
        const iconClass = getCategoryIcon(cat.name);
      %>
        <a href="/store?category=<%= slug %>" class="category-card reveal" aria-label="Browse <%= cat.name %> — <%= cat.count %> products">
          <div class="category-icon" aria-hidden="true">
            <i class="bi <%= iconClass %>"></i>
          </div>
          <span class="category-name"><%= cat.name %></span>
          <span class="category-count"><%= cat.count %> item<%= cat.count !== 1 ? 's' : '' %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>


<!-- ══════════════════════════════════════════════════════════
     FEATURED PRODUCTS
══════════════════════════════════════════════════════════ -->
<section class="products-section" id="featured-products" aria-labelledby="products-heading">
  <div class="container">

    <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-bottom: clamp(24px, 4vw, 44px);">
      <div>
        <p class="section-label">Our Catalog</p>
        <h2 id="products-heading">Featured Products</h2>
        <p style="color: var(--ink-light); margin-top: 10px; font-size: var(--fs-base);">
          High-quality plumbing and electrical supplies — delivered right to you.
        </p>
      </div>
      <a href="/store" class="btn btn-outline" aria-label="View all products in the store">
        View All Products <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

    <% if (typeof products !== 'undefined' && products.length > 0) { %>
      <div class="products-grid">
        <% products.forEach(p => {
          const hasDiscount = p.discountPrice && p.discountPrice < p.price;
          const discountPct = hasDiscount ? Math.round(((p.price - p.discountPrice) / p.price) * 100) : 0;
          const isOOS = p.stock <= 0 || p.status === 'Out Of Stock';
          const displayPrice = hasDiscount ? p.discountPrice : p.price;
          const imgSrc = p.images && p.images.length > 0 ? optimizeImage(p.images[0]) : '';
          const escapedName = escape(p.name || '');
          const sku = p.sku || 'N/A';
          const cat = p.category || 'General';
          const ratingAvg = p.ratings && p.ratings.average ? p.ratings.average : 0;
          const ratingCount = p.ratings && p.ratings.count ? p.ratings.count : 0;
        %>
          <!-- Product Card — clicking image/title/body navigates to product page -->
          <article
            class="premium-card reveal"
            role="article"
            aria-label="<%= p.name %>"
            onclick="window.location.href='/product/<%= p.productId %>'"
            style="cursor: pointer;"
          >
            <!-- Badges (max 1–2, meaningful only) -->
            <div class="premium-badges" onclick="event.stopPropagation();">
              <% if (isOOS) { %>
                <span class="premium-badge badge-oos">Out of Stock</span>
              <% } else if (hasDiscount) { %>
                <span class="premium-badge badge-sale">Sale</span>
              <% } %>
            </div>

            <!-- Wishlist (independent control) -->
            <% if (typeof user !== 'undefined' && user) { %>
              <button
                class="premium-wishlist-btn"
                onclick="event.stopPropagation(); toggleWishlist('<%= p.productId %>', this);"
                aria-label="Add <%= p.name %> to wishlist"
                title="Add to Wishlist"
              >
                <i class="bi bi-heart" aria-hidden="true"></i>
              </button>
            <% } %>

            <!-- Product Image -->
            <div class="premium-card-img">
              <% if (imgSrc) { %>
                <img
                  loading="lazy"
                  decoding="async"
                  src="<%= imgSrc %>"
                  alt="<%= p.name %>"
                />
              <% } else { %>
                <i class="bi bi-image no-img-icon" aria-hidden="true"></i>
              <% } %>
            </div>

            <!-- Product Info -->
            <% if (p.brand && p.brand !== 'Generic') { %>
              <p class="premium-card-brand"><%= p.brand %></p>
            <% } %>

            <h3 class="premium-card-title"><%= p.name %></h3>

            <p class="premium-card-desc">
              <%= p.description ? (p.description.length > 80 ? p.description.substring(0, 80) + '…' : p.description) : 'Premium quality product.' %>
            </p>

            <% if (ratingAvg > 0) { %>
              <div class="premium-card-rating" aria-label="Rating: <%= ratingAvg %> out of 5">
                <%
                  const stars = Math.round(ratingAvg);
                  for (let i = 1; i <= 5; i++) {
                %>
                  <i class="bi bi-star<%= i <= stars ? '-fill' : '' %>" aria-hidden="true"></i>
                <% } %>
                <span>(<%= ratingCount %>)</span>
              </div>
            <% } %>

            <!-- Price -->
            <div class="premium-price-row">
              <span class="premium-price-current">₹<%= displayPrice.toLocaleString('en-IN') %></span>
              <% if (hasDiscount) { %>
                <span class="premium-price-old">₹<%= p.price.toLocaleString('en-IN') %></span>
                <span class="premium-discount-percent"><%= discountPct %>% OFF</span>
              <% } %>
            </div>

            <!-- Actions (stop card navigation) -->
            <div class="premium-card-actions-row action-row" onclick="event.stopPropagation();">
              <% if (!isOOS) { %>
                <button
                  class="btn btn-accent action-btn-cart add-to-cart"
                  onclick="event.stopPropagation(); addToCart('<%= escapedName %>', <%= displayPrice %>, <%= p.price %>, '<%= imgSrc %>', '<%= sku %>', '<%= cat %>', this);"
                  aria-label="Add <%= p.name %> to cart"
                  title="Add to Cart"
                >
                  <i class="bi bi-cart-plus" aria-hidden="true"></i>
                  <span class="btn-text btn-text-desktop d-none d-md-inline">Add to Cart</span>
                  <span class="btn-text btn-text-mobile d-inline d-md-none">Add</span>
                </button>
                <button
                  class="btn btn-outline action-btn-buy buy-now"
                  onclick="event.stopPropagation(); buyNowDirect({
                    name: '<%= escapedName %>',
                    price: <%= displayPrice %>,
                    originalPrice: <%= p.price %>,
                    image: '<%= imgSrc %>',
                    sku: '<%= sku %>',
                    category: '<%= cat %>',
                    type: 'product'
                  }, this);"
                  aria-label="Buy <%= p.name %> now"
                  title="Buy Now"
                >
                  <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>
                  <span class="btn-text btn-text-desktop d-none d-md-inline">Buy Now</span>
                  <span class="btn-text btn-text-mobile d-inline d-md-none">Buy</span>
                </button>
              <% } else { %>
                <button class="btn btn-secondary disabled w-100" disabled aria-label="<%= p.name %> is sold out">Sold Out</button>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>

      <div style="text-align: center; margin-top: clamp(32px, 5vw, 52px);">
        <a href="/store" class="btn btn-accent" style="padding: 14px 40px; font-size: var(--fs-base);" aria-label="Browse the full product store">
          View Full Store <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
        </a>
      </div>

    <% } else { %>
      <!-- Empty state -->
      <div class="premium-empty">
        <i class="bi bi-shop" aria-hidden="true"></i>
        <h3>Products Coming Soon</h3>
        <p>We're updating our catalog with premium plumbing and electrical supplies. Check back shortly!</p>
        <a href="/store" class="btn btn-accent" aria-label="Browse full store">
          Browse Full Store <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
        </a>
      </div>
    <% } %>

  </div>
</section>


