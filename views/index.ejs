<script>
  function buyNowDirect(itemObj) {
    itemObj.name = unescape(itemObj.name);
    let cart = [];
    const saved = localStorage.getItem('kumawat_cart');
    if (saved) {
      try { cart = JSON.parse(saved); } catch(e) {}
    }
    
    const existing = cart.find(item => item.name === itemObj.name);
    if (existing) {
      existing.quantity += 1;
    } else {
      itemObj.quantity = 1;
      cart.push(itemObj);
    }
    
    localStorage.setItem('kumawat_cart', JSON.stringify(cart));
    window.location.href = '/checkout';
  }
</script>

